###############################################################################
# 6. TEAM ROLES & PERMISSIONS (/api/v1/app/team/roles)
###############################################################################

### 6.1 List All Roles
GET {{baseUrl}}/api/v1/app/team/roles
Authorization: Bearer {{adminToken}}
Accept: application/json


### 6.2 Get Role Details & Permissions Matrix
GET {{baseUrl}}/api/v1/app/team/roles/Sales%20Executive
Authorization: Bearer {{adminToken}}
Accept: application/json


### 6.3 Save Role & Permissions Matrix
POST {{baseUrl}}/api/v1/app/team/roles/save
Authorization: Bearer {{adminToken}}
Content-Type: application/json
Accept: application/json

{
  "roleName": "Field Sales Agent",
  "dataAccess": "OnlyAssigned",
  "permissions": [
    {
      "module": "Lead",
      "view": true,
      "create": true,
      "edit": true,
      "delete": false
    },
    {
      "module": "Task",
      "view": true,
      "create": true,
      "edit": true,
      "delete": false
    }
  ]
}


###############################################################################
# 7. SYSTEM SETTINGS MODULE (/api/v1/app/settings)
###############################################################################

### 7.1 Get Full Settings Aggregate
GET {{baseUrl}}/api/v1/app/settings
Authorization: Bearer {{adminToken}}
Accept: application/json



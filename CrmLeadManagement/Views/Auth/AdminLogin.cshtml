@model CrmLeadManagement.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Admin Sign In · VisionCRM";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="Secure administrative login for VisionCRM. Restricted to authorized administrators." />
    
    <!-- Modern Typography: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    
    <style>
        :root {
            --crm-slate-950: #020617;
            --crm-slate-900: #0f172a;
            --crm-slate-800: #1e293b;
            --crm-slate-700: #334155;
            --crm-slate-600: #475569;
            --crm-slate-400: #94a3b8;
            --crm-slate-300: #cbd5e1;
            
            --crm-amber: #f59e0b;
            --crm-amber-glow: rgba(245, 158, 11, 0.15);
            
            --crm-blue-primary: #2563eb;
            --crm-blue-hover: #1d4ed8;
            
            --crm-danger: #ef4444;
            --crm-danger-bg: #450a0a;
            --crm-danger-border: #7f1d1d;
            --crm-danger-text: #fca5a5;

            --radius-input: 8px;
            --radius-card: 14px;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: radial-gradient(circle at 50% 20%, #1e293b 0%, #0f172a 60%, #020617 100%);
            color: #f8fafc;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            -webkit-font-smoothing: antialiased;
        }

        .admin-auth-card {
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: var(--radius-card);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.05);
            width: 100%;
            max-width: 440px;
            padding: 40px 36px;
        }

        .brand-badge-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
        }

        .brand-logo-mark {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .brand-logo-icon {
            width: 38px;
            height: 38px;
            background: linear-gradient(135deg, #1e293b, #0f172a);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #38bdf8;
            font-size: 19px;
        }

        .brand-logo-title {
            font-size: 19px;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: -0.4px;
        }

        .admin-shield-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(245, 158, 11, 0.12);
            color: #fbbf24;
            border: 1px solid rgba(245, 158, 11, 0.3);
            border-radius: 20px;
            padding: 4px 10px;
            font-size: 11.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .form-header {
            margin-bottom: 24px;
        }

        .form-title {
            font-size: 22px;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 6px;
        }

        .form-subtitle {
            font-size: 13.5px;
            color: var(--crm-slate-400);
            line-height: 1.5;
        }

        .quick-fill-bar {
            background: rgba(30, 41, 59, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 8px;
            padding: 10px 14px;
            margin-bottom: 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 12px;
        }

        .quick-fill-btn {
            background: rgba(245, 158, 11, 0.15);
            border: 1px solid rgba(245, 158, 11, 0.3);
            color: #fbbf24;
            border-radius: 6px;
            padding: 4px 10px;
            font-size: 11.5px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .quick-fill-btn:hover {
            background: rgba(245, 158, 11, 0.25);
            border-color: #fbbf24;
        }

        .auth-alert {
            padding: 12px 14px;
            border-radius: 8px;
            font-size: 13.5px;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 20px;
            line-height: 1.45;
        }

        .auth-alert-danger {
            background-color: var(--crm-danger-bg);
            color: var(--crm-danger-text);
            border: 1px solid var(--crm-danger-border);
        }

        .auth-alert-success {
            background-color: rgba(6, 78, 59, 0.5);
            color: #6ee7b7;
            border: 1px solid #047857;
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: var(--crm-slate-300);
            margin-bottom: 6px;
        }

        .input-container {
            position: relative;
            display: flex;
            align-items: center;
        }

        .form-input {
            width: 100%;
            height: 44px;
            padding: 0 14px;
            font-size: 14px;
            font-family: inherit;
            color: #ffffff;
            background-color: rgba(30, 41, 59, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: var(--radius-input);
            outline: none;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

        .form-input::placeholder {
            color: var(--crm-slate-600);
        }

        .form-input:focus {
            border-color: #38bdf8;
            box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.2);
            background-color: rgba(30, 41, 59, 1);
        }

        .form-input.has-toggle {
            padding-right: 44px;
        }

        .btn-password-toggle {
            position: absolute;
            right: 4px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--crm-slate-400);
            width: 34px;
            height: 34px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        .btn-password-toggle:hover {
            color: #ffffff;
        }

        .form-actions-aux {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
            font-size: 13px;
        }

        .remember-checkbox-group {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            color: var(--crm-slate-300);
        }

        .remember-checkbox-group input[type="checkbox"] {
            width: 16px;
            height: 16px;
            accent-color: var(--crm-blue-primary);
        }

        .btn-sign-in {
            width: 100%;
            height: 46px;
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            border: 1px solid #3b82f6;
            border-radius: var(--radius-input);
            color: #ffffff;
            font-size: 14.5px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.15s ease;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35);
        }

        .btn-sign-in:hover {
            background: linear-gradient(135deg, #1d4ed8, #1e40af);
            box-shadow: 0 6px 16px rgba(37, 99, 235, 0.45);
        }

        .btn-sign-in:disabled {
            opacity: 0.65;
            cursor: not-allowed;
        }

        .spinner-icon {
            display: none;
            animation: spin 0.85s linear infinite;
        }

        @@keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .form-footer {
            margin-top: 26px;
            padding-top: 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            text-align: center;
            font-size: 13px;
            color: var(--crm-slate-400);
        }

        .form-footer a {
            color: #38bdf8;
            font-weight: 600;
            text-decoration: none;
        }

        .form-footer a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <main class="admin-auth-card" role="main">
        <header class="brand-badge-row">
            <div class="brand-logo-mark">
                <div class="brand-logo-icon" aria-hidden="true">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <span class="brand-logo-title">VisionCRM</span>
            </div>
            <span class="admin-shield-badge">
                <i class="bi bi-key-fill"></i> Admin Portal
            </span>
        </header>

        <section class="form-header">
            <h1 class="form-title">Administrator Sign In</h1>
            <p class="form-subtitle">Restricted system access. Only verified Administrator credentials are authorized.</p>
        </section>


        <!-- Alert Notification -->
        <div id="authAlert" class="auth-alert auth-alert-danger" style="@(string.IsNullOrEmpty(Model?.ErrorMessage) ? "display:none;" : "")" role="alert">
            <i class="bi bi-exclamation-triangle-fill" style="margin-top:2px;" aria-hidden="true"></i>
            <span id="authAlertText">@(Model?.ErrorMessage ?? "")</span>
        </div>

        <!-- Admin Login Form -->
        <form id="adminLoginForm" method="post" action="/admin/login" onsubmit="handleAdminLogin(event)" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" name="ReturnUrl" value="@Model?.ReturnUrl" />
            <input type="hidden" name="LoginType" value="admin" />

            <div class="form-group">
                <label class="form-label" for="adminUserIdInput">Admin ID</label>
                <div class="input-container">
                    <input type="text"
                           id="adminUserIdInput"
                           name="UserId"
                           class="form-input"
                           placeholder="e.g. admin"
                           value="@(Model?.UserId ?? Model?.Email ?? "")"
                           required
                           autocomplete="username"
                           autofocus />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label" for="adminPasswordInput">Admin Password</label>
                <div class="input-container">
                    <input type="password"
                           id="adminPasswordInput"
                           name="Password"
                           class="form-input has-toggle"
                           placeholder="Enter admin password"
                           required
                           autocomplete="current-password" />
                    <button type="button"
                            class="btn-password-toggle"
                            onclick="toggleAdminPwdVisibility()"
                            aria-label="Toggle password visibility">
                        <i class="bi bi-eye" id="adminPwdToggleIcon"></i>
                    </button>
                </div>
            </div>

            <div class="form-actions-aux">
                <label class="remember-checkbox-group" for="adminRememberMe">
                    <input type="checkbox" id="adminRememberMe" name="RememberMe" value="true" @(Model?.RememberMe == true ? "checked" : "") />
                    <span>Keep admin session</span>
                </label>
            </div>

            <button type="submit" class="btn-sign-in" id="adminSubmitBtn">
                <i class="bi bi-arrow-repeat spinner-icon" id="adminSubmitSpinner" aria-hidden="true"></i>
                <span id="adminSubmitBtnText">Authenticate as Admin</span>
            </button>
        </form>

        <footer class="form-footer">
            <span>Looking for standard workspace? <a href="/user/login">Go to User Login &rarr;</a></span>
        </footer>
    </main>

    <script>
        function fillAdminCreds(email, pwd) {
            document.getElementById('adminUserIdInput').value = email;
            document.getElementById('adminPasswordInput').value = pwd;
            hideAlert();
        }

        function toggleAdminPwdVisibility() {
            const pwd = document.getElementById('adminPasswordInput');
            const icon = document.getElementById('adminPwdToggleIcon');
            if (!pwd || !icon) return;
            if (pwd.type === 'password') {
                pwd.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                pwd.type = 'password';
                icon.className = 'bi bi-eye';
            }
        }

        function showAlert(msg, isSuccess = false) {
            const box = document.getElementById('authAlert');
            const text = document.getElementById('authAlertText');
            if (box && text) {
                text.textContent = msg;
                box.className = isSuccess ? 'auth-alert auth-alert-success' : 'auth-alert auth-alert-danger';
                box.style.display = 'flex';
            }
        }

        function hideAlert() {
            const box = document.getElementById('authAlert');
            if (box) box.style.display = 'none';
        }

        async function handleAdminLogin(event) {
            event.preventDefault();
            hideAlert();

            const form = document.getElementById('adminLoginForm');
            const userInput = document.getElementById('adminUserIdInput');
            const pwdInput = document.getElementById('adminPasswordInput');
            const submitBtn = document.getElementById('adminSubmitBtn');
            const spinner = document.getElementById('adminSubmitSpinner');
            const btnText = document.getElementById('adminSubmitBtnText');

            const userId = (userInput?.value || '').trim();
            const password = pwdInput?.value || '';

            if (!userId || !password) {
                showAlert('Please enter both Admin ID and Password.');
                return;
            }

            submitBtn.disabled = true;
            spinner.style.display = 'inline-block';
            btnText.textContent = 'Verifying admin credentials...';

            try {
                const formData = new FormData(form);
                const response = await fetch('/admin/login', {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json'
                    },
                    body: formData
                });

                let result = null;
                const contentType = response.headers.get('content-type') || '';
                if (contentType.includes('application/json')) {
                    result = await response.json();
                }

                if (response.ok && result && result.success) {
                    if (result.token) {
                        try {
                            localStorage.setItem('crm_admin_token', result.token);
                            localStorage.setItem('crm_admin_user', JSON.stringify(result.user));
                        } catch (e) {}
                    }
                    btnText.textContent = 'Access granted. Loading dashboard...';
                    showAlert('Admin access granted! Redirecting...', true);
                    const dest = result.redirectUrl || '/admin/dashboard';
                    setTimeout(() => { window.location.href = dest; }, 300);
                } else {
                    const errorMsg = result?.message || 
                        (response.status === 403 ? 'Access denied. Valid Admin credentials are required.' :
                         response.status === 423 ? 'Account temporarily locked due to failed login attempts.' : 
                         'Invalid Admin ID or Password.');
                    showAlert(errorMsg);
                    resetButton();
                }
            } catch (err) {
                console.warn('Fallback to standard submit on network error:', err);
                form.submit();
            }
        }

        function resetButton() {
            const submitBtn = document.getElementById('adminSubmitBtn');
            const spinner = document.getElementById('adminSubmitSpinner');
            const btnText = document.getElementById('adminSubmitBtnText');
            if (submitBtn) submitBtn.disabled = false;
            if (spinner) spinner.style.display = 'none';
            if (btnText) btnText.textContent = 'Authenticate as Admin';
        }
    </script>
</body>
</html>

@model CrmLeadManagement.Models.Dtos.ChangePasswordModel
@{
    Layout = null;
    ViewData["Title"] = "Change Password · NimbusCRM";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    
    <style>
        :root {
            --crm-navy-dark: #0f172a;
            --crm-navy-subtle: #1e293b;
            --crm-blue-primary: #1d4ed8;
            --crm-blue-hover: #1e40af;
            --crm-blue-accent: #2563eb;
            --crm-blue-tint: #f0f6ff;
            --crm-border-color: #e2e8f0;
            --crm-border-input: #cbd5e1;
            --crm-text-muted: #64748b;
            --crm-text-light: #94a3b8;
            --crm-danger: #dc2626;
            --crm-danger-bg: #fef2f2;
            --crm-danger-border: #fecaca;
            --crm-success: #16a34a;
            --crm-success-bg: #f0fdf4;
            --crm-success-border: #bbf7d0;
            --radius-input: 8px;
            --radius-btn: 8px;
            --radius-card: 12px;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #f8fafc;
            color: var(--crm-navy-dark);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px 16px;
        }

        .change-card {
            background: #ffffff;
            border: 1px solid var(--crm-border-color);
            border-radius: var(--radius-card);
            box-shadow: 0 4px 20px rgba(15, 23, 42, 0.08);
            width: 100%;
            max-width: 460px;
            padding: 36px 32px;
        }

        .card-header {
            text-align: center;
            margin-bottom: 24px;
        }

        .brand-badge-icon {
            width: 44px;
            height: 44px;
            border-radius: 10px;
            background: linear-gradient(135deg, #2563eb, #3b82f6);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-size: 20px;
            margin-bottom: 14px;
        }

        .card-title {
            font-size: 20px;
            font-weight: 700;
            color: var(--crm-navy-dark);
            margin-bottom: 6px;
        }

        .card-subtitle {
            font-size: 13.5px;
            color: var(--crm-text-muted);
            line-height: 1.45;
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: var(--crm-navy-subtle);
            margin-bottom: 6px;
        }

        .input-container {
            position: relative;
            display: flex;
            align-items: center;
        }

        .form-input {
            width: 100%;
            height: 42px;
            padding: 0 40px 0 14px;
            font-size: 14px;
            font-family: inherit;
            color: var(--crm-navy-dark);
            background-color: #ffffff;
            border: 1px solid var(--crm-border-input);
            border-radius: var(--radius-input);
            outline: none;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

        .form-input:focus {
            border-color: var(--crm-blue-accent);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .btn-password-toggle {
            position: absolute;
            right: 4px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--crm-text-muted);
            width: 32px;
            height: 32px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
        }

        .password-strength {
            margin-top: 6px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .strength-bar {
            height: 4px;
            flex: 1;
            background: #e2e8f0;
            border-radius: 2px;
            transition: background 0.2s ease;
        }

        .requirements-box {
            background: #f8fafc;
            border: 1px solid var(--crm-border-color);
            border-radius: 8px;
            padding: 12px 14px;
            margin-bottom: 22px;
            font-size: 12px;
        }

        .req-title {
            font-weight: 600;
            color: var(--crm-navy-subtle);
            margin-bottom: 6px;
        }

        .req-list {
            list-style: none;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4px 10px;
        }

        .req-item {
            color: var(--crm-text-muted);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .req-item.met {
            color: var(--crm-success);
            font-weight: 500;
        }

        .btn-submit {
            width: 100%;
            height: 44px;
            background-color: var(--crm-blue-primary);
            color: #ffffff;
            border: none;
            border-radius: var(--radius-btn);
            font-size: 14.5px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: background-color 0.15s ease, box-shadow 0.15s ease;
        }

        .btn-submit:hover {
            background-color: var(--crm-blue-hover);
        }

        .auth-alert {
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 13px;
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 18px;
        }

        .auth-alert-danger {
            background-color: var(--crm-danger-bg);
            color: var(--crm-danger);
            border: 1px solid var(--crm-danger-border);
        }

        .auth-alert-success {
            background-color: var(--crm-success-bg);
            color: var(--crm-success);
            border: 1px solid var(--crm-success-border);
        }
    </style>
</head>
<body>
    <div class="change-card">
        <header class="card-header">
            <div class="brand-badge-icon">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h1 class="card-title">Set New Password</h1>
            <p class="card-subtitle">
                Your account requires a new password before you can access your CRM workspace.
            </p>
        </header>

        <div id="alertBox" class="auth-alert auth-alert-danger" style="@(ViewBag.ErrorMessage != null ? "" : "display:none;")">
            <i class="bi bi-exclamation-circle-fill"></i>
            <span id="alertText">@(ViewBag.ErrorMessage ?? "")</span>
        </div>

        <form id="changePasswordForm" method="post" action="/change-password" onsubmit="handleChangeSubmit(event)">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label class="form-label" for="currentPassword">Current / Temporary Password</label>
                <div class="input-container">
                    <input type="password" id="currentPassword" name="CurrentPassword" class="form-input" placeholder="Enter current temporary password" required />
                    <button type="button" class="btn-password-toggle" onclick="toggleVisibility('currentPassword', 'toggleIcon1')">
                        <i class="bi bi-eye" id="toggleIcon1"></i>
                    </button>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label" for="newPassword">New Password</label>
                <div class="input-container">
                    <input type="password" id="newPassword" name="NewPassword" class="form-input" placeholder="Enter new strong password" required oninput="validatePasswordStrength()" />
                    <button type="button" class="btn-password-toggle" onclick="toggleVisibility('newPassword', 'toggleIcon2')">
                        <i class="bi bi-eye" id="toggleIcon2"></i>
                    </button>
                </div>
                <div class="password-strength">
                    <div class="strength-bar" id="bar1"></div>
                    <div class="strength-bar" id="bar2"></div>
                    <div class="strength-bar" id="bar3"></div>
                    <div class="strength-bar" id="bar4"></div>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label" for="confirmPassword">Confirm New Password</label>
                <div class="input-container">
                    <input type="password" id="confirmPassword" name="ConfirmPassword" class="form-input" placeholder="Re-enter new password" required oninput="validatePasswordStrength()" />
                    <button type="button" class="btn-password-toggle" onclick="toggleVisibility('confirmPassword', 'toggleIcon3')">
                        <i class="bi bi-eye" id="toggleIcon3"></i>
                    </button>
                </div>
            </div>

            <div class="requirements-box">
                <div class="req-title">Password must contain:</div>
                <ul class="req-list">
                    <li class="req-item" id="reqLength"><i class="bi bi-circle"></i> 8+ characters</li>
                    <li class="req-item" id="reqUpper"><i class="bi bi-circle"></i> 1 uppercase letter</li>
                    <li class="req-item" id="reqLower"><i class="bi bi-circle"></i> 1 lowercase letter</li>
                    <li class="req-item" id="reqNumber"><i class="bi bi-circle"></i> 1 number</li>
                    <li class="req-item" id="reqSymbol"><i class="bi bi-circle"></i> 1 special symbol</li>
                    <li class="req-item" id="reqMatch"><i class="bi bi-circle"></i> Passwords match</li>
                </ul>
            </div>

            <button type="submit" class="btn-submit" id="submitBtn">
                <i class="bi bi-check2-circle"></i>
                <span id="submitBtnText">Update Password &amp; Continue</span>
            </button>
        </form>

        <div style="text-align:center;margin-top:20px;">
            <a href="/logout" style="font-size:12.5px;color:var(--crm-text-muted);text-decoration:none;">
                <i class="bi bi-box-arrow-left"></i> Sign in with another account
            </a>
        </div>
    </div>

    <script>
        function toggleVisibility(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (!input || !icon) return;
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'bi bi-eye';
            }
        }

        function validatePasswordStrength() {
            const pwd = document.getElementById('newPassword').value;
            const confirm = document.getElementById('confirmPassword').value;

            const hasLength = pwd.length >= 8;
            const hasUpper = /[A-Z]/.test(pwd);
            const hasLower = /[a-z]/.test(pwd);
            const hasNumber = /[0-9]/.test(pwd);
            const hasSymbol = /[!@@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]/.test(pwd);
            const matches = pwd.length > 0 && pwd === confirm;

            setReq('reqLength', hasLength);
            setReq('reqUpper', hasUpper);
            setReq('reqLower', hasLower);
            setReq('reqNumber', hasNumber);
            setReq('reqSymbol', hasSymbol);
            setReq('reqMatch', matches);

            const score = [hasLength, hasUpper, hasLower, hasNumber, hasSymbol].filter(Boolean).length;
            const bars = ['bar1', 'bar2', 'bar3', 'bar4'];
            bars.forEach((b, i) => {
                const el = document.getElementById(b);
                if (i < score - 1) {
                    el.style.backgroundColor = score >= 4 ? '#16a34a' : score >= 3 ? '#eab308' : '#ef4444';
                } else {
                    el.style.backgroundColor = '#e2e8f0';
                }
            });
        }

        function setReq(id, met) {
            const el = document.getElementById(id);
            if (!el) return;
            if (met) {
                el.className = 'req-item met';
                el.querySelector('i').className = 'bi bi-check-circle-fill';
            } else {
                el.className = 'req-item';
                el.querySelector('i').className = 'bi bi-circle';
            }
        }

        async function handleChangeSubmit(e) {
            e.preventDefault();
            const form = document.getElementById('changePasswordForm');
            const alertBox = document.getElementById('alertBox');
            const alertText = document.getElementById('alertText');
            const submitBtn = document.getElementById('submitBtn');
            const submitText = document.getElementById('submitBtnText');

            const current = document.getElementById('currentPassword').value;
            const next = document.getElementById('newPassword').value;
            const confirm = document.getElementById('confirmPassword').value;

            if (next !== confirm) {
                alertText.textContent = "New password and confirmation do not match.";
                alertBox.style.display = 'flex';
                return;
            }
            if (next.length < 8) {
                alertText.textContent = "New password must be at least 8 characters long.";
                alertBox.style.display = 'flex';
                return;
            }

            submitBtn.disabled = true;
            submitText.textContent = "Updating password...";

            try {
                const formData = new FormData(form);
                const res = await fetch('/change-password', {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json'
                    },
                    body: formData
                });

                const data = await res.json();
                if (res.ok && data && data.success) {
                    alertBox.className = 'auth-alert auth-alert-success';
                    alertText.textContent = 'Password updated successfully! Redirecting to workspace...';
                    alertBox.style.display = 'flex';
                    setTimeout(() => {
                        window.location.href = data.redirectUrl || '/Lead/List';
                    }, 400);
                } else {
                    alertBox.className = 'auth-alert auth-alert-danger';
                    alertText.textContent = data.message || 'Failed to update password. Please verify current password.';
                    alertBox.style.display = 'flex';
                    submitBtn.disabled = false;
                    submitText.textContent = "Update Password & Continue";
                }
            } catch (err) {
                form.submit();
            }
        }
    </script>
</body>
</html>

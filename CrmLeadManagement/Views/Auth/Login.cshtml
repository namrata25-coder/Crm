@model CrmLeadManagement.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Sign In · NimbusCRM";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="Sign in to your NimbusCRM account to manage leads, projects, finances, and team workflows." />
    
    <!-- Modern Typography: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    
    <style>
        :root {
            /* Corporate Color Palette */
            --crm-navy-dark: #0f172a;       /* Slate 900 - Headings & deep text */
            --crm-navy-subtle: #1e293b;     /* Slate 800 - Secondary text */
            --crm-blue-primary: #1d4ed8;    /* Corporate Navy/Blue - Primary actions */
            --crm-blue-hover: #1e40af;      /* Darker blue hover */
            --crm-blue-accent: #2563eb;     /* Blue accent */
            --crm-blue-tint: #f0f6ff;       /* Very light blue accent tint */
            --crm-blue-border: #bfdbfe;     /* Light blue subtle border */
            
            --crm-bg-left: #f8fafc;         /* Clean light-gray / slate section */
            --crm-bg-right: #ffffff;        /* Pure white form background */
            --crm-border-color: #e2e8f0;    /* Crisp divider border */
            --crm-border-input: #cbd5e1;    /* Clean input border */
            --crm-text-muted: #64748b;      /* Slate 500 - Body / muted text */
            --crm-text-light: #94a3b8;      /* Slate 400 - Tertiary text */
            
            --crm-danger: #dc2626;
            --crm-danger-bg: #fef2f2;
            --crm-danger-border: #fecaca;
            --crm-success: #16a34a;
            --crm-success-bg: #f0fdf4;
            --crm-success-border: #bbf7d0;

            --radius-input: 8px;
            --radius-btn: 8px;
            --radius-card: 12px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            height: 100%;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--crm-bg-left);
            color: var(--crm-navy-dark);
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        /* Two-Column Desktop Shell */
        .auth-wrapper {
            display: flex;
            min-height: 100vh;
            width: 100%;
        }

        /* =========================================================
           LEFT SECTION: Enterprise Branding & Product Overview
           ========================================================= */
        .auth-brand-column {
            flex: 1 1 50%;
            background-color: var(--crm-bg-left);
            border-right: 1px solid var(--crm-border-color);
            padding: 64px 72px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        /* Logo Brand Mark */
        .brand-header {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .brand-logo-mark {
            width: 38px;
            height: 38px;
            background-color: var(--crm-navy-dark);
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-weight: 700;
            font-size: 18px;
            letter-spacing: -0.5px;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.12);
        }

        .brand-logo-text {
            font-size: 20px;
            font-weight: 700;
            color: var(--crm-navy-dark);
            letter-spacing: -0.4px;
            display: flex;
            align-items: baseline;
            gap: 4px;
        }

        .brand-logo-text .brand-badge {
            font-size: 11px;
            font-weight: 600;
            color: var(--crm-blue-primary);
            background: var(--crm-blue-tint);
            border: 1px solid var(--crm-blue-border);
            padding: 1px 6px;
            border-radius: 4px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-left: 4px;
        }

        /* Brand Pitch & Features */
        .brand-body {
            max-width: 480px;
            margin: 48px 0;
        }

        .brand-heading {
            font-size: 32px;
            font-weight: 700;
            color: var(--crm-navy-dark);
            line-height: 1.25;
            letter-spacing: -0.6px;
            margin-bottom: 16px;
        }

        .brand-description {
            font-size: 15px;
            color: var(--crm-text-muted);
            line-height: 1.6;
            margin-bottom: 40px;
        }

        /* Three Simple SaaS Features */
        .features-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .feature-item {
            display: flex;
            align-items: flex-start;
            gap: 14px;
        }

        .feature-icon-box {
            width: 34px;
            height: 34px;
            flex-shrink: 0;
            border-radius: 8px;
            background-color: var(--crm-blue-tint);
            border: 1px solid var(--crm-blue-border);
            color: var(--crm-blue-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
        }

        .feature-text {
            display: flex;
            flex-direction: column;
            padding-top: 1px;
        }

        .feature-title {
            font-size: 14px;
            font-weight: 600;
            color: var(--crm-navy-dark);
            margin-bottom: 2px;
        }

        .feature-subtitle {
            font-size: 13px;
            color: var(--crm-text-muted);
            line-height: 1.45;
        }

        /* Brand Footer / Trust Indicators */
        .brand-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-top: 1px solid var(--crm-border-color);
            padding-top: 24px;
            font-size: 12.5px;
            color: var(--crm-text-muted);
        }

        .trust-indicator {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: var(--crm-text-muted);
            font-weight: 500;
        }

        .trust-indicator i {
            color: #059669; /* Subtle green lock */
            font-size: 13px;
        }

        /* =========================================================
           RIGHT SECTION: Clean Enterprise Sign In Card
           ========================================================= */
        .auth-form-column {
            flex: 1 1 50%;
            background-color: var(--crm-bg-right);
            padding: 64px 72px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .auth-form-container {
            width: 100%;
            max-width: 420px;
        }

        /* Mobile-Only Header */
        .mobile-brand-header {
            display: none;
            align-items: center;
            gap: 10px;
            margin-bottom: 32px;
        }

        /* Form Header */
        .form-header {
            margin-bottom: 28px;
        }

        .form-title {
            font-size: 24px;
            font-weight: 700;
            color: var(--crm-navy-dark);
            letter-spacing: -0.4px;
            margin-bottom: 8px;
        }

        .form-subtitle {
            font-size: 14px;
            color: var(--crm-text-muted);
        }

        /* Demo Sandbox Credentials Bar (Subtle & Professional) */
        .demo-bar {
            background-color: var(--crm-bg-left);
            border: 1px solid var(--crm-border-color);
            border-radius: 8px;
            padding: 10px 12px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 12px;
        }

        .demo-bar-label {
            font-weight: 600;
            color: var(--crm-navy-subtle);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .demo-bar-pills {
            display: flex;
            gap: 6px;
        }

        .demo-pill {
            background: #ffffff;
            border: 1px solid var(--crm-border-input);
            border-radius: 6px;
            padding: 3px 9px;
            font-size: 11.5px;
            font-weight: 600;
            color: var(--crm-navy-dark);
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .demo-pill:hover {
            border-color: var(--crm-blue-accent);
            color: var(--crm-blue-primary);
            background-color: var(--crm-blue-tint);
        }

        /* Alert Notification */
        .auth-alert {
            padding: 12px 14px;
            border-radius: 8px;
            font-size: 13.5px;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 20px;
            line-height: 1.45;
        }

        .auth-alert-danger {
            background-color: var(--crm-danger-bg);
            color: var(--crm-danger);
            border: 1px solid var(--crm-danger-border);
        }

        .auth-alert-success {
            background-color: var(--crm-success-bg);
            color: var(--crm-success);
            border: 1px solid var(--crm-success-border);
        }

        /* Form Controls */
        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: var(--crm-navy-subtle);
            margin-bottom: 6px;
        }

        .input-container {
            position: relative;
            display: flex;
            align-items: center;
        }

        .form-input {
            width: 100%;
            height: 42px;
            padding: 0 14px;
            font-size: 14px;
            font-family: inherit;
            color: var(--crm-navy-dark);
            background-color: #ffffff;
            border: 1px solid var(--crm-border-input);
            border-radius: var(--radius-input);
            outline: none;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

        .form-input::placeholder {
            color: var(--crm-text-light);
        }

        .form-input:hover {
            border-color: #94a3b8;
        }

        .form-input:focus {
            border-color: var(--crm-blue-accent);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .form-input.has-toggle {
            padding-right: 44px;
        }

        /* Password visibility toggle button */
        .btn-password-toggle {
            position: absolute;
            right: 4px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--crm-text-muted);
            width: 34px;
            height: 34px;
            border-radius: 6px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            transition: color 0.15s ease;
        }

        .btn-password-toggle:hover {
            color: var(--crm-navy-dark);
        }

        /* Auxiliary Actions: Remember Me & Forgot Password */
        .form-actions-aux {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
            font-size: 13px;
        }

        .remember-checkbox-group {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            user-select: none;
            color: var(--crm-navy-subtle);
            font-weight: 500;
        }

        .remember-checkbox-group input[type="checkbox"] {
            width: 16px;
            height: 16px;
            cursor: pointer;
            accent-color: var(--crm-blue-primary);
            border-radius: 4px;
        }

        .link-forgot-password {
            color: var(--crm-blue-primary);
            text-decoration: none;
            font-weight: 600;
            transition: color 0.15s ease;
        }

        .link-forgot-password:hover {
            color: var(--crm-blue-hover);
            text-decoration: underline;
        }

        /* Primary Submit Button */
        .btn-sign-in {
            width: 100%;
            height: 44px;
            background-color: var(--crm-blue-primary);
            border: 1px solid var(--crm-blue-primary);
            border-radius: var(--radius-btn);
            color: #ffffff;
            font-size: 14px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
            box-shadow: 0 1px 2px rgba(15, 23, 42, 0.08);
        }

        .btn-sign-in:hover {
            background-color: var(--crm-blue-hover);
            border-color: var(--crm-blue-hover);
        }

        .btn-sign-in:focus {
            outline: none;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.25);
        }

        .btn-sign-in:disabled {
            background-color: #93c5fd;
            border-color: #93c5fd;
            cursor: not-allowed;
        }

        .spinner-icon {
            display: none;
            animation: spin 0.85s linear infinite;
        }

        @@keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        /* Form Footer */
        .form-footer {
            margin-top: 28px;
            padding-top: 20px;
            border-top: 1px solid var(--crm-border-color);
            text-align: center;
            font-size: 12.5px;
            color: var(--crm-text-muted);
        }

        .form-footer a {
            color: var(--crm-blue-primary);
            font-weight: 600;
            text-decoration: none;
        }

        .form-footer a:hover {
            text-decoration: underline;
        }

        /* =========================================================
           RESPONSIVE BREAKPOINTS (Mobile & Tablet)
           ========================================================= */
        @@media (max-width: 960px) {
            .auth-wrapper {
                flex-direction: column;
            }

            .auth-brand-column {
                display: none;
            }

            .auth-form-column {
                flex: 1 1 100%;
                padding: 48px 24px;
                background-color: var(--crm-bg-left);
            }

            .auth-form-container {
                background-color: #bc7eda;
                border: 1px solid var(--crm-border-color);
                border-radius: var(--radius-card);
                padding: 36px 28px;
                box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
            }

            .mobile-brand-header {
                display: flex;
            }
        }

        @@media (max-width: 480px) {
            .auth-form-column {
                padding: 24px 16px;
            }

            .auth-form-container {
                padding: 28px 20px;
            }

            .demo-bar {
                flex-direction: column;
                align-items: flex-start;
                gap: 8px;
            }

            .demo-bar-pills {
                width: 100%;
                flex-wrap: wrap;
            }


        }
    </style>
</head>
<body>
    <div class="auth-wrapper">
        <!-- =====================================================
             LEFT SECTION: Enterprise Branding & Core Capabilities
             ===================================================== -->
        <aside class="auth-brand-column" aria-label="NimbusCRM Overview">
            <div>
                <!-- NimbusCRM Logo Mark -->
                <header class="brand-header">
                    <div class="brand-logo-mark" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M19.35 10.04C18.67 6.59 15.64 4 12 4C9.11 4 6.6 5.64 5.35 8.04C2.34 8.36 0 10.91 0 14C0 17.31 2.69 20 6 20H19C21.76 20 24 17.76 24 15C24 12.36 21.95 10.22 19.35 10.04Z" fill="#3b82f6" fill-opacity="0.25"/>
                            <path d="M19 18H6C3.79 18 2 16.21 2 14C2 11.95 3.53 10.28 5.56 10.03L6.63 9.9L7.13 8.95C8.08 7.14 9.94 6 12 6C14.7 6 17.01 7.94 17.47 10.6L17.65 11.66L18.72 11.75C20.58 11.91 22 13.49 22 15C22 16.65 20.65 18 19 18Z" fill="#ffffff"/>
                        </svg>
                    </div>
                    <div class="brand-logo-text">
                        <span>NimbusCRM</span>
                        <span class="brand-badge">Enterprise</span>
                    </div>
                </header>

                <!-- Pitch and Overview -->
                <section class="brand-body">
                    <h1 class="brand-heading">Manage Your Business Smarter</h1>
                    <p class="brand-description">
                        Manage leads, track sales activities, organize projects, and grow your business from one centralized workspace.
                    </p>

                    <!-- Three Simple Features with Small Icons -->
                    <ul class="features-list">
                        <li class="feature-item">
                            <div class="feature-icon-box" aria-hidden="true">
                                <i class="bi bi-funnel"></i>
                            </div>
                            <div class="feature-text">
                                <span class="feature-title">Lead &amp; Pipeline Tracking</span>
                                <span class="feature-subtitle">Capture, qualify, and track prospective opportunities through customized conversion stages.</span>
                            </div>
                        </li>

                        <li class="feature-item">
                            <div class="feature-icon-box" aria-hidden="true">
                                <i class="bi bi-kanban"></i>
                            </div>
                            <div class="feature-text">
                                <span class="feature-title">Project &amp; Milestone Workspaces</span>
                                <span class="feature-subtitle">Coordinate client deliverables, sprint tasks, and dependencies with team visibility.</span>
                            </div>
                        </li>

                        <li class="feature-item">
                            <div class="feature-icon-box" aria-hidden="true">
                                <i class="bi bi-shield-check"></i>
                            </div>
                            <div class="feature-text">
                                <span class="feature-title">Enterprise Security &amp; Invoicing</span>
                                <span class="feature-subtitle">Enforce role-based access controls alongside automated quotations, invoices, and audit logs.</span>
                            </div>
                        </li>
                    </ul>
                </section>
            </div>

            <!-- Trust & Encryption Footer -->
            <footer class="brand-footer">
                <span>&copy; @DateTime.UtcNow.Year NimbusCRM Inc.</span>
                <span class="trust-indicator">
                    <i class="bi bi-lock-fill" aria-hidden="true"></i> 256-bit TLS Encrypted
                </span>
            </footer>
        </aside>

        <!-- =====================================================
             RIGHT SECTION: Modern Professional Authentication Form
             ===================================================== -->
        <main class="auth-form-column" role="main">
            <div class="auth-form-container">
                <!-- Mobile-Only Brand Header -->
                <header class="mobile-brand-header">
                    <div class="brand-logo-mark" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M19 18H6C3.79 18 2 16.21 2 14C2 11.95 3.53 10.28 5.56 10.03L6.63 9.9L7.13 8.95C8.08 7.14 9.94 6 12 6C14.7 6 17.01 7.94 17.47 10.6L17.65 11.66L18.72 11.75C20.58 11.91 22 13.49 22 15C22 16.65 20.65 18 19 18Z" fill="#ffffff"/>
                        </svg>
                    </div>
                    <div class="brand-logo-text">
                        <span>NimbusCRM</span>
                    </div>
                </header>

                <header class="form-header">
                    <h2 class="form-title" id="loginTitle">Sign in to your account</h2>
                    <p class="form-subtitle">Welcome back. Enter your credentials to access your workspace.</p>
                </header>

                <!-- Subtle Demo Credentials Filler -->
                <aside class="demo-bar" aria-label="Demo login options">
                    <span class="demo-bar-label">
                        <i class="bi bi-lightning-charge" style="color: #2563eb;"></i> Quick Fill:
                    </span>
                    <div class="demo-bar-pills">
                        <button type="button" class="demo-pill" onclick="fillCredentials('@(ViewBag.AdminEmail ?? "admin@nimbuscrm.com")', '@(ViewBag.AdminPassword ?? "AdminPassword123!")')" title="Load Administrator credentials">
                            Admin
                        </button>
                        <button type="button" class="demo-pill" id="userOptionBtn" onclick="fillCredentials('@(ViewBag.UserEmail ?? "ananya.sharma@nimbuscrm.com")', '@(ViewBag.UserPassword ?? "Ananya@123!")')" title="Load User credentials">
                            User
                        </button>
                    </div>
                </aside>

                <!-- Alert Message Banner -->
                <div id="authAlert" class="auth-alert auth-alert-danger" style="@(string.IsNullOrEmpty(Model?.ErrorMessage) ? "display:none;" : "")" role="alert">
                    <i class="bi bi-exclamation-circle-fill" style="margin-top:2px;" aria-hidden="true"></i>
                    <span id="authAlertText">@(Model?.ErrorMessage ?? "")</span>
                </div>

                <!-- Main Login Form -->
                <form id="loginForm" method="post" action="/login" onsubmit="handleLoginSubmit(event)" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ReturnUrl" id="returnUrlInput" value="@Model?.ReturnUrl" />

                    <!-- User ID / Email Input -->
                    <div class="form-group">
                        <label class="form-label" for="userIdInput">User ID or Work Email</label>
                        <div class="input-container">
                            <input type="text"
                                   id="userIdInput"
                                   name="UserId"
                                   class="form-input"
                                   placeholder="e.g. admin@nimbuscrm.com or User ID"
                                   value="@(Model?.UserId ?? Model?.Email ?? "")"
                                   required
                                   autocomplete="username"
                                   autofocus />
                        </div>
                    </div>


                    <!-- Password Input with Eye Visibility Toggle -->
                    <div class="form-group">
                        <label class="form-label" for="passwordInput">Password</label>
                        <div class="input-container">
                            <input type="password"
                                   id="passwordInput"
                                   name="Password"
                                   class="form-input has-toggle"
                                   placeholder="Enter your password"
                                   required
                                   autocomplete="current-password" />
                            <button type="button"
                                    class="btn-password-toggle"
                                    id="togglePasswordBtn"
                                    onclick="togglePasswordVisibility()"
                                    aria-label="Show password"
                                    title="Show password">
                                <i class="bi bi-eye" id="togglePasswordIcon"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Remember Me & Forgot Password -->
                    <div class="form-actions-aux">
                        <label class="remember-checkbox-group" for="rememberMeCheckbox">
                            <input type="checkbox"
                                   id="rememberMeCheckbox"
                                   name="RememberMe"
                                   value="true"
                                   @(Model?.RememberMe == true ? "checked" : "") />
                            <span>Remember me</span>
                        </label>
                        <a href="javascript:void(0)" class="link-forgot-password" onclick="handleForgotPassword()" id="forgotPasswordLink">
                            Forgot password?
                        </a>
                    </div>

                    <!-- Primary Action Button -->
                    <button type="submit" class="btn-sign-in" id="submitBtn">
                        <i class="bi bi-arrow-repeat spinner-icon" id="submitSpinner" aria-hidden="true"></i>
                        <span id="submitBtnText">Sign In</span>
                    </button>
                </form>

                <!-- Help Footer -->
                <footer class="form-footer">
                    <span>Having trouble logging in? <a href="javascript:void(0)" onclick="handleForgotPassword()">Contact Administrator</a></span>
                </footer>
            </div>
        </main>
    </div>

    <!-- =========================================================
         Client Logic & Asynchronous Authentication Handler
         ========================================================= -->
    <script>
        // 1-Click Demo Credentials Autofill
        function fillCredentials(userId, password) {
            const userInput = document.getElementById('userIdInput');
            const passwordInput = document.getElementById('passwordInput');
            if (userInput) userInput.value = userId;
            if (passwordInput) passwordInput.value = password;
            hideAlert();
            if (passwordInput) passwordInput.focus();
        }

        // Toggle Password Visibility
        function togglePasswordVisibility() {
            const pwd = document.getElementById('passwordInput');
            const icon = document.getElementById('togglePasswordIcon');
            const btn = document.getElementById('togglePasswordBtn');
            if (!pwd || !icon || !btn) return;

            if (pwd.type === 'password') {
                pwd.type = 'text';
                icon.className = 'bi bi-eye-slash';
                btn.title = 'Hide password';
                btn.setAttribute('aria-label', 'Hide password');
            } else {
                pwd.type = 'password';
                icon.className = 'bi bi-eye';
                btn.title = 'Show password';
                btn.setAttribute('aria-label', 'Show password');
            }
        }

        // Display user notifications
        function showAlert(message, isSuccess = false) {
            const alertBox = document.getElementById('authAlert');
            const alertText = document.getElementById('authAlertText');
            if (!alertBox || !alertText) return;

            alertText.textContent = message;
            alertBox.className = isSuccess ? 'auth-alert auth-alert-success' : 'auth-alert auth-alert-danger';
            alertBox.style.display = 'flex';
        }

        function hideAlert() {
            const alertBox = document.getElementById('authAlert');
            if (alertBox) alertBox.style.display = 'none';
        }

        // Forgot password prompt
        function handleForgotPassword() {
            showAlert('Please reach out to your system administrator (admin@nimbuscrm.com) to reset credentials or verify account permissions.', false);
        }

        // Asynchronous form submission preserving bearer token caching & fallback
        async function handleLoginSubmit(event) {
            event.preventDefault();
            hideAlert();

            const form = document.getElementById('loginForm');
            const userInput = document.getElementById('userIdInput');
            const passwordInput = document.getElementById('passwordInput');
            const submitBtn = document.getElementById('submitBtn');
            const submitSpinner = document.getElementById('submitSpinner');
            const submitBtnText = document.getElementById('submitBtnText');

            const userId = (userInput?.value || '').trim();
            const password = passwordInput?.value || '';

            if (!userId && !password) {
                showAlert('Please enter both User ID / Email and Password.');
                userInput?.focus();
                return;
            }

            if (!userId) {
                showAlert('Please enter your User ID or Email.');
                userInput?.focus();
                return;
            }

            if (!password) {
                showAlert('Please enter your password.');
                passwordInput?.focus();
                return;
            }

            // Enter loading state
            submitBtn.disabled = true;
            submitSpinner.style.display = 'inline-block';
            submitBtnText.textContent = 'Signing in...';

            try {
                const formData = new FormData(form);

                const response = await fetch('/login', {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json'
                    },
                    body: formData
                });

                let result = null;
                const contentType = response.headers.get('content-type') || '';
                if (contentType.includes('application/json')) {
                    result = await response.json();
                }

                if (response.ok && result && result.success) {
                    // Cache Bearer access token and user metadata for client API calls
                    if (result.token) {
                        try {
                            localStorage.setItem('crm_token', result.token);
                            if (result.user) {
                                localStorage.setItem('crm_user', JSON.stringify(result.user));
                            }
                        } catch (e) {
                            console.warn('LocalStorage error:', e);
                        }
                    }

                    submitBtnText.textContent = 'Redirecting...';
                    showAlert('Signed in successfully! Redirecting...', true);

                    const target = result.redirectUrl || '/Lead/List';
                    setTimeout(() => {
                        window.location.href = target;
                    }, 350);
                } else {
                    const errorMsg = result?.message || 
                        (response.status === 423 ? 'Account temporarily locked due to failed login attempts.' : 
                         response.status === 403 ? 'Account is inactive. Please contact your administrator.' : 
                         'Invalid User ID or Password.');
                    showAlert(errorMsg);
                    resetSubmitButton();
                }
            } catch (err) {
                console.error('Async login error, submitting via standard POST fallback:', err);
                form.submit();
            }
        }

        function resetSubmitButton() {
            const submitBtn = document.getElementById('submitBtn');
            const submitSpinner = document.getElementById('submitSpinner');
            const submitBtnText = document.getElementById('submitBtnText');
            if (submitBtn) submitBtn.disabled = false;
            if (submitSpinner) submitSpinner.style.display = 'none';
            if (submitBtnText) submitBtnText.textContent = 'Sign In';
        }
    </script>
</body>
</html>

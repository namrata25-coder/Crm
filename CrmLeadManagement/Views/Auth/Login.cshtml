@model CrmLeadManagement.Models.LoginViewModel
@{
    Layout = null;
    var isInitialAdmin = string.Equals(Model?.LoginType, "admin", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = (isInitialAdmin ? "Admin Portal Sign In" : "User Portal Sign In") + " · VisionCRM";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="Sign in to VisionCRM with separate Admin and User Portals. Manage leads, projects, finances, and team workflows." />
    
    <!-- Modern Typography: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    
    <style>
        :root {
            /* Corporate Color Palette */
            --crm-navy-dark: #0f172a;       /* Slate 900 - Headings & deep text */
            --crm-navy-subtle: #1e293b;     /* Slate 800 - Secondary text */
            --crm-blue-primary: #1d4ed8;    /* Corporate Navy/Blue - Primary actions */
            --crm-blue-hover: #1e40af;      /* Darker blue hover */
            --crm-blue-accent: #2563eb;     /* Blue accent */
            --crm-blue-tint: #f0f6ff;       /* Very light blue accent tint */
            --crm-blue-border: #bfdbfe;     /* Light blue subtle border */
            
            --crm-bg-left: #f8fafc;         /* Clean light-gray / slate section */
            --crm-bg-right: #ffffff;        /* Pure white form background */
            --crm-border-color: #e2e8f0;    /* Crisp divider border */
            --crm-border-input: #cbd5e1;    /* Clean input border */
            --crm-text-muted: #64748b;      /* Slate 500 - Body / muted text */
            --crm-text-light: #94a3b8;      /* Slate 400 - Tertiary text */
            
            --crm-danger: #dc2626;
            --crm-danger-bg: #fef2f2;
            --crm-danger-border: #fecaca;
            --crm-success: #16a34a;
            --crm-success-bg: #f0fdf4;
            --crm-success-border: #bbf7d0;

            --radius-input: 8px;
            --radius-btn: 8px;
            --radius-card: 14px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            height: 100%;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--crm-bg-left);
            color: var(--crm-navy-dark);
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        /* Two-Column Desktop Shell */
        .auth-wrapper {
            display: flex;
            min-height: 100vh;
            width: 100%;
        }

        /* =========================================================
           LEFT SECTION: Enterprise Branding & Product Overview
           ========================================================= */
        .auth-brand-column {
            flex: 1 1 50%;
            background-color: var(--crm-bg-left);
            border-right: 1px solid var(--crm-border-color);
            padding: 64px 72px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .brand-header {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .brand-logo-mark {
            width: 38px;
            height: 38px;
            background-color: var(--crm-navy-dark);
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-weight: 700;
            font-size: 18px;
            letter-spacing: -0.5px;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.12);
        }

        .brand-logo-text {
            font-size: 20px;
            font-weight: 700;
            color: var(--crm-navy-dark);
            letter-spacing: -0.4px;
            display: flex;
            align-items: baseline;
            gap: 4px;
        }

        .brand-badge {
            font-size: 10.5px;
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 0.5px;
            padding: 2px 7px;
            border-radius: 6px;
            background-color: #e2e8f0;
            color: var(--crm-navy-subtle);
            margin-left: 4px;
        }

        .brand-body {
            margin: auto 0;
            max-width: 520px;
            padding: 48px 0;
        }

        .brand-heading {
            font-size: 32px;
            font-weight: 800;
            line-height: 1.25;
            color: var(--crm-navy-dark);
            letter-spacing: -0.6px;
            margin-bottom: 16px;
        }

        .brand-description {
            font-size: 15.5px;
            line-height: 1.6;
            color: var(--crm-text-muted);
            margin-bottom: 36px;
        }

        .features-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .feature-item {
            display: flex;
            align-items: flex-start;
            gap: 14px;
        }

        .feature-icon-box {
            flex-shrink: 0;
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background-color: #ffffff;
            border: 1px solid var(--crm-border-color);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--crm-blue-accent);
            font-size: 16px;
            box-shadow: 0 1px 2px rgba(15, 23, 42, 0.05);
        }

        .feature-text {
            display: flex;
            flex-direction: column;
        }

        .feature-title {
            font-size: 14px;
            font-weight: 600;
            color: var(--crm-navy-dark);
            margin-bottom: 2px;
        }

        .feature-subtitle {
            font-size: 13px;
            color: var(--crm-text-muted);
            line-height: 1.45;
        }

        .brand-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 12.5px;
            color: var(--crm-text-light);
            border-top: 1px solid var(--crm-border-color);
            padding-top: 24px;
        }

        .trust-indicator {
            display: flex;
            align-items: center;
            gap: 6px;
            font-weight: 500;
            color: var(--crm-text-muted);
        }

        /* =========================================================
           RIGHT SECTION: Dual Portal Login Form Column
           ========================================================= */
        .auth-form-column {
            flex: 1 1 50%;
            background-color: var(--crm-bg-right);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 48px;
        }

        .auth-form-container {
            width: 100%;
            max-width: 440px;
        }

        .mobile-brand-header {
            display: none;
            align-items: center;
            gap: 10px;
            margin-bottom: 24px;
        }

        /* =========================================================
           PORTAL SELECTION COMPONENT (ADMIN vs USER) - COMPACT DESIGN
           ========================================================= */
        .portal-selector-label {
            display: block;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            color: var(--crm-text-muted);
            margin-bottom: 8px;
        }

        .portal-switcher {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 18px;
        }

        .portal-btn {
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            padding: 8px 12px;
            background: #ffffff;
            border: 1.5px solid var(--crm-border-color);
            border-radius: 9px;
            cursor: pointer;
            text-align: left;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            outline: none;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
            min-height: 0;
        }

        .portal-btn:hover {
            border-color: #cbd5e1;
            transform: translateY(-1px);
            box-shadow: 0 3px 6px -1px rgba(0, 0, 0, 0.06);
        }

        /* User Portal Active State */
        .portal-btn.active.user-portal {
            border-color: #2563eb;
            background: linear-gradient(180deg, #ffffff 0%, #eff6ff 100%);
            box-shadow: 0 0 0 2.5px rgba(37, 99, 235, 0.16), 0 3px 5px -1px rgba(37, 99, 235, 0.08);
        }

        /* Admin Portal Active State */
        .portal-btn.active.admin-portal {
            border-color: #0f172a;
            background: linear-gradient(180deg, #ffffff 0%, #f1f5f9 100%);
            box-shadow: 0 0 0 2.5px rgba(15, 23, 42, 0.18), 0 3px 5px -1px rgba(15, 23, 42, 0.08);
        }

        .portal-btn-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            margin-bottom: 4px;
        }

        .portal-icon-box {
            width: 24px;
            height: 24px;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            transition: all 0.2s ease;
        }

        .user-portal .portal-icon-box {
            background: #eff6ff;
            color: #2563eb;
        }

        .admin-portal .portal-icon-box {
            background: #f8fafc;
            color: #475569;
        }

        .portal-btn.active.user-portal .portal-icon-box {
            background: #2563eb;
            color: #ffffff;
        }

        .portal-btn.active.admin-portal .portal-icon-box {
            background: #0f172a;
            color: #fbbf24;
        }

        .portal-badge {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            padding: 1px 6px;
            border-radius: 6px;
            line-height: 1.2;
        }

        .user-portal .portal-badge {
            background: #f1f5f9;
            color: #64748b;
        }

        .admin-portal .portal-badge {
            background: #f1f5f9;
            color: #64748b;
        }

        .portal-btn.active.user-portal .portal-badge {
            background: #dbeafe;
            color: #1d4ed8;
        }

        .portal-btn.active.admin-portal .portal-badge {
            background: #0f172a;
            color: #fbbf24;
        }

        .portal-name {
            font-size: 13px;
            font-weight: 700;
            color: var(--crm-navy-dark);
            margin-bottom: 1px;
            display: flex;
            align-items: center;
            gap: 4px;
            line-height: 1.25;
        }

        .portal-desc {
            font-size: 10.5px;
            color: var(--crm-text-muted);
            line-height: 1.25;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 100%;
        }

        /* Form Header */
        .form-header {
            margin-bottom: 22px;
        }

        .portal-security-notice {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            font-weight: 600;
            padding: 4px 10px;
            border-radius: 16px;
            margin-bottom: 10px;
            transition: all 0.2s ease;
        }

        .notice-user {
            background: #eff6ff;
            color: #1d4ed8;
            border: 1px solid #bfdbfe;
        }

        .notice-admin {
            background: #fef3c7;
            color: #92400e;
            border: 1px solid #fde68a;
        }

        .form-title {
            font-size: 24px;
            font-weight: 800;
            color: var(--crm-navy-dark);
            letter-spacing: -0.5px;
            margin-bottom: 6px;
            transition: color 0.2s ease;
        }

        .form-subtitle {
            font-size: 13.5px;
            color: var(--crm-text-muted);
            line-height: 1.45;
        }

        /* Demo Sandbox Credentials Bar */
        .demo-bar {
            background-color: var(--crm-bg-left);
            border: 1px solid var(--crm-border-color);
            border-radius: 8px;
            padding: 10px 12px;
            margin-bottom: 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 12px;
        }

        .demo-bar-label {
            font-weight: 600;
            color: var(--crm-navy-subtle);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .demo-bar-pills {
            display: flex;
            gap: 6px;
        }

        .demo-pill {
            background: #ffffff;
            border: 1px solid var(--crm-border-input);
            border-radius: 6px;
            padding: 4px 10px;
            font-size: 11.5px;
            font-weight: 600;
            color: var(--crm-navy-dark);
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .demo-pill:hover {
            border-color: var(--crm-blue-accent);
            color: var(--crm-blue-primary);
            background-color: var(--crm-blue-tint);
        }

        .demo-pill.pill-admin {
            background: #fef3c7;
            border-color: #fde68a;
            color: #92400e;
        }

        .demo-pill.pill-admin:hover {
            background: #fde68a;
            border-color: #f59e0b;
            color: #78350f;
        }

        /* Alert Notification */
        .auth-alert {
            padding: 12px 14px;
            border-radius: 8px;
            font-size: 13px;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 20px;
            line-height: 1.45;
        }

        .auth-alert-danger {
            background-color: var(--crm-danger-bg);
            color: var(--crm-danger);
            border: 1px solid var(--crm-danger-border);
        }

        .auth-alert-success {
            background-color: var(--crm-success-bg);
            color: var(--crm-success);
            border: 1px solid var(--crm-success-border);
        }

        /* Form Controls */
        .form-group {
            margin-bottom: 18px;
        }

        .form-label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: var(--crm-navy-subtle);
            margin-bottom: 6px;
        }

        .input-container {
            position: relative;
            display: flex;
            align-items: center;
        }

        .form-input {
            width: 100%;
            height: 42px;
            padding: 0 14px;
            font-size: 14px;
            font-family: inherit;
            color: var(--crm-navy-dark);
            background-color: #ffffff;
            border: 1px solid var(--crm-border-input);
            border-radius: var(--radius-input);
            outline: none;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

        .form-input::placeholder {
            color: var(--crm-text-light);
        }

        .form-input:hover {
            border-color: #94a3b8;
        }

        .form-input:focus {
            border-color: var(--crm-blue-accent);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .form-input.has-toggle {
            padding-right: 44px;
        }

        /* Password visibility toggle button */
        .btn-password-toggle {
            position: absolute;
            right: 4px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--crm-text-muted);
            width: 34px;
            height: 34px;
            border-radius: 6px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            transition: color 0.15s ease;
        }

        .btn-password-toggle:hover {
            color: var(--crm-navy-dark);
        }

        /* Auxiliary Actions: Remember Me & Forgot Password */
        .form-actions-aux {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 22px;
            font-size: 13px;
        }

        .remember-checkbox-group {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            user-select: none;
            color: var(--crm-navy-subtle);
            font-weight: 500;
        }

        .remember-checkbox-group input[type="checkbox"] {
            width: 16px;
            height: 16px;
            cursor: pointer;
            accent-color: var(--crm-blue-primary);
            border-radius: 4px;
        }

        .link-forgot-password {
            color: var(--crm-blue-primary);
            text-decoration: none;
            font-weight: 600;
            transition: color 0.15s ease;
        }

        .link-forgot-password:hover {
            color: var(--crm-blue-hover);
            text-decoration: underline;
        }

        /* Primary Submit Button */
        .btn-primary-action {
            width: 100%;
            height: 44px;
            background-color: var(--crm-blue-primary);
            border: 1px solid transparent;
            border-radius: var(--radius-btn);
            color: #ffffff;
            font-size: 14.5px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.18s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 1px 2px rgba(15, 23, 42, 0.08);
        }

        .btn-primary-action:hover {
            background-color: var(--crm-blue-hover);
            box-shadow: 0 4px 10px rgba(29, 78, 216, 0.25);
            transform: translateY(-1px);
        }

        .btn-primary-action:active {
            transform: translateY(0);
        }

        .btn-primary-action:disabled {
            opacity: 0.65;
            cursor: not-allowed;
            transform: none;
        }

        /* Admin Portal Submit Button Styling */
        .btn-primary-action.btn-admin {
            background: linear-gradient(135deg, #0f172a, #1e293b);
            border-color: #334155;
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.25);
        }

        .btn-primary-action.btn-admin:hover {
            background: linear-gradient(135deg, #1e293b, #334155);
            box-shadow: 0 6px 16px rgba(15, 23, 42, 0.35);
        }

        .spinner-icon {
            display: none;
            animation: spin 0.85s linear infinite;
        }

        @@keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .form-footer {
            margin-top: 26px;
            padding-top: 20px;
            border-top: 1px solid var(--crm-border-color);
            text-align: center;
            font-size: 12.5px;
            color: var(--crm-text-muted);
        }

        .form-footer a {
            color: var(--crm-blue-primary);
            font-weight: 600;
            text-decoration: none;
        }

        .form-footer a:hover {
            text-decoration: underline;
        }

        /* =========================================================
           RESPONSIVE BREAKPOINTS (Mobile & Tablet)
           ========================================================= */
        @@media (max-width: 960px) {
            .auth-wrapper {
                flex-direction: column;
            }

            .auth-brand-column {
                display: none;
            }

            .auth-form-column {
                flex: 1 1 100%;
                padding: 48px 24px;
                background-color: var(--crm-bg-left);
            }

            .auth-form-container {
                background-color: #ffffff;
                border: 1px solid var(--crm-border-color);
                border-radius: var(--radius-card);
                padding: 36px 28px;
                box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
            }

            .mobile-brand-header {
                display: flex;
            }
        }

        @@media (max-width: 480px) {
            .auth-form-column {
                padding: 24px 16px;
            }

            .auth-form-container {
                padding: 24px 18px;
            }

            .portal-switcher {
                grid-template-columns: 1fr 1fr;
                gap: 8px;
            }

            .portal-btn {
                padding: 7px 10px;
            }

            .portal-name {
                font-size: 12px;
            }

            .portal-desc {
                display: none;
            }

            .demo-bar {
                flex-direction: column;
                align-items: flex-start;
                gap: 8px;
            }

            .demo-bar-pills {
                width: 100%;
                flex-wrap: wrap;
            }
        }
    </style>
</head>
<body>
    <div class="auth-wrapper">
        <!-- =====================================================
             LEFT SECTION: Enterprise Branding & Core Capabilities
             ===================================================== -->
        <aside class="auth-brand-column" aria-label="VisionCRM Overview">
            <div>
                <!-- VisionCRM Logo Mark -->
                <header class="brand-header">
                    <div class="brand-logo-mark" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 2L2 7L12 12L22 7L12 2Z" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M2 17L12 22L22 17" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M2 12L12 17L22 12" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                    <div class="brand-logo-text">
                        <span>VisionCRM</span>
                        <span class="brand-badge">Enterprise</span>
                    </div>
                </header>

                <!-- Pitch and Overview -->
                <section class="brand-body">
                    <h1 class="brand-heading">Manage Your Business Smarter</h1>
                    <p class="brand-description">
                        Manage leads, track sales activities, organize projects, and grow your business from one centralized workspace.
                    </p>

                    <ul class="features-list">
                        <li class="feature-item">
                            <div class="feature-icon-box" aria-hidden="true">
                                <i class="bi bi-shield-lock"></i>
                            </div>
                            <div class="feature-text">
                                <span class="feature-title">Separate Admin &amp; User Portals</span>
                                <span class="feature-subtitle">Database-verified RBAC segregation preventing privilege escalation across workflows.</span>
                            </div>
                        </li>

                        <li class="feature-item">
                            <div class="feature-icon-box" aria-hidden="true">
                                <i class="bi bi-funnel"></i>
                            </div>
                            <div class="feature-text">
                                <span class="feature-title">Lead &amp; Pipeline Tracking</span>
                                <span class="feature-subtitle">Capture, qualify, and track prospective opportunities through conversion stages.</span>
                            </div>
                        </li>

                        <li class="feature-item">
                            <div class="feature-icon-box" aria-hidden="true">
                                <i class="bi bi-kanban"></i>
                            </div>
                            <div class="feature-text">
                                <span class="feature-title">Project &amp; Milestone Workspaces</span>
                                <span class="feature-subtitle">Coordinate client deliverables, sprint tasks, and finance invoices with team visibility.</span>
                            </div>
                        </li>
                    </ul>
                </section>
            </div>

            <!-- Trust & Encryption Footer -->
            <footer class="brand-footer">
                <span>&copy; @DateTime.UtcNow.Year VisionCRM Inc.</span>
                <span class="trust-indicator">
                    <i class="bi bi-lock-fill" aria-hidden="true"></i> 256-bit TLS Encrypted
                </span>
            </footer>
        </aside>

        <!-- =====================================================
             RIGHT SECTION: Dual Portal Authentication Form
             ===================================================== -->
        <main class="auth-form-column" role="main">
            <div class="auth-form-container">
                <!-- Mobile-Only Brand Header -->
                <header class="mobile-brand-header">
                    <div class="brand-logo-mark" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 2L2 7L12 12L22 7L12 2Z" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M2 17L12 22L22 17" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M2 12L12 17L22 12" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                    <div class="brand-logo-text">
                        <span>VisionCRM</span>
                    </div>
                </header>

                <!-- PORTAL SELECTION (ADMIN vs USER) -->
                <span class="portal-selector-label">Choose Login Portal</span>
                <div class="portal-switcher" role="tablist" aria-label="Choose Login Portal">
                    <!-- User Portal Option -->
                    <button type="button"
                            id="userPortalBtn"
                            class="portal-btn user-portal @(isInitialAdmin ? "" : "active")"
                            role="tab"
                            aria-selected="@(isInitialAdmin ? "false" : "true")"
                            onclick="switchPortal('user')"
                            title="Select User Portal for standard users and staff">
                        <div class="portal-btn-top">
                            <div class="portal-icon-box">
                                <i class="bi bi-person-badge-fill"></i>
                            </div>
                            <span class="portal-badge">User</span>
                        </div>
                        <div class="portal-name">User Portal</div>
                        <div class="portal-desc">For registered users &amp; staff</div>
                    </button>

                    <!-- Admin Portal Option -->
                    <button type="button"
                            id="adminPortalBtn"
                            class="portal-btn admin-portal @(isInitialAdmin ? "active" : "")"
                            role="tab"
                            aria-selected="@(isInitialAdmin ? "true" : "false")"
                            onclick="switchPortal('admin')"
                            title="Select Admin Portal for authorized administrators">
                        <div class="portal-btn-top">
                            <div class="portal-icon-box">
                                <i class="bi bi-shield-lock-fill"></i>
                            </div>
                            <span class="portal-badge">Admin</span>
                        </div>
                        <div class="portal-name">Admin Portal</div>
                        <div class="portal-desc">For authorized administrators</div>
                    </button>
                </div>

                <!-- Form Header -->
                <header class="form-header">
                    <div id="portalSecurityNotice" class="portal-security-notice @(isInitialAdmin ? "notice-admin" : "notice-user")">
                        <i class="bi @(isInitialAdmin ? "bi-shield-check" : "bi-person-check-fill")" id="portalNoticeIcon"></i>
                        <span id="portalNoticeText">@(isInitialAdmin ? "Admin Portal · Restricted Access" : "User Portal · Standard Access")</span>
                    </div>
                    <h2 class="form-title" id="loginTitle">@(isInitialAdmin ? "Admin Portal Sign In" : "User Portal Sign In")</h2>
                    <p class="form-subtitle" id="loginSubtitle">
                        @(isInitialAdmin 
                            ? "Enter your Administrator ID & password to access the Admin Dashboard." 
                            : "Enter your User ID & password to access your User Dashboard.")
                    </p>
                </header>


                <!-- Alert Message Banner -->
                <div id="authAlert" class="auth-alert auth-alert-danger" style="@(string.IsNullOrEmpty(Model?.ErrorMessage) ? "display:none;" : "")" role="alert">
                    <i class="bi bi-exclamation-triangle-fill" style="margin-top:2px;" aria-hidden="true"></i>
                    <span id="authAlertText">@(Model?.ErrorMessage ?? "")</span>
                </div>

                <!-- Main Login Form -->
                <form id="loginForm" method="post" action="/login" onsubmit="handleLoginSubmit(event)" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ReturnUrl" id="returnUrlInput" value="@Model?.ReturnUrl" />
                    <input type="hidden" name="LoginType" id="loginTypeInput" value="@(isInitialAdmin ? "admin" : "user")" />

                    <!-- User ID / Admin ID / Email Input -->
                    <div class="form-group">
                        <label class="form-label" for="userIdInput" id="userIdLabel">
                            @(isInitialAdmin ? "Administrator ID or Admin Email" : "User ID or Work Email")
                        </label>
                        <div class="input-container">
                            <input type="text"
                                   id="userIdInput"
                                   name="UserId"
                                   class="form-input"
                                   placeholder="@(isInitialAdmin ? "e.g. admin@visioncrm.com or Admin ID" : "e.g. ananya.sharma@visioncrm.com or User ID")"
                                   value="@(Model?.UserId ?? Model?.Email ?? "")"
                                   required
                                   autocomplete="username"
                                   autofocus />
                        </div>
                    </div>

                    <!-- Password Input with Eye Visibility Toggle -->
                    <div class="form-group">
                        <label class="form-label" for="passwordInput" id="passwordLabel">
                            @(isInitialAdmin ? "Admin Password" : "Password")
                        </label>
                        <div class="input-container">
                            <input type="password"
                                   id="passwordInput"
                                   name="Password"
                                   class="form-input has-toggle"
                                   placeholder="Enter your password"
                                   required
                                   autocomplete="current-password" />
                            <button type="button"
                                    class="btn-password-toggle"
                                    id="togglePasswordBtn"
                                    onclick="togglePasswordVisibility()"
                                    aria-label="Show password"
                                    title="Show password">
                                <i class="bi bi-eye" id="togglePasswordIcon"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Remember Me & Forgot Password -->
                    <div class="form-actions-aux">
                        <label class="remember-checkbox-group" for="rememberMeCheckbox">
                            <input type="checkbox"
                                   id="rememberMeCheckbox"
                                   name="RememberMe"
                                   value="true"
                                   @(Model?.RememberMe == true ? "checked" : "") />
                            <span id="rememberMeText">@(isInitialAdmin ? "Keep admin session" : "Keep me signed in")</span>
                        </label>
                        <a href="javascript:void(0)" class="link-forgot-password" onclick="handleForgotPassword()">Need help?</a>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn-primary-action @(isInitialAdmin ? "btn-admin" : "")" id="submitBtn">
                        <i class="bi bi-arrow-repeat spinner-icon" id="submitSpinner" aria-hidden="true"></i>
                        <i class="bi @(isInitialAdmin ? "bi-shield-lock-fill" : "bi-box-arrow-in-right")" id="submitBtnIcon" aria-hidden="true"></i>
                        <span id="submitBtnText">@(isInitialAdmin ? "Sign In to Admin Portal" : "Sign In to User Portal")</span>
                    </button>
                </form>

                <!-- Registration Link for Standard Users -->
                <div id="userRegisterPrompt" style="margin-top: 14px; text-align: center; font-size: 13px; color: var(--crm-text-muted); display: @(isInitialAdmin ? "none" : "block");">
                    Don't have an account? <a href="/register" style="color: var(--crm-blue-accent); font-weight: 600; text-decoration: none;">Register here &rarr;</a>
                </div>

                <footer class="form-footer">
                    <span>Direct portal URLs: <a href="/admin/login">Admin Portal</a> · <a href="/user/login">User Portal</a> · <a href="/register">Register</a></span>
                </footer>
            </div>
        </main>
    </div>

    <!-- Interactive Portal Logic and Scripting -->
    <script>
        const adminEmail = '@(ViewBag.AdminEmail ?? "admin")';
        const adminPassword = '@(ViewBag.AdminPassword ?? "admin123")';
        const userEmail = '@(ViewBag.UserEmail ?? "ananya.sharma@visioncrm.com")';
        const userPassword = '@(ViewBag.UserPassword ?? "Ananya@123!")';

        let currentPortal = '@(isInitialAdmin ? "admin" : "user")';

        // Check URL parameter for initial portal selection
        document.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const portalParam = urlParams.get('portal');
            if (portalParam === 'admin' || window.location.pathname.includes('/admin')) {
                switchPortal('admin', false);
            } else if (portalParam === 'user' || window.location.pathname.includes('/user')) {
                switchPortal('user', false);
            }

            if (urlParams.get('registered') === 'true') {
                showAlert('Registration successful! Please sign in with your User ID and password.', true);
            }

            // Auto-switch to Admin Portal if admin is typed or prefilled
            const uInput = document.getElementById('userIdInput');
            if (uInput) {
                const initialVal = (uInput.value || '').trim().toLowerCase();
                if ((initialVal === 'admin' || initialVal === 'admin@visioncrm.com') && currentPortal !== 'admin') {
                    switchPortal('admin', false);
                }
                uInput.addEventListener('input', (e) => {
                    const val = (e.target.value || '').trim().toLowerCase();
                    if ((val === 'admin' || val === 'admin@visioncrm.com') && currentPortal !== 'admin') {
                        switchPortal('admin');
                    }
                });
            }
        });

        // Switch between Admin and User Portals dynamically
        function switchPortal(portal, updateUrl = true) {
            currentPortal = portal;
            hideAlert();

            const userBtn = document.getElementById('userPortalBtn');
            const adminBtn = document.getElementById('adminPortalBtn');
            const loginTypeInput = document.getElementById('loginTypeInput');
            const notice = document.getElementById('portalSecurityNotice');
            const noticeIcon = document.getElementById('portalNoticeIcon');
            const noticeText = document.getElementById('portalNoticeText');
            const title = document.getElementById('loginTitle');
            const subtitle = document.getElementById('loginSubtitle');
            const quickFillIcon = document.getElementById('quickFillIcon');
            const primaryDemoPill = document.getElementById('primaryDemoPill');
            const userIdLabel = document.getElementById('userIdLabel');
            const userIdInput = document.getElementById('userIdInput');
            const passwordLabel = document.getElementById('passwordLabel');
            const submitBtn = document.getElementById('submitBtn');
            const submitBtnIcon = document.getElementById('submitBtnIcon');
            const submitBtnText = document.getElementById('submitBtnText');
            const rememberMeText = document.getElementById('rememberMeText');
            const userRegisterPrompt = document.getElementById('userRegisterPrompt');

            if (portal === 'admin') {
                // Activate Admin Portal UI
                userBtn.classList.remove('active');
                userBtn.setAttribute('aria-selected', 'false');
                adminBtn.classList.add('active');
                adminBtn.setAttribute('aria-selected', 'true');

                loginTypeInput.value = 'admin';

                notice.className = 'portal-security-notice notice-admin';
                noticeIcon.className = 'bi bi-shield-check';
                noticeText.textContent = 'Admin Portal · Restricted Access';

                title.textContent = 'Admin Portal Sign In';
                subtitle.textContent = 'Enter your Administrator ID & password to access the Admin Dashboard.';

                if (quickFillIcon) quickFillIcon.style.color = '#d97706';
                if (primaryDemoPill) {
                    primaryDemoPill.className = 'demo-pill pill-admin';
                    primaryDemoPill.textContent = 'Load Admin Credentials';
                }

                userIdLabel.textContent = 'Admin ID';
                userIdInput.placeholder = 'e.g. admin or Admin ID';
                passwordLabel.textContent = 'Admin Password';

                rememberMeText.textContent = 'Keep admin session';

                submitBtn.className = 'btn-primary-action btn-admin';
                submitBtnIcon.className = 'bi bi-shield-lock-fill';
                submitBtnText.textContent = 'Sign In to Admin Portal';

                if (userRegisterPrompt) userRegisterPrompt.style.display = 'none';

                document.title = 'Admin Portal Sign In · VisionCRM';

                if (updateUrl && window.history && window.history.replaceState) {
                    const currentUrl = new URL(window.location);
                    currentUrl.searchParams.set('portal', 'admin');
                    window.history.replaceState({}, '', currentUrl);
                }
            } else {
                // Activate User Portal UI
                adminBtn.classList.remove('active');
                adminBtn.setAttribute('aria-selected', 'false');
                userBtn.classList.add('active');
                userBtn.setAttribute('aria-selected', 'true');

                loginTypeInput.value = 'user';

                notice.className = 'portal-security-notice notice-user';
                noticeIcon.className = 'bi bi-person-check-fill';
                noticeText.textContent = 'User Portal · Standard Access';

                title.textContent = 'User Portal Sign In';
                subtitle.textContent = 'Enter your User ID & password to access your User Dashboard.';

                if (quickFillIcon) quickFillIcon.style.color = '#2563eb';
                if (primaryDemoPill) {
                    primaryDemoPill.className = 'demo-pill';
                    primaryDemoPill.textContent = 'Load User Credentials';
                }

                userIdLabel.textContent = 'User ID or Work Email';
                userIdInput.placeholder = 'e.g. rahul.verma or registered email';
                passwordLabel.textContent = 'Password';

                rememberMeText.textContent = 'Keep me signed in';

                submitBtn.className = 'btn-primary-action';
                submitBtnIcon.className = 'bi bi-box-arrow-in-right';
                submitBtnText.textContent = 'Sign In to User Portal';

                if (userRegisterPrompt) userRegisterPrompt.style.display = 'block';

                document.title = 'User Portal Sign In · VisionCRM';

                if (updateUrl && window.history && window.history.replaceState) {
                    const currentUrl = new URL(window.location);
                    currentUrl.searchParams.set('portal', 'user');
                    window.history.replaceState({}, '', currentUrl);
                }
            }
        }

        // Fill credentials based on the currently active portal
        function fillActiveDemoCredentials() {
            if (currentPortal === 'admin') {
                fillCredentials(adminEmail, adminPassword);
            } else {
                fillCredentials(userEmail, userPassword);
            }
        }

        function fillCredentials(userId, pwd) {
            const userInput = document.getElementById('userIdInput');
            const pwdInput = document.getElementById('passwordInput');
            if (userInput) userInput.value = userId;
            if (pwdInput) pwdInput.value = pwd;
            hideAlert();
        }

        function togglePasswordVisibility() {
            const pwd = document.getElementById('passwordInput');
            const icon = document.getElementById('togglePasswordIcon');
            const btn = document.getElementById('togglePasswordBtn');
            if (!pwd || !icon) return;

            if (pwd.type === 'password') {
                pwd.type = 'text';
                icon.className = 'bi bi-eye-slash';
                btn.title = 'Hide password';
                btn.setAttribute('aria-label', 'Hide password');
            } else {
                pwd.type = 'password';
                icon.className = 'bi bi-eye';
                btn.title = 'Show password';
                btn.setAttribute('aria-label', 'Show password');
            }
        }

        function showAlert(message, isSuccess = false) {
            const alertBox = document.getElementById('authAlert');
            const alertText = document.getElementById('authAlertText');
            if (!alertBox || !alertText) return;

            alertText.textContent = message;
            alertBox.className = isSuccess ? 'auth-alert auth-alert-success' : 'auth-alert auth-alert-danger';
            alertBox.style.display = 'flex';
        }

        function hideAlert() {
            const alertBox = document.getElementById('authAlert');
            if (alertBox) alertBox.style.display = 'none';
        }

        function handleForgotPassword() {
            showAlert('Please reach out to your system administrator (admin@visioncrm.com) to reset credentials or verify account permissions.', false);
        }

        // Handle AJAX form submission with backend role enforcement and token preservation
        async function handleLoginSubmit(event) {
            event.preventDefault();
            hideAlert();

            const form = document.getElementById('loginForm');
            const userInput = document.getElementById('userIdInput');
            const passwordInput = document.getElementById('passwordInput');
            const submitBtn = document.getElementById('submitBtn');
            const submitSpinner = document.getElementById('submitSpinner');
            const submitBtnText = document.getElementById('submitBtnText');
            const submitBtnIcon = document.getElementById('submitBtnIcon');

            const userId = (userInput?.value || '').trim();
            const password = passwordInput?.value || '';

            if (!userId && !password) {
                showAlert('Please enter both User ID and Password.');
                userInput?.focus();
                return;
            }

            if (!userId) {
                showAlert('Please enter your User ID or Email.');
                userInput?.focus();
                return;
            }

            if (!password) {
                showAlert('Please enter your password.');
                passwordInput?.focus();
                return;
            }

            // If user enters admin identifier, ensure it is treated as Admin Portal login
            if (userId.toLowerCase() === 'admin' || userId.toLowerCase() === 'admin@visioncrm.com') {
                const loginTypeInput = document.getElementById('loginTypeInput');
                if (loginTypeInput) loginTypeInput.value = 'admin';
                currentPortal = 'admin';
            }

            // Loading state
            submitBtn.disabled = true;
            if (submitSpinner) submitSpinner.style.display = 'inline-block';
            if (submitBtnIcon) submitBtnIcon.style.display = 'none';
            if (submitBtnText) submitBtnText.textContent = 'Verifying credentials...';

            try {
                const formData = new FormData(form);
                if (userId.toLowerCase() === 'admin' || userId.toLowerCase() === 'admin@visioncrm.com') {
                    formData.set('LoginType', 'admin');
                }

                const response = await fetch('/login', {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json'
                    },
                    body: formData
                });

                let result = null;
                const contentType = response.headers.get('content-type') || '';
                if (contentType.includes('application/json')) {
                    result = await response.json();
                }

                if (response.ok && result && result.success) {
                    // Cache Bearer token and user info
                    if (result.token) {
                        try {
                            localStorage.setItem('crm_token', result.token);
                            if (result.user) {
                                localStorage.setItem('crm_user', JSON.stringify(result.user));
                            }
                        } catch (e) {
                            console.warn('LocalStorage error:', e);
                        }
                    }

                    if (submitBtnText) submitBtnText.textContent = 'Redirecting...';
                    showAlert('Signed in successfully! Redirecting...', true);

                    const target = result.redirectUrl || (currentPortal === 'admin' ? '/admin/dashboard' : '/user/dashboard');
                    setTimeout(() => {
                        window.location.href = target;
                    }, 350);
                } else {
                    // Extract exact error message from backend
                    const errorMsg = result?.message || 
                        (response.status === 403 
                            ? (currentPortal === 'admin' 
                                ? 'Access denied. Valid Admin credentials are required.' 
                                : 'Access denied. Valid User credentials are required.')
                            : (response.status === 423 
                                ? 'Account temporarily locked due to multiple failed login attempts.' 
                                : 'Invalid User ID or Password.'));

                    showAlert(errorMsg, false);
                    resetSubmitButton();
                }
            } catch (err) {
                console.error('Async login error, submitting via standard POST fallback:', err);
                form.submit();
            }
        }

        function resetSubmitButton() {
            const submitBtn = document.getElementById('submitBtn');
            const submitSpinner = document.getElementById('submitSpinner');
            const submitBtnText = document.getElementById('submitBtnText');
            const submitBtnIcon = document.getElementById('submitBtnIcon');

            if (submitBtn) submitBtn.disabled = false;
            if (submitSpinner) submitSpinner.style.display = 'none';
            if (submitBtnIcon) submitBtnIcon.style.display = 'inline-block';
            if (submitBtnText) {
                submitBtnText.textContent = currentPortal === 'admin' 
                    ? 'Sign In to Admin Portal' 
                    : 'Sign In to User Portal';
            }
        }
    </script>
</body>
</html>

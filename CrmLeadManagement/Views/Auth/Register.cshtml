@{
    Layout = null;
    Context.Response.Redirect("/login");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="Register a new user account for VisionCRM workspace." />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <style>
        :root {
            --crm-navy-dark: #0f172a;
            --crm-navy-subtle: #1e293b;
            --crm-blue-primary: #1d4ed8;
            --crm-blue-hover: #1e40af;
            --crm-blue-accent: #2563eb;
            --crm-blue-tint: #f0f6ff;
            --crm-blue-border: #bfdbfe;

            --crm-bg-page: #f8fafc;
            --crm-border-color: #e2e8f0;
            --crm-border-input: #cbd5e1;
            --crm-text-muted: #64748b;
            --crm-text-light: #94a3b8;

            --crm-danger: #dc2626;
            --crm-danger-bg: #fef2f2;
            --crm-danger-border: #fecaca;
            --crm-success: #16a34a;
            --crm-success-bg: #f0fdf4;
            --crm-success-border: #bbf7d0;

            --radius-input: 8px;
            --radius-btn: 8px;
            --radius-card: 16px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--crm-bg-page);
            color: var(--crm-navy-dark);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 28px 16px;
            -webkit-font-smoothing: antialiased;
        }

        .register-container {
            width: 100%;
            max-width: 480px;
        }

        .register-card {
            background: #ffffff;
            border: 1px solid var(--crm-border-color);
            border-radius: var(--radius-card);
            box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.08), 0 8px 10px -6px rgba(15, 23, 42, 0.04);
            padding: 36px 32px;
        }

        .brand-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
        }

        .brand-logo-group {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .brand-logo-icon {
            width: 36px;
            height: 36px;
            background: var(--crm-navy-dark);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-size: 18px;
        }

        .brand-name {
            font-size: 19px;
            font-weight: 700;
            color: var(--crm-navy-dark);
            letter-spacing: -0.3px;
        }

        .user-badge {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 3px 10px;
            border-radius: 20px;
            background: #eff6ff;
            color: #2563eb;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .header-section {
            margin-bottom: 24px;
        }

        .title {
            font-size: 22px;
            font-weight: 700;
            color: var(--crm-navy-dark);
            letter-spacing: -0.4px;
            margin-bottom: 4px;
        }

        .subtitle {
            font-size: 13.5px;
            color: var(--crm-text-muted);
            line-height: 1.4;
        }

        .auth-alert {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 12px 14px;
            border-radius: 8px;
            font-size: 13px;
            line-height: 1.4;
            margin-bottom: 20px;
        }

        .auth-alert-danger {
            background-color: var(--crm-danger-bg);
            border: 1px solid var(--crm-danger-border);
            color: var(--crm-danger);
        }

        .auth-alert-success {
            background-color: var(--crm-success-bg);
            border: 1px solid var(--crm-success-border);
            color: var(--crm-success);
        }

        .form-group {
            margin-bottom: 16px;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .form-label {
            display: block;
            font-size: 12.5px;
            font-weight: 600;
            color: var(--crm-navy-subtle);
            margin-bottom: 5px;
        }

        .input-container {
            position: relative;
            display: flex;
            align-items: center;
        }

        .form-input {
            width: 100%;
            height: 42px;
            padding: 0 12px;
            font-size: 13.5px;
            font-family: inherit;
            color: var(--crm-navy-dark);
            background-color: #ffffff;
            border: 1px solid var(--crm-border-input);
            border-radius: var(--radius-input);
            outline: none;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

        .form-input::placeholder {
            color: var(--crm-text-light);
        }

        .form-input:focus {
            border-color: var(--crm-blue-accent);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .form-input.has-toggle {
            padding-right: 40px;
        }

        .btn-toggle {
            position: absolute;
            right: 4px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--crm-text-muted);
            width: 32px;
            height: 32px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
        }

        .btn-toggle:hover {
            color: var(--crm-navy-dark);
        }

        .form-hint {
            font-size: 11px;
            color: var(--crm-text-muted);
            margin-top: 4px;
        }

        .btn-submit {
            width: 100%;
            height: 44px;
            background-color: var(--crm-blue-primary);
            border: 1px solid var(--crm-blue-primary);
            border-radius: var(--radius-btn);
            color: #ffffff;
            font-size: 14px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.15s ease;
            box-shadow: 0 2px 4px rgba(29, 78, 216, 0.2);
            margin-top: 20px;
        }

        .btn-submit:hover {
            background-color: var(--crm-blue-hover);
            transform: translateY(-1px);
            box-shadow: 0 4px 6px rgba(29, 78, 216, 0.25);
        }

        .btn-submit:disabled {
            opacity: 0.65;
            cursor: not-allowed;
            transform: none;
        }

        .spinner-icon {
            display: none;
            animation: spin 0.85s linear infinite;
        }

        @@keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .role-notice {
            background-color: #f1f5f9;
            border-radius: 8px;
            padding: 10px 12px;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            color: var(--crm-text-muted);
            margin-top: 14px;
        }

        .role-notice i {
            color: #2563eb;
            font-size: 15px;
        }

        .card-footer {
            margin-top: 22px;
            padding-top: 16px;
            border-top: 1px solid var(--crm-border-color);
            text-align: center;
            font-size: 13px;
            color: var(--crm-text-muted);
        }

        .card-footer a {
            color: var(--crm-blue-primary);
            font-weight: 600;
            text-decoration: none;
        }

        .card-footer a:hover {
            text-decoration: underline;
        }

        @@media (max-width: 480px) {
            .register-card {
                padding: 24px 20px;
            }
            .form-row {
                grid-template-columns: 1fr;
                gap: 0;
            }
        }
    </style>
</head>
<body>
    <div class="register-container">
        <div class="register-card">
            <header class="brand-header">
                <div class="brand-logo-group">
                    <div class="brand-logo-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <span class="brand-name">VisionCRM</span>
                </div>
                <span class="user-badge">
                    <i class="bi bi-person-plus-fill"></i> User Register
                </span>
            </header>

            <section class="header-section">
                <h1 class="title">Create User Account</h1>
                <p class="subtitle">Enter your details to register for the User Portal workspace.</p>
            </section>

            <!-- Alert Notification -->
            <div id="registerAlert" class="auth-alert auth-alert-danger" style="@(string.IsNullOrEmpty(Model?.ErrorMessage) ? "display:none;" : "")" role="alert">
                <i class="bi bi-exclamation-circle-fill" style="margin-top:1px;" aria-hidden="true"></i>
                <span id="registerAlertText">@(Model?.ErrorMessage ?? "")</span>
            </div>

            <!-- Registration Form -->
            <form id="registerForm" method="post" action="/register" onsubmit="handleRegister(event)" novalidate>
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label class="form-label" for="regUserId">User ID <span style="color:var(--crm-danger);">*</span></label>
                    <div class="input-container">
                        <input type="text"
                               id="regUserId"
                               name="UserId"
                               class="form-input"
                               placeholder="e.g. rahul.verma or rverma"
                               value="@(Model?.UserId ?? "")"
                               required
                               autocomplete="username"
                               autofocus />
                    </div>
                    <div class="form-hint">Unique identifier used for logging in. Cannot be changed later.</div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="regName">Full Name <span style="color:var(--crm-danger);">*</span></label>
                    <div class="input-container">
                        <input type="text"
                               id="regName"
                               name="Name"
                               class="form-input"
                               placeholder="e.g. Rahul Verma"
                               value="@(Model?.Name ?? "")"
                               required
                               autocomplete="name" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="regEmail">Work Email Address <span style="color:var(--crm-danger);">*</span></label>
                    <div class="input-container">
                        <input type="email"
                               id="regEmail"
                               name="Email"
                               class="form-input"
                               placeholder="e.g. rahul@visioncrm.com"
                               value="@(Model?.Email ?? "")"
                               required
                               autocomplete="email" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" for="regPassword">Password <span style="color:var(--crm-danger);">*</span></label>
                        <div class="input-container">
                            <input type="password"
                                   id="regPassword"
                                   name="Password"
                                   class="form-input has-toggle"
                                   placeholder="Min. 6 chars"
                                   required
                                   autocomplete="new-password" />
                            <button type="button" class="btn-toggle" onclick="togglePassword('regPassword', 'toggleIcon1')" aria-label="Toggle password visibility">
                                <i class="bi bi-eye" id="toggleIcon1"></i>
                            </button>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="regConfirmPassword">Confirm <span style="color:var(--crm-danger);">*</span></label>
                        <div class="input-container">
                            <input type="password"
                                   id="regConfirmPassword"
                                   name="ConfirmPassword"
                                   class="form-input has-toggle"
                                   placeholder="Confirm password"
                                   required
                                   autocomplete="new-password" />
                            <button type="button" class="btn-toggle" onclick="togglePassword('regConfirmPassword', 'toggleIcon2')" aria-label="Toggle confirm password visibility">
                                <i class="bi bi-eye" id="toggleIcon2"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="role-notice">
                    <i class="bi bi-info-circle-fill"></i>
                    <span>New registrations receive standard <strong>User</strong> access. Admin privileges require separate administrative provisioning.</span>
                </div>

                <button type="submit" class="btn-submit" id="submitBtn">
                    <i class="bi bi-arrow-repeat spinner-icon" id="spinnerIcon" aria-hidden="true"></i>
                    <span id="submitBtnText"><i class="bi bi-person-check-fill" style="margin-right:4px;"></i> Register Account</span>
                </button>
            </form>

            <footer class="card-footer">
                <span>Already have an account? <a href="/login?portal=user">Sign in here &rarr;</a></span>
            </footer>
        </div>
    </div>

    <script>
        function togglePassword(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (!input || !icon) return;
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'bi bi-eye';
            }
        }

        function showAlert(msg, isSuccess = false) {
            const box = document.getElementById('registerAlert');
            const text = document.getElementById('registerAlertText');
            if (box && text) {
                text.textContent = msg;
                box.className = isSuccess ? 'auth-alert auth-alert-success' : 'auth-alert auth-alert-danger';
                box.style.display = 'flex';
            }
        }

        function hideAlert() {
            const box = document.getElementById('registerAlert');
            if (box) box.style.display = 'none';
        }

        async function handleRegister(e) {
            e.preventDefault();
            hideAlert();

            const userId = (document.getElementById('regUserId').value || '').trim();
            const name = (document.getElementById('regName').value || '').trim();
            const email = (document.getElementById('regEmail').value || '').trim();
            const password = document.getElementById('regPassword').value || '';
            const confirmPassword = document.getElementById('regConfirmPassword').value || '';

            if (!userId || !name || !email || !password || !confirmPassword) {
                showAlert('All fields are required. Please fill in all fields.');
                return;
            }

            if (userId.toLowerCase() === 'admin') {
                showAlert("The User ID 'admin' is reserved for system administration. Please choose a different User ID.");
                return;
            }

            if (password.length < 6) {
                showAlert('Password must be at least 6 characters long.');
                return;
            }

            if (password !== confirmPassword) {
                showAlert('Password and confirmation password do not match.');
                return;
            }

            const btn = document.getElementById('submitBtn');
            const spinner = document.getElementById('spinnerIcon');
            const btnText = document.getElementById('submitBtnText');

            btn.disabled = true;
            spinner.style.display = 'inline-block';
            btnText.textContent = 'Registering...';

            try {
                const form = document.getElementById('registerForm');
                const formData = new FormData(form);

                const response = await fetch('/register', {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: formData
                });

                const data = await response.json();

                if (response.ok && data.success) {
                    showAlert(data.message || 'Registration successful! Redirecting to login...', true);
                    setTimeout(() => {
                        window.location.href = data.redirectUrl || '/login?portal=user&registered=true';
                    }, 1200);
                } else {
                    showAlert(data.message || 'Registration failed. Please check your information and try again.');
                    btn.disabled = false;
                    spinner.style.display = 'none';
                    btnText.innerHTML = '<i class="bi bi-person-check-fill" style="margin-right:4px;"></i> Register Account';
                }
            } catch (err) {
                // If JSON parsing fails, fallback to traditional form submission
                document.getElementById('registerForm').submit();
            }
        }
    </script>
</body>
</html>

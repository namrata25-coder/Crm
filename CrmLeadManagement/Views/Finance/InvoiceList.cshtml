    function selectMilestoneForInvoiceModal(selectedId) {
        const hiddenInput = document.getElementById('modalMilestoneId');
        const warning = document.getElementById('milestoneWarning');
        const autoHint = document.getElementById('milestoneAutoHint');
        const amountInput = document.getElementById('modalAmount');
        const dueInput = document.getElementById('modalDueDate');
        const notesInput = document.getElementById('modalNotes');

        // Clear all active card styling
        document.querySelectorAll('.inv-modal-ms-card').forEach(card => {
            if (!card.classList.contains('inv-modal-ms-disabled')) {
                card.classList.remove('active');
                card.style.border = '1px solid var(--line)';
                card.style.background = '#fff';
                card.style.boxShadow = 'none';
                const check = card.querySelector('.modal-ms-check');
                if (check) check.innerHTML = '<i class="bi bi-circle" style="color:var(--ink-400);font-size:15px;"></i>';
            }
        });

        if (!selectedId) {
            if (hiddenInput) hiddenInput.value = '';
            if (warning) warning.style.display = 'none';
            if (autoHint) autoHint.style.display = 'none';
            calculateTotals();
            return;
        }

        const milestone = currentProjectMilestones ? currentProjectMilestones.find(m => m.id === Number(selectedId)) : null;
        if (!milestone) return;

        if (hiddenInput) hiddenInput.value = milestone.id;

        // Highlight selected card
        const card = document.getElementById(`modal-ms-card-${milestone.id}`);
        if (card) {
            card.classList.add('active');
            card.style.border = '2px solid var(--brand-600)';
            card.style.background = '#eff6ff';
            card.style.boxShadow = '0 2px 6px rgba(79,70,229,0.15)';
            const check = document.getElementById(`modal-ms-check-${milestone.id}`);
            if (check) check.innerHTML = '<i class="bi bi-check-circle-fill" style="color:var(--brand-600);font-size:15px;"></i>';
        }

        const currentInvId = parseInt(document.getElementById('modalInvId').value, 10) || 0;
        const alreadyInvoiced = rawInvoices.some(i => i.milestoneId === milestone.id && i.id !== currentInvId);
        if (warning) warning.style.display = alreadyInvoiced ? 'block' : 'none';

        // Auto-fill Amount / Price from dynamic milestone data
        const amount = Number(milestone.amount > 0 ? milestone.amount : (milestone.effectiveAmount || 0));
        if (amountInput) amountInput.value = amount;
        if (autoHint) autoHint.style.display = amount > 0 ? 'inline' : 'none';

        // Auto-fill Due Date if available
        if (milestone.dueDate && dueInput) {
            dueInput.value = milestone.dueDate;
        }

        // Auto-fill Notes / Description
        if (notesInput && (!notesInput.value || notesInput.value.startsWith('Invoice for Milestone:'))) {
            notesInput.value = `Invoice for Milestone: ${milestone.milestoneName}${milestone.description ? ' - ' + milestone.description : ''}`;
        }

        calculateTotals();
    }

    function calculateTotals() {
        const subtotal = Math.max(0, parseFloat(document.getElementById('modalAmount')?.value) || 0);
        let discount = Math.max(0, parseFloat(document.getElementById('modalDiscount')?.value) || 0);
        if (discount > subtotal) discount = subtotal;

        const taxableAmount = Math.max(0, subtotal - discount);
        const taxSel = document.getElementById('modalTaxRate');
        const selectedOpt = taxSel?.options[taxSel.selectedIndex];
        const taxRate = parseFloat(taxSel?.value) || 0;
        const taxType = selectedOpt ? (selectedOpt.getAttribute('data-type') || 'GST') : 'GST';
        const taxAmount = Math.round(taxableAmount * (taxRate / 100) * 100) / 100;
        const grandTotal = taxableAmount + taxAmount;

        const elTaxable = document.getElementById('calcTaxableAmount');
        const elTax = document.getElementById('calcTaxAmount');
        const elGrand = document.getElementById('calcGrandTotal');
        const elBreakdown = document.getElementById('calcTaxBreakdown');

        if (elTaxable) elTaxable.textContent = formatCurrency(taxableAmount);
        if (elTax) elTax.textContent = formatCurrency(taxAmount);
        if (elGrand) elGrand.textContent = formatCurrency(grandTotal);

        if (elBreakdown) {
            if (taxRate === 0) {
                elBreakdown.textContent = '(0% Zero Tax / Exempt)';
            } else if (taxType === 'IGST') {
                elBreakdown.textContent = `(Inter-state: IGST ${taxRate}% [${formatCurrency(taxAmount)}])`;
            } else if (taxType === 'CGST') {
                elBreakdown.textContent = `(CGST ${taxRate}%: ${formatCurrency(taxAmount)})`;
            } else if (taxType === 'SGST') {
                elBreakdown.textContent = `(SGST ${taxRate}%: ${formatCurrency(taxAmount)})`;
            } else {
                const halfRate = Math.round((taxRate / 2) * 100) / 100;
                const halfAmount = Math.round((taxAmount / 2) * 100) / 100;
                elBreakdown.textContent = `(Intra-state: CGST ${halfRate}% [${formatCurrency(halfAmount)}] + SGST ${halfRate}% [${formatCurrency(halfAmount)}])`;
            }
        }
    }


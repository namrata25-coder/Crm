    // ── Filter & Render Invoice Table ──────────────────────────────────────────
    function filterInvoiceTable() {
        const query = (document.getElementById('invoiceSearchInput')?.value || '').trim().toLowerCase();
        const status = document.getElementById('invoiceStatusFilter')?.value || 'All';

        let filtered = rawInvoices.slice();

        if (query) {
            filtered = filtered.filter(i =>
                (i.invoiceNumber && i.invoiceNumber.toLowerCase().includes(query)) ||
                (i.clientName && i.clientName.toLowerCase().includes(query)) ||
                (i.clientCompany && i.clientCompany.toLowerCase().includes(query)) ||
                (i.projectName && i.projectName.toLowerCase().includes(query)) ||
                (i.milestoneName && i.milestoneName.toLowerCase().includes(query)));
        }

        if (status !== 'All') {
            filtered = filtered.filter(i => {
                const s = i.paymentStatus || 'Pending';
                if (status === 'Pending') return s === 'Pending' || s === 'Unpaid';
                if (status === 'Partial Paid') return s === 'Partial Paid' || s === 'Partially Paid';
                return s.toLowerCase() === status.toLowerCase();
            });
        }

        renderInvoiceTable(filtered);
    }

    function renderInvoiceTable(invoices) {

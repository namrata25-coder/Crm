    async function onRecClientSelected() {
        const client = document.getElementById('recClientSelect').value;
        const projectSelect = document.getElementById('recProjectSelect');
        if (!projectSelect) return;

        projectSelect.innerHTML = '';

        if (!client) {
            const def = document.createElement('option');
            def.value = '';
            def.textContent = '-- Select Client First --';
            projectSelect.appendChild(def);
            return;
        }

        try {
            const res = await fetch(`/api/clients/${encodeURIComponent(client)}/projects`);
            const projects = res.ok ? await res.json() : [];
            if (!projects.length) {
                const def = document.createElement('option');
                def.value = '';
                def.textContent = 'No projects found';
                projectSelect.appendChild(def);
                return;
            }

            const def = document.createElement('option');
            def.value = '';
            def.textContent = '-- Select Project --';
            projectSelect.appendChild(def);

            projects.forEach(p => {
                const opt = document.createElement('option');

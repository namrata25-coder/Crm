    // ── API: Load Projects ─────────────────────────────────────────────────────
    async function loadProjectsFromServer() {
        try {
            const res = await fetch('/api/projects');
            if (res.ok) {
                const data = await res.json();
                allProjects = (Array.isArray(data) ? data : []).map(p => ({

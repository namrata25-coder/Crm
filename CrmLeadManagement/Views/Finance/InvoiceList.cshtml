    function openPaymentModalForInvoice(invId) {
        const inv = rawInvoices.find(i => i.id === invId);
        if (!inv) return;

        document.getElementById('payInvoiceId').value = inv.id;
        document.getElementById('payInvNumberBadge').textContent = inv.invoiceNumber;
        document.getElementById('payClientProjectText').textContent = `${inv.clientCompany || inv.clientName} • ${inv.projectName}`;
        document.getElementById('payGrandTotal').textContent = formatCurrency(inv.grandTotal);
        document.getElementById('payRemaining').textContent = formatCurrency(inv.remainingAmount);

        document.getElementById('payAmount').value = inv.remainingAmount > 0 ? inv.remainingAmount : 0;
        document.getElementById('payAmount').max = inv.remainingAmount;
        document.getElementById('payDate').value = new Date().toISOString().split('T')[0];
        document.getElementById('payMethod').value = 'Bank Transfer';
        document.getElementById('payRef').value = '';
        document.getElementById('payNotes').value = '';

        document.getElementById('paymentModal').style.display = 'flex';
    }


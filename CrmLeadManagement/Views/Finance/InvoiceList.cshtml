                    <span>Tax Amount: <strong id="recTaxAmountText">₹0.00</strong></span>
                    <span>Grand Total: <strong id="recGrandTotalText" style="color:var(--brand-600);font-size:14px;">₹0.00</strong></span>
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:1rem;margin-bottom:1rem;">
                    <div>
                        <label style="display:block;font-size:12.5px;font-weight:600;color:var(--ink-700);margin-bottom:5px;">

    function calculateRecTotals() {
        const amount = Math.max(0, parseFloat(document.getElementById('recAmount')?.value) || 0);
        const taxRate = parseFloat(document.getElementById('recTaxRate')?.value) || 0;
        const taxAmount = Math.round(amount * (taxRate / 100) * 100) / 100;
        const grandTotal = amount + taxAmount;

        const elTax = document.getElementById('recTaxAmountText');
        const elGrand = document.getElementById('recGrandTotalText');
        if (elTax) elTax.textContent = formatCurrency(taxAmount);
        if (elGrand) elGrand.textContent = formatCurrency(grandTotal);
    }

    async function submitRecurringForm(e) {
        e.preventDefault();
        const projectId = parseInt(document.getElementById('recProjectSelect').value, 10);
        const clientName = document.getElementById('recClientSelect').value;

        if (!projectId) {
            showToast('Please select a project', true);
            return;
        }

        const recTaxSel = document.getElementById('recTaxRate');
        const selectedRecTaxOpt = recTaxSel ? recTaxSel.options[recTaxSel.selectedIndex] : null;
        const recTaxRate = parseFloat(recTaxSel?.value) || 0;
        const recTaxType = selectedRecTaxOpt ? (selectedRecTaxOpt.getAttribute('data-type') || 'GST') : 'GST';
        const recTaxName = selectedRecTaxOpt ? (selectedRecTaxOpt.getAttribute('data-name') || '') : '';

        const payload = {
            projectId: projectId,
            clientName: clientName,
            clientCompany: clientName,
            title: document.getElementById('recDescription').value.trim(),
            description: document.getElementById('recDescription').value.trim(),
            amount: parseFloat(document.getElementById('recAmount').value) || 0,
            taxRate: recTaxRate,
            taxName: recTaxName,
            taxType: recTaxType,
            frequency: document.getElementById('recFrequency').value,
            startDate: document.getElementById('recStartDate').value,
            endDate: document.getElementById('recEndDate').value || null,
            status: document.getElementById('recStatus').value
        };

        const btn = document.getElementById('btnSaveRecurring');
        if (btn) btn.disabled = true;

        try {
            const res = await fetch('/api/invoices/recurring', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!res.ok) {
                const err = await res.json().catch(() => ({}));
                throw new Error(err.message || 'Failed to save recurring invoice');
            }

            showToast('Recurring invoice profile created successfully');
            closeRecurringModal();
        } catch (err) {
            showToast(err.message, true);
        } finally {
            if (btn) btn.disabled = false;
        }
    }


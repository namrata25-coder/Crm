<!-- Toast Container -->
<div id="toastNotification" style="display:none;position:fixed;bottom:24px;right:24px;background:#1e293b;color:#fff;padding:12px 20px;border-radius:10px;box-shadow:0 10px 15px -3px rgba(0,0,0,0.2);z-index:9999;font-size:13.5px;font-weight:600;display:flex;align-items:center;gap:10px;transition:opacity 0.3s ease;">
    <i class="bi bi-check-circle-fill" style="color:#10b981;font-size:18px;"></i>
    <span id="toastMessage">Success</span>
</div>

@section Scripts {
<script>
    // Real invoice and project state storage (Synchronised with backend database / API)
    let rawInvoices = [];
    let allClients = [];
    let allProjects = [];
    let currentProjectMilestones = [];

    document.addEventListener('DOMContentLoaded', () => {
        loadInvoicesFromServer();
        loadClientsFromServer();
        loadProjectsFromServer();

        // Close dropdowns when clicking outside
        document.addEventListener('click', (e) => {
            const menu = document.getElementById('exportDropdownMenu');
            const btn = document.getElementById('btnExport');
            if (menu && btn && !btn.contains(e.target) && !menu.contains(e.target)) {
                menu.style.display = 'none';
            }

            const cCont = document.getElementById('clientDropdownContainer');
            const pCont = document.getElementById('projectDropdownContainer');
            const cMenu = document.getElementById('clientDropdownMenu');
            const pMenu = document.getElementById('projectDropdownMenu');

            if (cCont && cMenu && !cCont.contains(e.target)) {
                cMenu.style.display = 'none';
            }
            if (pCont && pMenu && !pCont.contains(e.target)) {
                pMenu.style.display = 'none';
            }
        });
    });

    function toggleExportMenu(e) {
        e.stopPropagation();
        const menu = document.getElementById('exportDropdownMenu');
        if (menu) {
            menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        }
    }

    function showToast(msg, isError = false) {
        const t = document.getElementById('toastNotification');
        if (!t) return;
        const icon = t.querySelector('i');
        const msgSpan = document.getElementById('toastMessage');
        if (msgSpan) msgSpan.textContent = msg;

        if (isError) {
            t.style.background = '#ef4444';
            if (icon) {
                icon.className = 'bi bi-exclamation-triangle-fill';
                icon.style.color = '#fff';
            }
        } else {
            t.style.background = '#1e293b';
            if (icon) {
                icon.className = 'bi bi-check-circle-fill';
                icon.style.color = '#10b981';
            }
        }

        t.style.display = 'flex';
        t.style.opacity = '1';
        setTimeout(() => {
            t.style.opacity = '0';
            setTimeout(() => t.style.display = 'none', 300);
        }, 3500);
    }

    function formatCurrency(num) {
        const val = Number(num) || 0;
        return '₹' + val.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    // ── Update Statistics From Real Invoices Only ─────────────────────────────
    function updateInvoiceStats(invoices) {
        const totalCount = invoices.length;
        let totalRevenue = 0;
        let totalPaid = 0;
        let totalPending = 0;
        let paidCount = 0;
        let pendingCount = 0;

        invoices.forEach(inv => {
            const grandTotal = inv.grandTotal || 0;
            const paid = inv.paidAmount || 0;
            const remaining = inv.remainingAmount !== undefined ? inv.remainingAmount : Math.max(0, grandTotal - paid);
            const status = (inv.paymentStatus || 'Pending').toLowerCase();

            totalRevenue += grandTotal;
            totalPaid += paid;
            totalPending += remaining;

            if (status === 'paid') {
                paidCount++;
            } else {
                pendingCount++;
            }
        });

        const elTotalCount = document.getElementById('statTotalCount');
        const elTotalSubtext = document.getElementById('statTotalSubtext');
        const elPaidAmount = document.getElementById('statPaidAmount');
        const elPaidCount = document.getElementById('statPaidCount');
        const elPendingAmount = document.getElementById('statPendingAmount');
        const elPendingCount = document.getElementById('statPendingCount');
        const elRevenueAmount = document.getElementById('statRevenueAmount');

        if (elTotalCount) elTotalCount.textContent = totalCount;
        if (elTotalSubtext) elTotalSubtext.textContent = `${formatCurrency(totalRevenue)} Invoiced`;
        if (elPaidAmount) elPaidAmount.textContent = formatCurrency(totalPaid);
        if (elPaidCount) elPaidCount.textContent = `${paidCount} Paid`;
        if (elPendingAmount) elPendingAmount.textContent = formatCurrency(totalPending);
        if (elPendingCount) elPendingCount.textContent = `${pendingCount} Pending`;
        if (elRevenueAmount) elRevenueAmount.textContent = formatCurrency(totalRevenue);
    }

    // ── API: Load Invoices from Database ───────────────────────────────────────
    async function loadInvoicesFromServer() {
        const icon = document.getElementById('refreshIcon');
        if (icon) icon.classList.add('spin');

        const tbody = document.getElementById('invoiceTableBody');
        if (tbody && rawInvoices.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="10" style="padding:3rem;text-align:center;color:var(--ink-500);">
                        <div style="display:inline-block;animation:spin 1s linear infinite;font-size:24px;color:var(--brand-600);margin-bottom:8px;">
                            <i class="bi bi-arrow-repeat"></i>
                        </div>
                        <div style="font-weight:600;">Loading invoices...</div>
                    </td>
                </tr>
            `;
        }

        try {
            const res = await fetch('/api/invoices');
            if (!res.ok) {
                const errData = await res.json().catch(() => ({}));
                throw new Error(errData.message || `Server returned ${res.status}: Failed to fetch invoices`);
            }
            const data = await res.json();
            rawInvoices = (Array.isArray(data) ? data : []).map(i => ({
                id: i.Id !== undefined ? i.Id : i.id,
                invoiceNumber: i.InvoiceNumber || i.invoiceNumber || '',
                clientId: i.ClientId || i.clientId || '',
                projectId: i.ProjectId !== undefined ? i.ProjectId : i.projectId,
                projectName: i.ProjectName || i.projectName || '',
                projectCode: i.ProjectCode || i.projectCode || '',
                milestoneId: i.MilestoneId !== undefined ? i.MilestoneId : i.milestoneId,
                milestoneName: i.MilestoneName || i.milestoneName || '',
                milestoneCode: i.MilestoneCode || i.milestoneCode || '',
                milestoneDescription: i.MilestoneDescription || i.milestoneDescription || '',
                milestoneProgressPercent: i.MilestoneProgressPercent !== undefined ? i.MilestoneProgressPercent : (i.milestoneProgressPercent || 0),
                clientName: i.ClientName || i.clientName || '',
                clientCompany: i.ClientCompany || i.clientCompany || '',
                clientEmail: i.ClientEmail || i.clientEmail || '',
                clientMobile: i.ClientMobile || i.clientMobile || '',
                invoiceDate: i.InvoiceDate || i.invoiceDate || '',
                dueDate: i.DueDate || i.dueDate || '',
                amount: i.Amount !== undefined ? i.Amount : (i.amount || 0),
                taxRate: i.TaxRate !== undefined ? i.TaxRate : (i.taxRate || 0),
                tax: i.Tax !== undefined ? i.Tax : (i.tax || 0),
                taxName: i.TaxName || i.taxName || '',
                taxType: i.TaxType || i.taxType || '',
                discount: i.Discount !== undefined ? i.Discount : (i.discount || 0),
                grandTotal: i.GrandTotal !== undefined ? i.GrandTotal : (i.grandTotal || 0),
                paidAmount: i.PaidAmount !== undefined ? i.PaidAmount : (i.paidAmount || 0),
                remainingAmount: i.RemainingAmount !== undefined ? i.RemainingAmount : (i.remainingAmount !== undefined ? i.remainingAmount : 0),
                paymentStatus: i.PaymentStatus || i.paymentStatus || 'Pending',
                paymentDate: i.PaymentDate || i.paymentDate || '',
                isRecurring: i.IsRecurring !== undefined ? i.IsRecurring : (i.isRecurring || false),
                recurringFrequency: i.RecurringFrequency || i.recurringFrequency || '',
                notes: i.Notes || i.notes || '',
                createdDate: i.CreatedDate || i.createdDate || '',
                payments: i.Payments || i.payments || []
            }));
            updateInvoiceStats(rawInvoices);
            filterInvoiceTable();
        } catch (err) {
            console.error(err);
            if (tbody) {
                tbody.innerHTML = '';
                const tr = document.createElement('tr');
                const td = document.createElement('td');
                td.colSpan = 10;
                td.style.padding = '2.5rem';
                td.style.textAlign = 'center';
                td.style.color = '#ef4444';

                const iconEl = document.createElement('i');
                iconEl.className = 'bi bi-exclamation-circle';
                iconEl.style.fontSize = '28px';

                const titleEl = document.createElement('div');
                titleEl.style.marginTop = '6px';
                titleEl.style.fontWeight = '700';
                titleEl.style.fontSize = '14px';
                titleEl.textContent = 'Failed to load invoices';

                const msgEl = document.createElement('div');
                msgEl.style.fontSize = '12.5px';
                msgEl.style.color = 'var(--ink-600)';
                msgEl.style.marginTop = '4px';
                msgEl.textContent = err.message || 'An error occurred while communicating with the database.';

                const retryBtn = document.createElement('button');
                retryBtn.className = 'btn btn-outline';
                retryBtn.type = 'button';
                retryBtn.onclick = () => loadInvoicesFromServer();
                retryBtn.style.marginTop = '12px';
                retryBtn.style.fontSize = '12px';
                retryBtn.style.padding = '5px 12px';
                retryBtn.style.fontWeight = '600';
                retryBtn.innerHTML = '<i class="bi bi-arrow-clockwise"></i> Try Again';

                td.appendChild(iconEl);
                td.appendChild(titleEl);
                td.appendChild(msgEl);
                td.appendChild(retryBtn);
                tr.appendChild(td);
                tbody.appendChild(tr);
            }
            updateInvoiceStats([]);
        } finally {
            if (icon) icon.classList.remove('spin');
        }
    }

    // ── API: Load Clients ──────────────────────────────────────────────────────
    async function loadClientsFromServer() {
        try {
            const res = await fetch('/api/clients');
            if (res.ok) {
                const data = await res.json();
                allClients = (Array.isArray(data) ? data : []).map(c => ({
                    clientId: c.ClientId || c.clientId || c.LeadId || c.leadId || '',
                    leadId: c.LeadId || c.leadId || '',
                    clientName: c.ClientName || c.clientName || '',
                    companyName: c.CompanyName || c.companyName || c.ClientName || c.clientName || '',
                    email: c.Email || c.email || '',
                    mobileNumber: c.MobileNumber || c.mobileNumber || '',
                    projectsCount: c.ProjectsCount !== undefined ? c.ProjectsCount : (c.projectsCount || 0)
                }));
                populateClientDropdowns(allClients);
                renderClientOptions(allClients);
            }
        } catch (e) {
            console.warn('Clients lookup error:', e);
        }
    }

    function populateClientDropdowns(clients) {
        const recSelect = document.getElementById('recClientSelect');
        if (recSelect) {
            recSelect.innerHTML = '';
            const defaultOpt = document.createElement('option');
            defaultOpt.value = '';
            defaultOpt.textContent = '-- Select Client --';
            recSelect.appendChild(defaultOpt);

            clients.forEach(c => {
                const name = c.companyName || c.clientName || 'Client';
                const extra = c.clientName && c.companyName !== c.clientName ? ` (${c.clientName})` : '';

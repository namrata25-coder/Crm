        const projText = document.getElementById('projectSelectText');
        const projClear = document.getElementById('projectClearBtn');

        if (projIdInput) projIdInput.value = '';
        if (projText) {
            projText.textContent = '-- Select Project --';
            projText.style.color = 'var(--ink-500)';

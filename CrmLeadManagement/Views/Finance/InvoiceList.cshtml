                        <div style="display:flex;justify-content:space-between;margin-bottom:4px;">
                            <span style="color:#64748b;">Project:</span>
                            <strong style="color:#0f172a;">${escapeHtml(pdf.projectName)} (${escapeHtml(pdf.projectCode)})</strong>
                        </div>
                        <div style="display:flex;justify-content:space-between;">
                            <span style="color:#64748b;">Milestone:</span>
                            <strong style="color:#4f46e5;">${escapeHtml(pdf.milestoneName)} (${escapeHtml(pdf.milestoneCode || 'MLS')})</strong>
                        </div>
                    </div>
                </div>

                <!-- Scope / Milestone Description Table -->
                <div style="margin-bottom:1.5rem;">
                    <table style="width:100%;border-collapse:collapse;font-size:13px;">
                        <thead>
                            <tr style="background:#f1f5f9;border-top:1px solid #cbd5e1;border-bottom:2px solid #cbd5e1;font-size:11.5px;text-align:left;color:#475569;">
                                <th style="padding:8px 10px;">#</th>
                                <th style="padding:8px 10px;">Milestone Scope &amp; Deliverables Description</th>
                                <th style="padding:8px 10px;text-align:center;">Milestone Code</th>
                                <th style="padding:8px 10px;text-align:right;">Amount (₹)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr style="border-bottom:1px solid #e2e8f0;">
                                <td style="padding:12px 10px;color:#64748b;font-weight:700;">1</td>
                                <td style="padding:12px 10px;">
                                    <strong style="color:#0f172a;font-size:13.5px;">${escapeHtml(pdf.milestoneName)}</strong>
                                    <div style="font-size:12px;color:#64748b;margin-top:3px;line-height:1.4;">
                                        ${escapeHtml(pdf.milestoneDescription || pdf.notes || 'Full milestone scope and deliverables executed under agreement.')}
                                    </div>
                                    <div style="font-size:11.5px;color:#4f46e5;font-weight:600;margin-top:3px;">
                                        Progress Completion: ${pdf.milestoneProgressPercent || 100}%
                                    </div>
                                </td>
                                <td style="padding:12px 10px;text-align:center;font-family:monospace;font-weight:700;color:#4f46e5;">${escapeHtml(pdf.milestoneCode || 'MLS')}</td>
                                <td style="padding:12px 10px;text-align:right;font-weight:800;font-size:14px;color:#0f172a;">${formatCurrency(pdf.subtotal)}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Financial Calculation Breakdown & Bank Details -->
                <div style="display:grid;grid-template-columns:1.1fr 1fr;gap:1.5rem;margin-bottom:1.5rem;">
                    <div>
                        <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:1rem;font-size:12px;line-height:1.5;color:#334155;">
                            <div style="font-size:11px;font-weight:800;color:#475569;text-transform:uppercase;margin-bottom:6px;">Bank Details &amp; Wire Transfer:</div>
                            <div><strong>Bank:</strong> ${escapeHtml(pdf.bankName || 'HDFC Bank Ltd.')}</div>
                            <div><strong>A/C Name:</strong> ${escapeHtml(pdf.bankAccountName || 'Nimbus CRM Technologies Pvt. Ltd.')}</div>
                            <div><strong>A/C No:</strong> <span style="font-family:monospace;font-weight:700;">${escapeHtml(pdf.bankAccountNumber || '50200012345678')}</span></div>
                            <div><strong>IFSC:</strong> <span style="font-family:monospace;font-weight:700;">${escapeHtml(pdf.bankIfsc || 'HDFC0000123')}</span> &bull; <strong>Branch:</strong> Koramangala, Bangalore</div>
                            <div><strong>UPI ID:</strong> <span style="font-family:monospace;font-weight:700;color:#059669;">${escapeHtml(pdf.upiId || 'nimbuscrm@hdfcbank')}</span></div>
                        </div>

                        ${pdf.notes ? `
                            <div style="margin-top:10px;font-size:11.5px;color:#64748b;line-height:1.4;">
                                <strong>Notes / Instructions:</strong> ${escapeHtml(pdf.notes)}
                            </div>
                        ` : ''}
                    </div>

                    <div style="background:#fff;border:1px solid #e2e8f0;border-radius:10px;padding:1rem 1.25rem;font-size:13px;">
                        <div style="display:flex;justify-content:space-between;padding:3px 0;color:#475569;">
                            <span>Subtotal:</span>
                            <strong>${formatCurrency(pdf.subtotal)}</strong>
                        </div>
                        ${pdf.discount > 0 ? `
                            <div style="display:flex;justify-content:space-between;padding:3px 0;color:#059669;">
                                <span>Discount:</span>
                                <strong>-${formatCurrency(pdf.discount)}</strong>
                            </div>
                        ` : ''}
                        <div style="display:flex;justify-content:space-between;padding:3px 0;color:#475569;">
                            <span>Taxable Amount:</span>
                            <strong>${formatCurrency(pdf.taxableAmount || taxable)}</strong>
                        </div>
                        <div style="display:flex;justify-content:space-between;padding:3px 0;font-size:12px;color:#64748b;">
                            <span>CGST (${pdf.cgstRate || halfRate}%):</span>
                            <strong>${formatCurrency(pdf.cgstAmount || halfTax)}</strong>
                        </div>
                        <div style="display:flex;justify-content:space-between;padding:3px 0;font-size:12px;color:#64748b;">
                            <span>SGST (${pdf.sgstRate || halfRate}%):</span>
                            <strong>${formatCurrency(pdf.sgstAmount || halfTax)}</strong>
                        </div>
                        <div style="display:flex;justify-content:space-between;padding:8px 0;border-top:2px solid #4f46e5;border-bottom:2px solid #4f46e5;margin:6px 0;font-size:15px;font-weight:900;color:#0f172a;">
                            <span>Total Payable Amount:</span>
                            <span style="color:#4f46e5;">${formatCurrency(pdf.grandTotal)}</span>
                        </div>
                        <div style="padding:6px 8px;background:#eef2ff;border-radius:6px;font-size:11px;color:#3730a3;font-weight:600;margin-bottom:6px;">
                            <strong>Words:</strong> ${numberToIndianWords(pdf.grandTotal)}
                        </div>
                        <div style="display:flex;justify-content:space-between;padding:3px 0;color:#059669;font-weight:700;">
                            <span>Paid Amount:</span>
                            <span>${formatCurrency(pdf.paidAmount)}</span>
                        </div>
                        <div style="display:flex;justify-content:space-between;padding:3px 0;color:#d97706;font-weight:800;font-size:13.5px;border-top:1px dashed #cbd5e1;margin-top:3px;padding-top:4px;">
                            <span>Balance Due:</span>
                            <span>${formatCurrency(pdf.remainingAmount)}</span>
                        </div>
                    </div>
                </div>

                <!-- Payment History Table -->
                ${paymentRows ? `
                    <div style="border:1px solid #e2e8f0;border-radius:10px;padding:12px;margin-bottom:1.5rem;">
                        <div style="font-size:11.5px;font-weight:800;color:#475569;text-transform:uppercase;margin-bottom:6px;">Payment History &amp; Receipts:</div>
                        <table style="width:100%;border-collapse:collapse;">
                            <thead>
                                <tr style="background:#f8fafc;border-bottom:1px solid #e2e8f0;font-size:11px;text-align:left;color:#64748b;">
                                    <th style="padding:6px 10px;">Payment #</th>
                                    <th style="padding:6px 10px;">Date</th>
                                    <th style="padding:6px 10px;">Method</th>
                                    <th style="padding:6px 10px;">Reference</th>
                                    <th style="padding:6px 10px;text-align:right;">Amount (₹)</th>
                                </tr>
                            </thead>
                            <tbody>${paymentRows}</tbody>
                        </table>
                    </div>
                ` : ''}

                <!-- Footer & Signature -->
                <div style="border-top:1px solid #e2e8f0;padding-top:1.25rem;display:flex;justify-content:space-between;align-items:flex-end;gap:1.5rem;font-size:11px;color:#64748b;">
                    <div style="line-height:1.4;">
                        Thank you for your business.<br/>
                        This is a computer-generated tax invoice issued under milestone completion approval.
                    </div>
                    <div style="text-align:right;min-width:200px;">
                        <div style="font-weight:700;color:#334155;margin-bottom:2px;">For ${escapeHtml(pdf.companyName || 'Nimbus CRM Technologies Pvt. Ltd.')}</div>
                        <div style="height:36px;border-bottom:1px solid #94a3b8;margin-bottom:4px;display:flex;align-items:flex-end;justify-content:center;font-family:'Brush Script MT',cursive;font-size:18px;color:#1e3a8a;">Antigravity Finance</div>
                        <div style="font-weight:700;text-transform:uppercase;">Authorized Signatory</div>
                    </div>
                </div>
            </div>
        `;
    }

    function printPdfContent() {
        const printContent = document.getElementById('pdfPrintableArea')?.innerHTML || '';
        const win = window.open('', '_blank', 'height=800,width=900');
        win.document.write(`
            <html>
                <head>
                    <title>Invoice PDF</title>
                    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
                    <style>
                        body { font-family: 'Inter', sans-serif; margin: 20px; color: #1e293b; }
                        @@media print {
                            @@page { margin: 15mm; }
                            body { margin: 0; }
                        }
                    </style>
                </head>
                <body onload="window.print();window.close();">
                    ${printContent}
                </body>
            </html>
        `);
        win.document.close();
    }
</script>
}

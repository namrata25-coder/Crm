    // ── Searchable Dropdowns (Client & Project) & Milestone Selection ─────────
    let currentFilteredProjects = [];

    function escapeHtml(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function toggleSearchDropdown(type) {
        const clientMenu = document.getElementById('clientDropdownMenu');
        const projectMenu = document.getElementById('projectDropdownMenu');

        if (type === 'client') {
            if (projectMenu) projectMenu.style.display = 'none';
            if (clientMenu) {
                const isHidden = clientMenu.style.display === 'none' || !clientMenu.style.display;
                clientMenu.style.display = isHidden ? 'flex' : 'none';
                if (isHidden) {
                    const filterInput = document.getElementById('clientSearchFilter');
                    if (filterInput) {
                        filterInput.value = '';
                        filterClientList('');
                        setTimeout(() => filterInput.focus(), 50);
                    }
                }
            }
        } else if (type === 'project') {
            if (clientMenu) clientMenu.style.display = 'none';
            if (projectMenu) {
                const isHidden = projectMenu.style.display === 'none' || !projectMenu.style.display;
                projectMenu.style.display = isHidden ? 'flex' : 'none';
                if (isHidden) {
                    const filterInput = document.getElementById('projectSearchFilter');
                    if (filterInput) {
                        filterInput.value = '';
                        filterProjectList('');
                        setTimeout(() => filterInput.focus(), 50);
                    }
                }
            }
        }
    }

    function renderClientOptions(clientsToRender) {
        const container = document.getElementById('clientOptionsList');
        if (!container) return;

        container.innerHTML = '';
        if (!clientsToRender || !clientsToRender.length) {
            container.innerHTML = '<div style="padding:10px 12px;font-size:12.5px;color:var(--ink-400);text-align:center;">No matching clients found</div>';
            return;
        }

        const selectedClientId = document.getElementById('modalClientId')?.value || '';
        const selectedClientName = (document.getElementById('modalClientSelect')?.value || '').toLowerCase();

        clientsToRender.forEach(c => {
            const displayName = c.companyName || c.clientName || 'Client';
            const extra = c.clientName && c.companyName && c.companyName !== c.clientName ? c.clientName : (c.leadId || '');
            const cid = c.clientId || c.leadId || '';
            const isSelected = (cid && cid === selectedClientId) || (displayName.toLowerCase() === selectedClientName);

            const item = document.createElement('div');
            item.className = 'custom-dropdown-item' + (isSelected ? ' selected' : '');
            item.style.padding = '8px 12px';
            item.style.cursor = 'pointer';
            item.style.fontSize = '13px';
            item.style.borderBottom = '1px solid #f8fafc';
            item.style.display = 'flex';
            item.style.justifyContent = 'space-between';
            item.style.alignItems = 'center';
            item.style.background = isSelected ? '#eff6ff' : '#fff';

            item.innerHTML = `
                <div>
                    <div style="font-weight:600;color:var(--ink-800);">${escapeHtml(displayName)}</div>
                    ${extra ? `<div style="font-size:11px;color:var(--ink-500);">${escapeHtml(extra)}</div>` : ''}
                </div>
                <span class="badge" style="font-size:10px;background:#f1f5f9;color:var(--ink-600);border:1px solid #e2e8f0;">
                    ${c.projectsCount || 0} proj
                </span>
            `;

            item.onmouseover = () => { if (!isSelected) item.style.background = '#f8fafc'; };
            item.onmouseout = () => { if (!isSelected) item.style.background = '#fff'; };
            item.onclick = (e) => {
                e.stopPropagation();
                selectClient(cid, displayName, c.companyName || displayName);
            };

            container.appendChild(item);
        });
    }

    function filterClientList(term) {
        const q = (term || '').trim().toLowerCase();
        if (!q) {
            renderClientOptions(allClients);
            return;
        }
        const filtered = allClients.filter(c =>
            (c.companyName && c.companyName.toLowerCase().includes(q)) ||
            (c.clientName && c.clientName.toLowerCase().includes(q)) ||
            (c.clientId && c.clientId.toLowerCase().includes(q)) ||
            (c.leadId && c.leadId.toLowerCase().includes(q)) ||
            (c.email && c.email.toLowerCase().includes(q))
        );
        renderClientOptions(filtered);
    }

    function selectClient(clientId, clientName, clientCompany) {
        const idInput = document.getElementById('modalClientId');
        const nameInput = document.getElementById('modalClientSelect');
        const textSpan = document.getElementById('clientSelectText');
        const clearBtn = document.getElementById('clientClearBtn');

        if (idInput) idInput.value = clientId || '';
        if (nameInput) nameInput.value = clientName || '';
        const displayText = clientCompany || clientName || '-- Select Client --';
        if (textSpan) {
            textSpan.textContent = displayText;
            textSpan.style.color = 'var(--ink-900)';
            textSpan.style.fontWeight = '600';
        }
        if (clearBtn) clearBtn.style.display = 'inline';

        const menu = document.getElementById('clientDropdownMenu');
        if (menu) menu.style.display = 'none';

        onClientSelected();
    }

    function clearSelectedClient(e) {
        if (e) e.stopPropagation();
        const idInput = document.getElementById('modalClientId');
        const nameInput = document.getElementById('modalClientSelect');
        const textSpan = document.getElementById('clientSelectText');
        const clearBtn = document.getElementById('clientClearBtn');

        if (idInput) idInput.value = '';
        if (nameInput) nameInput.value = '';
        if (textSpan) {
            textSpan.textContent = '-- Select Client --';
            textSpan.style.color = 'var(--ink-500)';
            textSpan.style.fontWeight = 'normal';
        }
        if (clearBtn) clearBtn.style.display = 'none';

        onClientSelected();
    }

    function onClientSelected() {
        const clientName = (document.getElementById('modalClientSelect')?.value || '').trim();
        const clientId = (document.getElementById('modalClientId')?.value || '').trim();

        if (!clientName && !clientId) {
            currentFilteredProjects = allProjects.slice();
        } else {
            const cLower = clientName.toLowerCase();
            currentFilteredProjects = allProjects.filter(p => {
                const pClient = (p.clientName || '').toLowerCase();
                const pComp = (p.clientCompany || '').toLowerCase();
                return pClient === cLower || pComp === cLower ||
                       (cLower && (pClient.includes(cLower) || pComp.includes(cLower)));
            });
        }

        // When client changes, clear previously selected project and milestone if they do not belong to newly selected client
        const currentProjId = parseInt(document.getElementById('modalProjectSelect')?.value, 10) || 0;
        if (currentProjId > 0) {
            const belongs = currentFilteredProjects.some(p => p.id === currentProjId);
            if (!belongs) {
                clearSelectedProject();
            }
        }

        renderProjectOptions(currentFilteredProjects);
    }

    function renderProjectOptions(projectsToRender) {
        const container = document.getElementById('projectOptionsList');
        if (!container) return;

        container.innerHTML = '';
        if (!projectsToRender || !projectsToRender.length) {
            const clientName = document.getElementById('modalClientSelect')?.value;
            const msg = clientName ? 'No projects belonging to this client' : 'No projects available';
            container.innerHTML = `<div style="padding:10px 12px;font-size:12.5px;color:var(--ink-400);text-align:center;">${msg}</div>`;
            return;
        }

        const selectedProjectId = parseInt(document.getElementById('modalProjectSelect')?.value, 10) || 0;

        projectsToRender.forEach(p => {
            const isSelected = p.id === selectedProjectId;
            const item = document.createElement('div');
            item.className = 'custom-dropdown-item' + (isSelected ? ' selected' : '');
            item.style.padding = '8px 12px';
            item.style.cursor = 'pointer';
            item.style.fontSize = '13px';
            item.style.borderBottom = '1px solid #f8fafc';
            item.style.display = 'flex';
            item.style.justifyContent = 'space-between';
            item.style.alignItems = 'center';
            item.style.background = isSelected ? '#eff6ff' : '#fff';

            const codePrefix = p.projectCode ? p.projectCode + ' - ' : '';
            const clientLabel = p.clientCompany || p.clientName || '';

            item.innerHTML = `
                <div>
                    <div style="font-weight:600;color:var(--ink-800);">${escapeHtml(codePrefix + (p.projectName || 'Project'))}</div>
                    <div style="font-size:11px;color:var(--ink-500);">${clientLabel ? escapeHtml(clientLabel) + ' &bull; ' : ''}Budget: ${formatCurrency(p.budget || 0)}</div>
                </div>
                <span class="badge" style="font-size:10px;background:#f1f5f9;color:var(--ink-600);border:1px solid #e2e8f0;">
                    ${(p.milestones ? p.milestones.length : 0)} MLS
                </span>
            `;

            item.onmouseover = () => { if (!isSelected) item.style.background = '#f8fafc'; };
            item.onmouseout = () => { if (!isSelected) item.style.background = '#fff'; };
            item.onclick = (e) => {
                e.stopPropagation();
                selectProject(p.id);
            };

            container.appendChild(item);
        });
    }

    function filterProjectList(term) {
        const q = (term || '').trim().toLowerCase();
        const baseList = currentFilteredProjects.length ? currentFilteredProjects : allProjects;
        if (!q) {
            renderProjectOptions(baseList);
            return;
        }
        const filtered = baseList.filter(p =>
            (p.projectName && p.projectName.toLowerCase().includes(q)) ||
            (p.projectCode && p.projectCode.toLowerCase().includes(q)) ||
            (p.clientName && p.clientName.toLowerCase().includes(q)) ||
            (p.clientCompany && p.clientCompany.toLowerCase().includes(q))
        );
        renderProjectOptions(filtered);
    }

    function selectProject(projectId) {
        const project = allProjects.find(p => p.id === Number(projectId));
        if (!project) return;

        const projIdInput = document.getElementById('modalProjectSelect');
        const projText = document.getElementById('projectSelectText');
        const projClear = document.getElementById('projectClearBtn');

        if (projIdInput) projIdInput.value = project.id;
        const codePrefix = project.projectCode ? project.projectCode + ' - ' : '';
        if (projText) {
            projText.textContent = codePrefix + project.projectName;
            projText.style.color = 'var(--ink-900)';
            projText.style.fontWeight = '600';
        }
        if (projClear) projClear.style.display = 'inline';

        const menu = document.getElementById('projectDropdownMenu');
        if (menu) menu.style.display = 'none';

        // Auto-populate client if not already selected
        const currentClient = (document.getElementById('modalClientSelect')?.value || '').trim();
        const targetClient = project.clientCompany || project.clientName;
        if (!currentClient && targetClient) {
            const matchedClient = allClients.find(c =>
                (c.companyName && c.companyName.toLowerCase() === targetClient.toLowerCase()) ||
                (c.clientName && c.clientName.toLowerCase() === targetClient.toLowerCase())
            );
            if (matchedClient) {
                selectClient(matchedClient.clientId || matchedClient.leadId, matchedClient.clientName, matchedClient.companyName);
            } else {
                document.getElementById('modalClientId').value = '';
                document.getElementById('modalClientSelect').value = targetClient;
                const clientText = document.getElementById('clientSelectText');
                if (clientText) {
                    clientText.textContent = targetClient;
                    clientText.style.color = 'var(--ink-900)';
                    clientText.style.fontWeight = '600';
                }
                const clearBtn = document.getElementById('clientClearBtn');
                if (clearBtn) clearBtn.style.display = 'inline';
            }
        }

        loadMilestonesForProject(project.id);
    }

    function clearSelectedProject(e) {

<!-- Toast Container -->
<div id="toastNotification" style="display:none;position:fixed;bottom:24px;right:24px;background:#1e293b;color:#fff;padding:12px 20px;border-radius:10px;box-shadow:0 10px 15px -3px rgba(0,0,0,0.2);z-index:9999;font-size:13.5px;font-weight:600;display:flex;align-items:center;gap:10px;transition:opacity 0.3s ease;">
    <i class="bi bi-check-circle-fill" style="color:#10b981;font-size:18px;"></i>
    <span id="toastMessage">Success</span>
</div>

@section Scripts {
<script>
    // Real invoice and project state storage (Synchronised with backend database / API)
    let rawInvoices = [];
    let allClients = [];
    let allProjects = [];
    let currentProjectMilestones = [];

    document.addEventListener('DOMContentLoaded', () => {
        loadInvoicesFromServer();
        loadClientsFromServer();
        loadProjectsFromServer();

        // Close export dropdown when clicking outside
        document.addEventListener('click', (e) => {
            const menu = document.getElementById('exportDropdownMenu');
            const btn = document.getElementById('btnExport');
            if (menu && btn && !btn.contains(e.target) && !menu.contains(e.target)) {
                menu.style.display = 'none';
            }
        });
    });

    function toggleExportMenu(e) {
        e.stopPropagation();
        const menu = document.getElementById('exportDropdownMenu');
        if (menu) {
            menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        }
    }

    function showToast(msg, isError = false) {
        const t = document.getElementById('toastNotification');
        if (!t) return;
        const icon = t.querySelector('i');
        const msgSpan = document.getElementById('toastMessage');
        if (msgSpan) msgSpan.textContent = msg;

        if (isError) {
            t.style.background = '#ef4444';
            if (icon) {
                icon.className = 'bi bi-exclamation-triangle-fill';
                icon.style.color = '#fff';
            }
        } else {
            t.style.background = '#1e293b';
            if (icon) {
                icon.className = 'bi bi-check-circle-fill';
                icon.style.color = '#10b981';
            }
        }

        t.style.display = 'flex';
        t.style.opacity = '1';
        setTimeout(() => {
            t.style.opacity = '0';
            setTimeout(() => t.style.display = 'none', 300);
        }, 3500);
    }

    function formatCurrency(num) {
        const val = Number(num) || 0;
        return '₹' + val.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    // ── Update Statistics From Real Invoices Only ─────────────────────────────
    function updateInvoiceStats(invoices) {
        const totalCount = invoices.length;
        let totalRevenue = 0;
        let totalPaid = 0;
        let totalPending = 0;
        let paidCount = 0;
        let pendingCount = 0;

        invoices.forEach(inv => {
            const grandTotal = inv.grandTotal || 0;
            const paid = inv.paidAmount || 0;
            const remaining = inv.remainingAmount !== undefined ? inv.remainingAmount : Math.max(0, grandTotal - paid);
            const status = (inv.paymentStatus || 'Pending').toLowerCase();

            totalRevenue += grandTotal;
            totalPaid += paid;
            totalPending += remaining;

            if (status === 'paid') {
                paidCount++;
            } else {
                pendingCount++;
            }
        });

        const elTotalCount = document.getElementById('statTotalCount');
        const elTotalSubtext = document.getElementById('statTotalSubtext');
        const elPaidAmount = document.getElementById('statPaidAmount');
        const elPaidCount = document.getElementById('statPaidCount');
        const elPendingAmount = document.getElementById('statPendingAmount');
        const elPendingCount = document.getElementById('statPendingCount');
        const elRevenueAmount = document.getElementById('statRevenueAmount');

        if (elTotalCount) elTotalCount.textContent = totalCount;
        if (elTotalSubtext) elTotalSubtext.textContent = `${formatCurrency(totalRevenue)} Invoiced`;
        if (elPaidAmount) elPaidAmount.textContent = formatCurrency(totalPaid);
        if (elPaidCount) elPaidCount.textContent = `${paidCount} Paid`;
        if (elPendingAmount) elPendingAmount.textContent = formatCurrency(totalPending);
        if (elPendingCount) elPendingCount.textContent = `${pendingCount} Pending`;
        if (elRevenueAmount) elRevenueAmount.textContent = formatCurrency(totalRevenue);
    }

    // ── API: Load Invoices from Database ───────────────────────────────────────
    async function loadInvoicesFromServer() {
        const icon = document.getElementById('refreshIcon');
        if (icon) icon.classList.add('spin');

        const tbody = document.getElementById('invoiceTableBody');
        if (tbody && rawInvoices.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="10" style="padding:3rem;text-align:center;color:var(--ink-500);">
                        <div style="display:inline-block;animation:spin 1s linear infinite;font-size:24px;color:var(--brand-600);margin-bottom:8px;">
                            <i class="bi bi-arrow-repeat"></i>
                        </div>
                        <div style="font-weight:600;">Loading invoices...</div>
                    </td>
                </tr>
            `;
        }

        try {
            const res = await fetch('/api/invoices');
            if (!res.ok) {
                const errData = await res.json().catch(() => ({}));
                throw new Error(errData.message || `Server returned ${res.status}: Failed to fetch invoices`);
            }
            rawInvoices = await res.json();
            updateInvoiceStats(rawInvoices);
            filterInvoiceTable();
        } catch (err) {
            console.error(err);
            if (tbody) {
                tbody.innerHTML = '';
                const tr = document.createElement('tr');
                const td = document.createElement('td');
                td.colSpan = 10;
                td.style.padding = '2.5rem';
                td.style.textAlign = 'center';
                td.style.color = '#ef4444';

                const iconEl = document.createElement('i');
                iconEl.className = 'bi bi-exclamation-circle';
                iconEl.style.fontSize = '28px';

                const titleEl = document.createElement('div');
                titleEl.style.marginTop = '6px';
                titleEl.style.fontWeight = '700';
                titleEl.style.fontSize = '14px';
                titleEl.textContent = 'Failed to load invoices';

                const msgEl = document.createElement('div');
                msgEl.style.fontSize = '12.5px';
                msgEl.style.color = 'var(--ink-600)';
                msgEl.style.marginTop = '4px';
                msgEl.textContent = err.message || 'An error occurred while communicating with the database.';

                const retryBtn = document.createElement('button');
                retryBtn.className = 'btn btn-outline';
                retryBtn.type = 'button';
                retryBtn.onclick = () => loadInvoicesFromServer();
                retryBtn.style.marginTop = '12px';
                retryBtn.style.fontSize = '12px';
                retryBtn.style.padding = '5px 12px';
                retryBtn.style.fontWeight = '600';
                retryBtn.innerHTML = '<i class="bi bi-arrow-clockwise"></i> Try Again';

                td.appendChild(iconEl);
                td.appendChild(titleEl);
                td.appendChild(msgEl);
                td.appendChild(retryBtn);
                tr.appendChild(td);
                tbody.appendChild(tr);
            }
            updateInvoiceStats([]);
        } finally {
            if (icon) icon.classList.remove('spin');
        }
    }

    // ── API: Load Clients ──────────────────────────────────────────────────────
    async function loadClientsFromServer() {
        try {
            const res = await fetch('/api/clients');
            if (res.ok) {
                allClients = await res.json();
                populateClientDropdowns(allClients);
            }
        } catch (e) {
            console.warn('Clients lookup error:', e);
        }
    }

    function populateClientDropdowns(clients) {
        const invSelect = document.getElementById('modalClientSelect');
        const recSelect = document.getElementById('recClientSelect');

        if (invSelect) {
            invSelect.innerHTML = '';
            const defaultOpt = document.createElement('option');
            defaultOpt.value = '';
            defaultOpt.textContent = '-- Select Client --';
            invSelect.appendChild(defaultOpt);

            clients.forEach(c => {
                const name = c.companyName || c.clientName || 'Client';
                const extra = c.clientName && c.companyName !== c.clientName ? ` (${c.clientName})` : '';
                const opt = document.createElement('option');
                opt.value = name;
                opt.textContent = name + extra;
                invSelect.appendChild(opt);
            });
        }

        if (recSelect) {
            recSelect.innerHTML = '';
            const defaultOpt = document.createElement('option');
            defaultOpt.value = '';
            defaultOpt.textContent = '-- Select Client --';
            recSelect.appendChild(defaultOpt);

            clients.forEach(c => {
                const name = c.companyName || c.clientName || 'Client';
                const extra = c.clientName && c.companyName !== c.clientName ? ` (${c.clientName})` : '';
                const opt = document.createElement('option');
                opt.value = name;
                opt.textContent = name + extra;
                recSelect.appendChild(opt);
            });
        }
    }

    // ── API: Load Projects ─────────────────────────────────────────────────────
    async function loadProjectsFromServer() {
        try {
            const res = await fetch('/api/projects');
            if (res.ok) {
                allProjects = await res.json();
                populateProjectDropdown(allProjects);
            }
        } catch (e) {
            console.warn('Projects lookup error:', e);
        }
    }

    function populateProjectDropdown(projects, selectedProjectId = null) {
        const select = document.getElementById('modalProjectSelect');
        if (!select) return;

        select.innerHTML = '';
        const defaultOpt = document.createElement('option');
        defaultOpt.value = '';
        defaultOpt.textContent = projects.length > 0 ? '-- Select Project --' : 'No projects available';
        select.appendChild(defaultOpt);

        projects.forEach(p => {
            const opt = document.createElement('option');
            opt.value = p.id;
            const codePrefix = p.projectCode ? p.projectCode + ' - ' : '';
            const clientLabel = p.clientCompany || p.clientName;
            opt.textContent = `${codePrefix}${p.projectName}${clientLabel ? ' (' + clientLabel + ')' : ''}`;
            select.appendChild(opt);
        });

        if (selectedProjectId) {
            select.value = String(selectedProjectId);
        }
    }

    // ── Filter & Render Invoice Table ──────────────────────────────────────────
    function filterInvoiceTable() {
        const query = (document.getElementById('invoiceSearchInput')?.value || '').trim().toLowerCase();
        const status = document.getElementById('invoiceStatusFilter')?.value || 'All';

        let filtered = rawInvoices.slice();

        if (query) {
            filtered = filtered.filter(i =>
                (i.invoiceNumber && i.invoiceNumber.toLowerCase().includes(query)) ||
                (i.clientName && i.clientName.toLowerCase().includes(query)) ||
                (i.clientCompany && i.clientCompany.toLowerCase().includes(query)) ||
                (i.projectName && i.projectName.toLowerCase().includes(query)) ||
                (i.milestoneName && i.milestoneName.toLowerCase().includes(query)));
        }

        if (status !== 'All') {
            filtered = filtered.filter(i => {
                const s = i.paymentStatus || 'Pending';
                if (status === 'Pending') return s === 'Pending' || s === 'Unpaid';
                if (status === 'Partial Paid') return s === 'Partial Paid' || s === 'Partially Paid';
                return s.toLowerCase() === status.toLowerCase();
            });
        }

        renderInvoiceTable(filtered);
    }

    function renderInvoiceTable(invoices) {
        const tbody = document.getElementById('invoiceTableBody');
        const badge = document.getElementById('invoiceCountBadge');

        if (badge) badge.textContent = `${invoices.length} invoice${invoices.length === 1 ? '' : 's'}`;
        if (!tbody) return;

        tbody.innerHTML = '';

        if (!invoices.length) {
            const emptyRow = document.createElement('tr');
            emptyRow.innerHTML = `
                <td colspan="10" style="padding:3.5rem;text-align:center;color:var(--ink-400);">
                    <i class="bi bi-receipt" style="font-size:32px;color:var(--ink-300);"></i>
                    <div style="font-weight:700;font-size:15px;color:var(--ink-700);margin-top:8px;">No invoices found.</div>
                    <div style="font-size:12.5px;color:var(--ink-500);margin-top:2px;">Click <strong>+ Add Invoice</strong> to create a new milestone invoice.</div>
                </td>
            `;
            tbody.appendChild(emptyRow);
            return;
        }

        invoices.forEach(inv => {
            const id = inv.id;
            const invNum = inv.invoiceNumber || `INV-${id}`;
            const client = inv.clientCompany || inv.clientName || '—';
            const proj = inv.projectName || '—';
            const milestone = inv.milestoneName || '—';
            const invDate = inv.invoiceDate || '—';
            const subtotal = inv.amount || 0;
            const taxRate = inv.taxRate || 0;
            const taxAmount = inv.tax || 0;
            const grandTotal = inv.grandTotal || 0;
            const paid = inv.paidAmount || 0;
            const remaining = inv.remainingAmount !== undefined ? inv.remainingAmount : Math.max(0, grandTotal - paid);
            const status = inv.paymentStatus || 'Pending';

            const tr = document.createElement('tr');
            tr.style.borderBottom = '1px solid var(--line)';

            // 1. Invoice Number
            const tdNum = document.createElement('td');
            tdNum.style.padding = '12px 14px';
            const linkNum = document.createElement('a');
            linkNum.href = `/Finance/InvoiceDetails/${id}`;
            linkNum.style.fontWeight = '700';
            linkNum.style.color = 'var(--brand-600)';
            linkNum.style.textDecoration = 'none';
            linkNum.style.fontFamily = 'monospace';
            linkNum.style.fontSize = '13.5px';
            linkNum.textContent = invNum;
            tdNum.appendChild(linkNum);
            tr.appendChild(tdNum);

            // 2. Date
            const tdDate = document.createElement('td');
            tdDate.style.padding = '12px 14px';
            tdDate.style.color = 'var(--ink-600)';
            tdDate.textContent = invDate;
            tr.appendChild(tdDate);

            // 3. Project
            const tdProj = document.createElement('td');
            tdProj.style.padding = '12px 14px';
            tdProj.style.color = 'var(--ink-700)';
            if (inv.projectId) {
                const linkProj = document.createElement('a');
                linkProj.href = `/Work/ProjectDetails?id=${inv.projectId}&tab=invoice`;
                linkProj.style.color = 'var(--ink-800)';
                linkProj.style.textDecoration = 'none';
                linkProj.style.fontWeight = '600';
                linkProj.textContent = proj;
                tdProj.appendChild(linkProj);
            } else {
                tdProj.textContent = proj;
            }
            tr.appendChild(tdProj);

            // 4. Milestone
            const tdMs = document.createElement('td');
            tdMs.style.padding = '12px 14px';
            const msSpan = document.createElement('span');
            msSpan.style.display = 'inline-flex';
            msSpan.style.alignItems = 'center';
            msSpan.style.gap = '4px';
            msSpan.style.color = 'var(--ink-700)';
            msSpan.style.fontWeight = '600';
            msSpan.style.fontSize = '12.5px';
            msSpan.innerHTML = '<i class="bi bi-flag" style="color:var(--brand-600);font-size:11px;"></i> ';
            const msNameNode = document.createTextNode(milestone);
            msSpan.appendChild(msNameNode);
            tdMs.appendChild(msSpan);
            tr.appendChild(tdMs);

            // 5. Client
            const tdClient = document.createElement('td');
            tdClient.style.padding = '12px 14px';
            tdClient.style.fontWeight = '600';
            tdClient.style.color = 'var(--ink-800)';
            tdClient.textContent = client;
            tr.appendChild(tdClient);

            // 6. Subtotal Amount
            const tdAmount = document.createElement('td');
            tdAmount.style.padding = '12px 14px';
            tdAmount.style.textAlign = 'right';
            tdAmount.style.fontWeight = '600';
            tdAmount.style.color = 'var(--ink-800)';
            tdAmount.textContent = formatCurrency(subtotal);
            tr.appendChild(tdAmount);

            // 7. Tax
            const tdTax = document.createElement('td');
            tdTax.style.padding = '12px 14px';
            tdTax.style.textAlign = 'right';
            tdTax.style.color = 'var(--ink-600)';
            tdTax.style.fontSize = '12px';
            tdTax.innerHTML = `${formatCurrency(taxAmount)} <span style="font-size:10.5px;color:var(--ink-400);">(${taxRate}%)</span>`;
            tr.appendChild(tdTax);

            // 8. Grand Total
            const tdTotal = document.createElement('td');
            tdTotal.style.padding = '12px 14px';
            tdTotal.style.textAlign = 'right';
            tdTotal.style.fontWeight = '700';
            tdTotal.style.color = 'var(--ink-900)';
            tdTotal.style.fontSize = '13.5px';
            tdTotal.textContent = formatCurrency(grandTotal);
            tr.appendChild(tdTotal);

            // 9. Status Badge
            const tdStatus = document.createElement('td');
            tdStatus.style.padding = '12px 14px';
            tdStatus.style.textAlign = 'center';
            let badgeHtml = '';
            if (status === 'Paid') {
                badgeHtml = '<span class="badge" style="background:#ecfdf5;color:#059669;font-weight:700;border:1px solid #a7f3d0;"><i class="bi bi-check2-circle"></i> Paid</span>';
            } else if (status === 'Partial Paid' || status === 'Partially Paid') {
                badgeHtml = '<span class="badge" style="background:#eff6ff;color:#2563eb;font-weight:700;border:1px solid #bfdbfe;"><i class="bi bi-hourglass-split"></i> Partial Paid</span>';
            } else if (status === 'Overdue') {
                badgeHtml = '<span class="badge" style="background:#fef2f2;color:#dc2626;font-weight:700;border:1px solid #fecaca;"><i class="bi bi-exclamation-circle"></i> Overdue</span>';
            } else {
                badgeHtml = '<span class="badge" style="background:#fffbeb;color:#d97706;font-weight:700;border:1px solid #fde68a;"><i class="bi bi-clock"></i> Pending</span>';
            }
            tdStatus.innerHTML = badgeHtml;
            tr.appendChild(tdStatus);

            // 10. Action Buttons
            const tdActions = document.createElement('td');
            tdActions.style.padding = '12px 14px';
            tdActions.style.textAlign = 'center';

            const actionsWrap = document.createElement('div');
            actionsWrap.style.display = 'inline-flex';
            actionsWrap.style.alignItems = 'center';
            actionsWrap.style.gap = '4px';

            // View
            const btnView = document.createElement('a');
            btnView.href = `/Finance/InvoiceDetails/${id}`;
            btnView.className = 'btn-action btn-view';
            btnView.title = 'View Details';
            btnView.innerHTML = '<i class="bi bi-eye"></i>';
            actionsWrap.appendChild(btnView);

            // Edit
            const btnEdit = document.createElement('button');
            btnEdit.type = 'button';
            btnEdit.className = 'btn-action btn-edit';
            btnEdit.title = 'Edit Invoice';
            btnEdit.innerHTML = '<i class="bi bi-pencil"></i>';
            btnEdit.onclick = () => openEditInvoiceModal(id);
            actionsWrap.appendChild(btnEdit);

            // PDF Form
            const btnPdf = document.createElement('button');
            btnPdf.type = 'button';
            btnPdf.className = 'btn-action btn-view';
            btnPdf.title = 'PDF Form';
            btnPdf.style.color = '#dc2626';
            btnPdf.innerHTML = '<i class="bi bi-file-earmark-pdf"></i>';
            btnPdf.onclick = () => generatePdfForInvoice(id);
            actionsWrap.appendChild(btnPdf);

            // Payment if remaining
            if (remaining > 0) {
                const btnPay = document.createElement('button');
                btnPay.type = 'button';
                btnPay.className = 'btn-action';
                btnPay.title = 'Record Payment';
                btnPay.style.color = '#059669';
                btnPay.style.background = '#ecfdf5';
                btnPay.innerHTML = '<i class="bi bi-cash-stack"></i>';
                btnPay.onclick = () => openPaymentModalForInvoice(id);
                actionsWrap.appendChild(btnPay);
            }

            // Delete
            const btnDel = document.createElement('button');
            btnDel.type = 'button';
            btnDel.className = 'btn-action btn-delete';
            btnDel.title = 'Delete Invoice';
            btnDel.innerHTML = '<i class="bi bi-trash"></i>';
            btnDel.onclick = () => deleteInvoice(id, invNum);
            actionsWrap.appendChild(btnDel);

            tdActions.appendChild(actionsWrap);
            tr.appendChild(tdActions);

            tbody.appendChild(tr);
        });
    }

    // ── Create / Edit Invoice Modal Logic ──────────────────────────────────────
    async function openCreateInvoiceModal() {
        document.getElementById('modalInvId').value = '0';
        document.getElementById('invModalTitle').textContent = 'Create Milestone Invoice';
        document.getElementById('modalAmount').value = '';
        document.getElementById('modalDiscount').value = '0';
        document.getElementById('modalTaxRate').value = '18';
        document.getElementById('modalNotes').value = '';
        document.getElementById('milestoneWarning').style.display = 'none';
        document.getElementById('milestoneAutoHint').style.display = 'none';

        const today = new Date().toISOString().split('T')[0];
        document.getElementById('modalInvDate').value = today;
        const due = new Date();
        due.setDate(due.getDate() + 15);
        document.getElementById('modalDueDate').value = due.toISOString().split('T')[0];

        try {
            const res = await fetch('/api/invoices/next-code');
            const data = await res.json();
            document.getElementById('modalInvNumber').value = data.invoiceNumber || 'INV-0001';
        } catch {
            document.getElementById('modalInvNumber').value = 'INV-0001';
        }

        document.getElementById('modalClientSelect').value = '';
        populateProjectDropdown(allProjects);

        document.getElementById('modalMilestoneId').value = '';
        const msContainer = document.getElementById('modalMilestonesContainer');
        if (msContainer) {
            msContainer.innerHTML = '<div style="grid-column:1/-1;font-size:12px;color:var(--ink-500);padding:10px;background:#f8fafc;border-radius:6px;border:1px dashed var(--line);">Select a project to display its milestones.</div>';
        }
        const countBadge = document.getElementById('modalMilestoneCountBadge');
        if (countBadge) countBadge.textContent = '';

        calculateTotals();
        document.getElementById('invoiceModal').style.display = 'flex';
    }

    async function openEditInvoiceModal(id) {
        const inv = rawInvoices.find(i => i.id === id);
        if (!inv) return;

        document.getElementById('modalInvId').value = inv.id;
        document.getElementById('invModalTitle').textContent = `Edit Invoice (${inv.invoiceNumber})`;
        document.getElementById('modalInvNumber').value = inv.invoiceNumber;
        document.getElementById('modalInvDate').value = inv.invoiceDate || '';
        document.getElementById('modalDueDate').value = inv.dueDate || '';
        document.getElementById('modalAmount').value = inv.amount || 0;
        document.getElementById('modalDiscount').value = inv.discount || 0;

        const taxSel = document.getElementById('modalTaxRate');
        if (taxSel && inv.taxRate !== undefined) {
            let matched = false;
            for (let i = 0; i < taxSel.options.length; i++) {
                const optRate = parseFloat(taxSel.options[i].value);
                const optType = taxSel.options[i].getAttribute('data-type') || '';
                if (Math.abs(optRate - inv.taxRate) < 0.001 && (!inv.taxType || optType.toLowerCase() === (inv.taxType || '').toLowerCase())) {
                    taxSel.selectedIndex = i;
                    matched = true;
                    break;
                }
            }
            if (!matched) {
                for (let i = 0; i < taxSel.options.length; i++) {
                    if (Math.abs(parseFloat(taxSel.options[i].value) - inv.taxRate) < 0.001) {
                        taxSel.selectedIndex = i;
                        matched = true;
                        break;
                    }
                }
            }
            if (!matched) {
                const customOpt = document.createElement('option');
                customOpt.value = inv.taxRate;
                customOpt.setAttribute('data-type', inv.taxType || 'GST');
                customOpt.setAttribute('data-name', inv.taxName || `Tax ${inv.taxRate}%`);
                customOpt.textContent = `${inv.taxName || 'Tax'} (${inv.taxRate}%)`;
                customOpt.selected = true;
                taxSel.appendChild(customOpt);
            }
        }

        document.getElementById('modalNotes').value = inv.notes || '';
        document.getElementById('milestoneWarning').style.display = 'none';
        document.getElementById('milestoneAutoHint').style.display = 'none';

        const clientName = inv.clientCompany || inv.clientName || '';
        document.getElementById('modalClientSelect').value = clientName;

        populateProjectDropdown(allProjects, inv.projectId);
        if (inv.projectId) {
            await loadMilestonesForProject(inv.projectId, inv.milestoneId);
        }

        calculateTotals();
        document.getElementById('invoiceModal').style.display = 'flex';
    }

    function closeInvoiceModal() {
        document.getElementById('invoiceModal').style.display = 'none';
    }

    function onClientSelected() {
        const client = document.getElementById('modalClientSelect').value;
        const projectSelect = document.getElementById('modalProjectSelect');
        const container = document.getElementById('modalMilestonesContainer');
        const hiddenMilestoneId = document.getElementById('modalMilestoneId');

        if (hiddenMilestoneId) hiddenMilestoneId.value = '';
        if (container) {
            container.innerHTML = '<div style="grid-column:1/-1;font-size:12px;color:var(--ink-500);padding:10px;background:#f8fafc;border-radius:6px;border:1px dashed var(--line);">Select a project to display its milestones.</div>';
        }

        if (!client) {
            populateProjectDropdown(allProjects);
            return;
        }

        const filtered = allProjects.filter(p =>
            (p.clientCompany && p.clientCompany.toLowerCase() === client.toLowerCase()) ||
            (p.clientName && p.clientName.toLowerCase() === client.toLowerCase()));

        populateProjectDropdown(filtered);
    }

    async function onProjectSelected() {
        const projectId = document.getElementById('modalProjectSelect').value;
        const container = document.getElementById('modalMilestonesContainer');
        const hiddenMilestoneId = document.getElementById('modalMilestoneId');

        if (hiddenMilestoneId) hiddenMilestoneId.value = '';
        if (container) container.innerHTML = '';

        if (!projectId) {
            if (container) {
                container.innerHTML = '<div style="grid-column:1/-1;font-size:12px;color:var(--ink-500);padding:10px;background:#f8fafc;border-radius:6px;border:1px dashed var(--line);">Select a project to display its milestones.</div>';
            }
            selectMilestoneForInvoiceModal(null);
            return;
        }

        // Auto-select client matching the selected project
        const project = allProjects.find(p => p.id === Number(projectId));
        if (project) {
            const clientSelect = document.getElementById('modalClientSelect');
            const targetClient = project.clientCompany || project.clientName;
            if (clientSelect && targetClient) {
                clientSelect.value = targetClient;
            }
        }

        await loadMilestonesForProject(projectId);
    }

    async function loadMilestonesForProject(projectId, selectedMilestoneId = null) {
        const container = document.getElementById('modalMilestonesContainer');
        const hiddenInput = document.getElementById('modalMilestoneId');
        const countBadge = document.getElementById('modalMilestoneCountBadge');
        if (!container) return;

        container.innerHTML = ''; // Clean container during fetch

        try {
            const res = await fetch(`/api/milestones?projectId=${projectId}`);
            currentProjectMilestones = res.ok ? await res.json() : [];
            const currentInvId = parseInt(document.getElementById('modalInvId').value, 10) || 0;

            if (countBadge) {
                countBadge.textContent = `${currentProjectMilestones.length} Milestone${currentProjectMilestones.length === 1 ? '' : 's'}`;
            }

            if (!currentProjectMilestones.length) {
                container.innerHTML = `
                    <div style="grid-column:1/-1;font-size:12px;color:var(--ink-500);padding:10px;background:#f8fafc;border-radius:6px;border:1px dashed var(--line);text-align:center;">
                        No milestones found for this project.
                    </div>
                `;
                if (hiddenInput) hiddenInput.value = '';
                selectMilestoneForInvoiceModal(null);
                return;
            }

            let defaultSelectedId = null;

            currentProjectMilestones.forEach(m => {
                const amount = Number(m.amount > 0 ? m.amount : (m.effectiveAmount || 0));
                const alreadyInvoiced = rawInvoices.some(i => i.milestoneId === m.id && i.id !== currentInvId);
                const isSelected = selectedMilestoneId && Number(selectedMilestoneId) === m.id;
                const status = m.status || 'Pending';
                const msCode = m.milestoneCode || 'MLS';
                const msName = m.milestoneName || 'Milestone';
                const prog = Number(m.progressPercent) || 0;

                if (!alreadyInvoiced && !defaultSelectedId) {
                    defaultSelectedId = m.id;
                }

                const card = document.createElement('div');
                card.className = 'inv-modal-ms-card' + (alreadyInvoiced ? ' inv-modal-ms-disabled' : '');
                card.id = `modal-ms-card-${m.id}`;
                card.style.borderRadius = '8px';
                card.style.padding = '9px 11px';
                card.style.transition = 'all 0.15s ease';
                card.style.display = 'flex';
                card.style.flexDirection = 'column';
                card.style.justifyContent = 'space-between';

                if (alreadyInvoiced) {
                    card.style.border = '1px solid #e2e8f0';
                    card.style.background = '#f8fafc';
                    card.style.opacity = '0.65';
                    card.style.cursor = 'not-allowed';

                    card.innerHTML = `
                        <div style="display:flex;align-items:center;justify-content:space-between;gap:6px;margin-bottom:3px;">
                            <span class="badge" style="font-size:10px;background:#f1f5f9;color:var(--ink-600);border:1px solid #cbd5e1;"></span>
                            <span class="badge" style="font-size:10px;background:#fef2f2;color:#dc2626;border:1px solid #fecaca;font-weight:700;">
                                <i class="bi bi-lock-fill"></i> Invoiced
                            </span>
                        </div>
                        <div class="ms-card-name" style="font-weight:700;font-size:12.5px;color:var(--ink-700);margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"></div>
                        <div style="font-size:11.5px;color:var(--ink-500);display:flex;justify-content:space-between;align-items:center;">
                            <span class="ms-card-amount"></span>
                            <span class="ms-card-due"></span>
                        </div>
                    `;
                    card.querySelector('.badge').textContent = msCode;
                    const nameEl = card.querySelector('.ms-card-name');
                    nameEl.textContent = msName;
                    nameEl.title = msName;
                    card.querySelector('.ms-card-amount').textContent = formatCurrency(amount);
                    if (m.dueDate) card.querySelector('.ms-card-due').textContent = 'Due: ' + m.dueDate;
                } else {
                    card.style.cursor = 'pointer';
                    if (isSelected) {
                        card.style.border = '2px solid var(--brand-600)';
                        card.style.background = '#eff6ff';
                        card.style.boxShadow = '0 2px 6px rgba(79,70,229,0.15)';
                    } else {
                        card.style.border = '1px solid var(--line)';
                        card.style.background = '#fff';
                    }

                    const statusBadgeClass = status === 'Completed' ? 'badge-success' : status === 'In Progress' ? 'badge-info' : 'badge-secondary';
                    card.innerHTML = `
                        <div style="display:flex;align-items:center;justify-content:space-between;gap:6px;margin-bottom:3px;">
                            <span class="badge badge-code" style="font-weight:700;font-size:10px;"></span>
                            <div style="display:flex;align-items:center;gap:6px;">
                                <span class="badge ${statusBadgeClass}" style="font-size:10px;"></span>
                                <span class="modal-ms-check" id="modal-ms-check-${m.id}">
                                    ${isSelected ? '<i class="bi bi-check-circle-fill" style="color:var(--brand-600);font-size:15px;"></i>' : '<i class="bi bi-circle" style="color:var(--ink-400);font-size:15px;"></i>'}
                                </span>
                            </div>
                        </div>
                        <div class="ms-card-name" style="font-weight:700;font-size:13px;color:var(--ink-900);margin-bottom:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"></div>
                        <div style="display:flex;align-items:center;justify-content:space-between;font-size:11.5px;padding-top:3px;border-top:1px dashed #e2e8f0;margin-top:2px;">
                            <strong class="ms-card-amount" style="color:var(--brand-600);font-size:12.5px;"></strong>
                            <span class="ms-card-meta" style="color:var(--ink-500);font-size:11px;"></span>
                        </div>
                    `;

                    card.querySelector('.badge-code').textContent = msCode;
                    card.querySelector('.' + statusBadgeClass).textContent = status;
                    const nameEl = card.querySelector('.ms-card-name');
                    nameEl.textContent = msName;
                    nameEl.title = msName;
                    card.querySelector('.ms-card-amount').textContent = formatCurrency(amount);
                    card.querySelector('.ms-card-meta').textContent = `${prog}% • ${m.dueDate || ''}`;

                    card.onclick = () => selectMilestoneForInvoiceModal(m.id);
                }

                container.appendChild(card);
            });

            const targetId = selectedMilestoneId || defaultSelectedId;
            if (targetId) {
                selectMilestoneForInvoiceModal(targetId);
            } else {
                selectMilestoneForInvoiceModal(null);
            }

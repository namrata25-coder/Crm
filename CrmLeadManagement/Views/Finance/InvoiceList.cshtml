    async function submitInvoiceForm(e) {
        e.preventDefault();
        const id = parseInt(document.getElementById('modalInvId').value, 10) || 0;
        const isEdit = id > 0;

        const projectId = parseInt(document.getElementById('modalProjectSelect').value, 10);
        const milestoneVal = document.getElementById('modalMilestoneId').value;
        const milestoneId = milestoneVal ? parseInt(milestoneVal, 10) : null;
        let clientName = document.getElementById('modalClientSelect').value;

        if (!projectId) {
            showToast('Please select a project', true);
            return;
        }

        if (!milestoneId) {
            showToast('Please select a milestone for this invoice', true);
            return;
        }

        // Fallback client from selected project if not selected
        if (!clientName) {
            const proj = allProjects.find(p => p.id === projectId);
            if (proj) {
                clientName = proj.clientCompany || proj.clientName || 'Client';
            }
        }

        const taxSel = document.getElementById('modalTaxRate');
        const selectedTaxOpt = taxSel ? taxSel.options[taxSel.selectedIndex] : null;
        const taxRate = parseFloat(taxSel?.value) || 0;
        const taxType = selectedTaxOpt ? (selectedTaxOpt.getAttribute('data-type') || 'GST') : 'GST';
        const taxName = selectedTaxOpt ? (selectedTaxOpt.getAttribute('data-name') || '') : '';

        const payload = {
            id: id,
            projectId: projectId,
            milestoneId: milestoneId,
            invoiceNumber: document.getElementById('modalInvNumber').value.trim(),
            clientName: clientName,
            clientCompany: clientName,
            invoiceDate: document.getElementById('modalInvDate').value,
            dueDate: document.getElementById('modalDueDate').value,
            amount: parseFloat(document.getElementById('modalAmount').value) || 0,
            discount: parseFloat(document.getElementById('modalDiscount').value) || 0,
            taxRate: taxRate,
            taxName: taxName,
            taxType: taxType,
            notes: document.getElementById('modalNotes').value.trim()
        };

        const btn = document.getElementById('btnSaveInvoice');
        if (btn) btn.disabled = true;

        try {
            const url = isEdit ? `/api/invoices/${id}` : '/api/invoices';
            const method = isEdit ? 'PUT' : 'POST';

            const res = await fetch(url, {
                method: method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!res.ok) {
                const errData = await res.json().catch(() => ({}));
                throw new Error(errData.message || 'Failed to save invoice');
            }

            showToast(isEdit ? 'Invoice updated successfully' : 'Invoice created successfully');
            closeInvoiceModal();
            await loadInvoicesFromServer();
        } catch (err) {
            showToast(err.message, true);
        } finally {
            if (btn) btn.disabled = false;
        }
    }


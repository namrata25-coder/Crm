    function resetMilestoneDropdown() {
        const msSelect = document.getElementById('modalMilestoneSelect');
        const msIdInput = document.getElementById('modalMilestoneId');
        const msNameInput = document.getElementById('modalMilestoneName');
        const msMsg = document.getElementById('modalMilestoneMessage');
        const countBadge = document.getElementById('modalMilestoneCountBadge');
        const warning = document.getElementById('milestoneWarning');
        const autoHint = document.getElementById('milestoneAutoHint');

        if (msSelect) {
            msSelect.innerHTML = '<option value="">-- Select Project First --</option>';
            msSelect.disabled = false;
        }
        if (msIdInput) msIdInput.value = '';
        if (msNameInput) msNameInput.value = '';
        if (msMsg) { msMsg.style.display = 'none'; msMsg.textContent = ''; }
        if (countBadge) countBadge.textContent = '';
        if (warning) warning.style.display = 'none';
        if (autoHint) autoHint.style.display = 'none';

        currentProjectMilestones = [];
    }

    async function loadMilestonesForProject(projectId, selectedMilestoneId = null, isEdit = false) {
        const msSelect = document.getElementById('modalMilestoneSelect');
        const msIdInput = document.getElementById('modalMilestoneId');
        const msNameInput = document.getElementById('modalMilestoneName');
        const msMsg = document.getElementById('modalMilestoneMessage');
        const countBadge = document.getElementById('modalMilestoneCountBadge');
        const warning = document.getElementById('milestoneWarning');
        const autoHint = document.getElementById('milestoneAutoHint');

        if (!msSelect) return;

        msSelect.innerHTML = '<option value="">Loading milestones...</option>';
        msSelect.disabled = true;
        if (msMsg) msMsg.style.display = 'none';
        if (warning) warning.style.display = 'none';

        try {
            const res = await fetch(`/api/milestones?projectId=${projectId}`);
            const rawMs = res.ok ? await res.json() : [];
            currentProjectMilestones = (Array.isArray(rawMs) ? rawMs : []).map(m => ({
                id: m.Id !== undefined ? m.Id : m.id,
                projectId: m.ProjectId !== undefined ? m.ProjectId : m.projectId,
                milestoneName: m.MilestoneName || m.milestoneName || '',
                milestoneCode: m.MilestoneCode || m.milestoneCode || '',
                amount: m.Amount !== undefined ? m.Amount : (m.amount || 0),
                effectiveAmount: m.EffectiveAmount !== undefined ? m.EffectiveAmount : (m.effectiveAmount || 0),
                dueDate: m.DueDate || m.dueDate || '',
                description: m.Description || m.description || '',
                notes: m.Notes || m.notes || '',
                status: m.Status || m.status || 'Pending'
            }));

            const currentInvId = parseInt(document.getElementById('modalInvId')?.value, 10) || 0;

            // Rule: 1 Milestone = 1 Invoice
            // Exclude milestones that already have an invoice (unless editing this invoice's own milestone)
            const eligibleMilestones = currentProjectMilestones.filter(m => {
                if (currentInvId > 0 && selectedMilestoneId && m.id === Number(selectedMilestoneId)) {
                    return true;
                }
                const hasInvoice = rawInvoices.some(i => i.milestoneId === m.id && i.id !== currentInvId);
                return !hasInvoice;
            });

            if (countBadge) {
                countBadge.textContent = `${eligibleMilestones.length} Eligible Milestone${eligibleMilestones.length === 1 ? '' : 's'}`;
            }

            // Case 1: No eligible milestones exist
            if (eligibleMilestones.length === 0) {
                msSelect.innerHTML = '<option value="">-- No eligible milestones available --</option>';
                msSelect.disabled = true;
                if (msIdInput) msIdInput.value = '';
                if (msNameInput) msNameInput.value = '';
                if (autoHint) autoHint.style.display = 'none';

                if (msMsg) {
                    msMsg.style.display = 'block';
                    msMsg.style.background = '#fef2f2';
                    msMsg.style.border = '1px solid #fecaca';
                    msMsg.style.color = '#dc2626';
                    msMsg.innerHTML = '<i class="bi bi-exclamation-circle-fill"></i> No eligible milestones available for this project. All milestones have already been invoiced.';
                }
                return;
            }

            msSelect.disabled = false;

            // Case 2: Exactly 1 eligible milestone -> AUTOMATICALLY SELECT IT
            if (eligibleMilestones.length === 1) {
                const singleMs = eligibleMilestones[0];
                const amt = Number(singleMs.amount > 0 ? singleMs.amount : (singleMs.effectiveAmount || 0));

                msSelect.innerHTML = '';
                const opt = document.createElement('option');
                opt.value = singleMs.id;
                opt.selected = true;
                opt.textContent = `${singleMs.milestoneName} (${formatCurrency(amt)})`;
                msSelect.appendChild(opt);

                if (msIdInput) msIdInput.value = singleMs.id;
                if (msNameInput) msNameInput.value = singleMs.milestoneName;

                if (msMsg) {
                    msMsg.style.display = 'block';
                    msMsg.style.background = '#eff6ff';
                    msMsg.style.border = '1px solid #bfdbfe';
                    msMsg.style.color = 'var(--brand-600)';
                    msMsg.innerHTML = `<i class="bi bi-check-circle-fill"></i> Automatically selected eligible milestone: <strong>${escapeHtml(singleMs.milestoneName)}</strong>`;
                }

                if (!isEdit) {
                    populateMilestoneDetails(singleMs);
                }
                return;
            }

            // Case 3: Multiple eligible milestones -> Show dropdown containing available milestones
            msSelect.innerHTML = '';
            const defaultOpt = document.createElement('option');
            defaultOpt.value = '';
            defaultOpt.textContent = `-- Select Milestone (${eligibleMilestones.length} available) --`;
            msSelect.appendChild(defaultOpt);

            eligibleMilestones.forEach(m => {
                const opt = document.createElement('option');
                opt.value = m.id;
                const amt = Number(m.amount > 0 ? m.amount : (m.effectiveAmount || 0));
                opt.textContent = `${m.milestoneName} (${formatCurrency(amt)})`;
                if (selectedMilestoneId && Number(selectedMilestoneId) === m.id) {
                    opt.selected = true;
                }
                msSelect.appendChild(opt);
            });

            if (selectedMilestoneId && eligibleMilestones.some(m => m.id === Number(selectedMilestoneId))) {
                const selected = eligibleMilestones.find(m => m.id === Number(selectedMilestoneId));
                if (msIdInput) msIdInput.value = selected.id;
                if (msNameInput) msNameInput.value = selected.milestoneName;
                if (!isEdit) {
                    populateMilestoneDetails(selected);
                }
            } else {
                if (msIdInput) msIdInput.value = '';
                if (msNameInput) msNameInput.value = '';
                if (autoHint) autoHint.style.display = 'none';
            }
        } catch (e) {
            console.error(e);
            msSelect.innerHTML = '<option value="">Failed to load milestones</option>';
            msSelect.disabled = true;
        }
    }

    function onMilestoneDropdownChange() {
        const msSelect = document.getElementById('modalMilestoneSelect');
        const selectedId = parseInt(msSelect.value, 10);
        const msIdInput = document.getElementById('modalMilestoneId');
        const msNameInput = document.getElementById('modalMilestoneName');
        const autoHint = document.getElementById('milestoneAutoHint');

        if (!selectedId) {
            if (msIdInput) msIdInput.value = '';
            if (msNameInput) msNameInput.value = '';
            if (autoHint) autoHint.style.display = 'none';
            return;
        }

        const milestone = currentProjectMilestones.find(m => m.id === selectedId);
        if (milestone) {
            if (msIdInput) msIdInput.value = milestone.id;
            if (msNameInput) msNameInput.value = milestone.milestoneName;
            populateMilestoneDetails(milestone);
        }
    }

    function populateMilestoneDetails(milestone) {
        const amountInput = document.getElementById('modalAmount');
        const dueInput = document.getElementById('modalDueDate');
        const notesInput = document.getElementById('modalNotes');
        const autoHint = document.getElementById('milestoneAutoHint');

        const amount = Number(milestone.amount > 0 ? milestone.amount : (milestone.effectiveAmount || 0));
        if (amountInput) amountInput.value = amount;
        if (autoHint) autoHint.style.display = amount > 0 ? 'inline' : 'none';

        if (milestone.dueDate && dueInput) {
            dueInput.value = milestone.dueDate;
        }

        if (notesInput && (!notesInput.value || notesInput.value.startsWith('Invoice for Milestone:'))) {
            notesInput.value = `Invoice for Milestone: ${milestone.milestoneName}${milestone.description ? ' - ' + milestone.description : ''}`;
        }

        calculateTotals();
    }


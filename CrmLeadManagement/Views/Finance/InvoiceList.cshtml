    async function submitPaymentForm(e) {
        e.preventDefault();
        const invoiceId = parseInt(document.getElementById('payInvoiceId').value, 10);
        const amount = parseFloat(document.getElementById('payAmount').value) || 0;

        if (amount <= 0) {
            showToast('Please enter a valid payment amount', true);
            return;
        }

        const payload = {
            invoiceId: invoiceId,
            amount: amount,
            paymentDate: document.getElementById('payDate').value,
            paymentMethod: document.getElementById('payMethod').value,
            transactionReference: document.getElementById('payRef').value.trim(),
            notes: document.getElementById('payNotes').value.trim()
        };

        const btn = document.getElementById('btnSavePayment');
        if (btn) btn.disabled = true;

        try {
            const res = await fetch('/api/payments', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!res.ok) {
                const err = await res.json().catch(() => ({}));
                throw new Error(err.message || 'Failed to record payment');
            }

            showToast('Payment recorded successfully! Invoice status updated.');
            closePaymentModal();
            await loadInvoicesFromServer();
        } catch (err) {
            showToast(err.message, true);
        } finally {
            if (btn) btn.disabled = false;
        }

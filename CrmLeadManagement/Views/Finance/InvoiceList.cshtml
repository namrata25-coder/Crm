    async function openEditInvoiceModal(id) {
        const inv = rawInvoices.find(i => i.id === id);
        if (!inv) return;

        document.getElementById('modalInvId').value = inv.id;
        document.getElementById('invModalTitle').textContent = `Edit Invoice (${inv.invoiceNumber})`;
        document.getElementById('modalInvNumber').value = inv.invoiceNumber;
        document.getElementById('modalInvDate').value = inv.invoiceDate || '';
        document.getElementById('modalDueDate').value = inv.dueDate || '';
        document.getElementById('modalAmount').value = inv.amount || 0;
        document.getElementById('modalDiscount').value = inv.discount || 0;

        const taxSel = document.getElementById('modalTaxRate');
        if (taxSel && inv.taxRate !== undefined) {
            let matched = false;
            for (let i = 0; i < taxSel.options.length; i++) {
                const optRate = parseFloat(taxSel.options[i].value);
                const optType = taxSel.options[i].getAttribute('data-type') || '';
                if (Math.abs(optRate - inv.taxRate) < 0.001 && (!inv.taxType || optType.toLowerCase() === (inv.taxType || '').toLowerCase())) {
                    taxSel.selectedIndex = i;
                    matched = true;
                    break;
                }
            }
            if (!matched) {
                for (let i = 0; i < taxSel.options.length; i++) {
                    if (Math.abs(parseFloat(taxSel.options[i].value) - inv.taxRate) < 0.001) {
                        taxSel.selectedIndex = i;
                        matched = true;
                        break;
                    }
                }
            }
            if (!matched) {
                const customOpt = document.createElement('option');
                customOpt.value = inv.taxRate;
                customOpt.setAttribute('data-type', inv.taxType || 'GST');
                customOpt.setAttribute('data-name', inv.taxName || `Tax ${inv.taxRate}%`);
                customOpt.textContent = `${inv.taxName || 'Tax'} (${inv.taxRate}%)`;
                customOpt.selected = true;
                taxSel.appendChild(customOpt);
            }
        }

        document.getElementById('modalNotes').value = inv.notes || '';
        document.getElementById('milestoneWarning').style.display = 'none';
        document.getElementById('milestoneAutoHint').style.display = 'none';

        // Set Client in searchable dropdown
        const clientCompany = inv.clientCompany || inv.clientName || '';
        const clientName = inv.clientName || clientCompany;
        const clientId = inv.clientId || '';
        selectClient(clientId, clientName, clientCompany);

        // Set Project in searchable dropdown and load milestone
        if (inv.projectId) {
            selectProject(inv.projectId);
            await loadMilestonesForProject(inv.projectId, inv.milestoneId, /* isEdit */ true);
        }

        calculateTotals();
        document.getElementById('invoiceModal').style.display = 'flex';
    }

    function closeInvoiceModal() {
        document.getElementById('invoiceModal').style.display = 'none';
    }

    function calculateTotals() {
        const subtotal = Math.max(0, parseFloat(document.getElementById('modalAmount')?.value) || 0);
        let discount = Math.max(0, parseFloat(document.getElementById('modalDiscount')?.value) || 0);
        if (discount > subtotal) discount = subtotal;

        const taxableAmount = Math.max(0, subtotal - discount);
        const taxSel = document.getElementById('modalTaxRate');
        const selectedOpt = taxSel?.options[taxSel.selectedIndex];
        const taxRate = parseFloat(taxSel?.value) || 0;
        const taxType = selectedOpt ? (selectedOpt.getAttribute('data-type') || 'GST') : 'GST';
        const taxAmount = Math.round(taxableAmount * (taxRate / 100) * 100) / 100;
        const grandTotal = taxableAmount + taxAmount;

        const elTaxable = document.getElementById('calcTaxableAmount');
        const elTax = document.getElementById('calcTaxAmount');
        const elGrand = document.getElementById('calcGrandTotal');
        const elBreakdown = document.getElementById('calcTaxBreakdown');

        if (elTaxable) elTaxable.textContent = formatCurrency(taxableAmount);
        if (elTax) elTax.textContent = formatCurrency(taxAmount);
        if (elGrand) elGrand.textContent = formatCurrency(grandTotal);

        if (elBreakdown) {
            if (taxRate === 0) {
                elBreakdown.textContent = '(0% Zero Tax / Exempt)';
            } else if (taxType === 'IGST') {
                elBreakdown.textContent = `(Inter-state: IGST ${taxRate}% [${formatCurrency(taxAmount)}])`;
            } else if (taxType === 'CGST') {
                elBreakdown.textContent = `(CGST ${taxRate}%: ${formatCurrency(taxAmount)})`;
            } else if (taxType === 'SGST') {
                elBreakdown.textContent = `(SGST ${taxRate}%: ${formatCurrency(taxAmount)})`;
            } else {
                const halfRate = Math.round((taxRate / 2) * 100) / 100;
                const halfAmount = Math.round((taxAmount / 2) * 100) / 100;
                elBreakdown.textContent = `(Intra-state: CGST ${halfRate}% [${formatCurrency(halfAmount)}] + SGST ${halfRate}% [${formatCurrency(halfAmount)}])`;
            }
        }
    }

    function validateDates() {
        const invDate = document.getElementById('modalInvDate')?.value;
        const dueDate = document.getElementById('modalDueDate')?.value;

        if (invDate && dueDate && new Date(dueDate) < new Date(invDate)) {
            showToast('Due Date cannot be earlier than Invoice Date', true);
            document.getElementById('modalDueDate').value = invDate;
        }
    }

    async function submitInvoiceForm(e) {
        e.preventDefault();
        const id = parseInt(document.getElementById('modalInvId').value, 10) || 0;
        const isEdit = id > 0;

        const projectId = parseInt(document.getElementById('modalProjectSelect').value, 10);
        const milestoneVal = document.getElementById('modalMilestoneId').value;
        const milestoneId = milestoneVal ? parseInt(milestoneVal, 10) : null;
        let clientName = (document.getElementById('modalClientSelect')?.value || '').trim();
        const clientId = (document.getElementById('modalClientId')?.value || '').trim();

        if (!clientName) {
            showToast('Please select a client', true);
            return;
        }

        if (!projectId) {
            showToast('Please select a project', true);
            return;
        }

        if (!milestoneId) {
            showToast('Please select an eligible milestone for this invoice', true);
            return;
        }

        const taxSel = document.getElementById('modalTaxRate');
        const selectedTaxOpt = taxSel ? taxSel.options[taxSel.selectedIndex] : null;
        const taxRate = parseFloat(taxSel?.value) || 0;
        const taxType = selectedTaxOpt ? (selectedTaxOpt.getAttribute('data-type') || 'GST') : 'GST';
        const taxName = selectedTaxOpt ? (selectedTaxOpt.getAttribute('data-name') || '') : '';

        const payload = {
            id: id,
            projectId: projectId,
            milestoneId: milestoneId,
            invoiceNumber: document.getElementById('modalInvNumber').value.trim(),
            clientId: clientId,
            clientName: clientName,
            clientCompany: clientName,
            invoiceDate: document.getElementById('modalInvDate').value,
            dueDate: document.getElementById('modalDueDate').value,
            amount: parseFloat(document.getElementById('modalAmount').value) || 0,
            discount: parseFloat(document.getElementById('modalDiscount').value) || 0,
            taxRate: taxRate,
            taxName: taxName,
            taxType: taxType,
            notes: document.getElementById('modalNotes').value.trim()
        };

        const btn = document.getElementById('btnSaveInvoice');
        if (btn) btn.disabled = true;

        try {
            const url = isEdit ? `/api/invoices/${id}` : '/api/invoices';
            const method = isEdit ? 'PUT' : 'POST';

            const res = await fetch(url, {
                method: method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!res.ok) {
                const errData = await res.json().catch(() => ({}));
                const errMsg = errData.message || (res.status === 409 ? 'An invoice already exists for this milestone.' : 'Failed to save invoice');
                if (res.status === 409) {
                    const warn = document.getElementById('milestoneWarning');
                    if (warn) {
                        warn.textContent = 'An invoice already exists for this milestone.';
                        warn.style.display = 'block';
                    }
                }
                throw new Error(errMsg);
            }

            showToast(isEdit ? 'Invoice updated successfully' : 'Invoice created successfully');
            closeInvoiceModal();
            await loadInvoicesFromServer();
        } catch (err) {
            showToast(err.message, true);
        } finally {
            if (btn) btn.disabled = false;
        }
    }

    async function deleteInvoice(id, invNum) {
        if (!confirm(`Are you sure you want to delete invoice ${invNum}? This will also delete any recorded payments.`)) {
            return;
        }

        try {
            const res = await fetch(`/api/invoices/${id}`, { method: 'DELETE' });
            if (!res.ok) {
                const err = await res.json().catch(() => ({}));
                throw new Error(err.message || 'Failed to delete invoice');
            }
            showToast('Invoice deleted successfully');
            await loadInvoicesFromServer();
        } catch (err) {
            showToast(err.message, true);
        }
    }


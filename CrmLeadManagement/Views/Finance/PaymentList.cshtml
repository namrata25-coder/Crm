            const project = p.projectName || p.ProjectName || '—';
            const milestone = p.milestoneName || p.MilestoneName || '—';
            const invAmount = p.invoiceGrandTotal || p.InvoiceGrandTotal || 0;
            const paid = p.amount || p.Amount || 0;
            const remaining = p.invoiceRemainingAmount !== undefined ? p.invoiceRemainingAmount : (p.InvoiceRemainingAmount || 0);
            const method = p.paymentMethod || p.PaymentMethod || 'Bank Transfer';
            const ref = p.transactionReference || p.TransactionReference || '—';

                    <td colspan="12" style="padding:3.5rem;text-align:center;color:var(--ink-400);">
                        <i class="bi bi-inbox" style="font-size:32px;color:var(--ink-300);"></i>
                        <h4 style="margin-top:10px;font-weight:700;color:var(--ink-700);">No payments found</h4>
                        <p style="font-size:12.5px;color:var(--ink-500);margin-bottom:1rem;">Record payments against active milestone invoices to track client receipts.</p>

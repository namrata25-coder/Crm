            let statusBadge = '';
            if (status === 'Paid') {
                statusBadge = '<span class="badge" style="background:#ecfdf5;color:#059669;font-weight:700;">Paid</span>';
            } else if (status === 'Partial Paid' || status === 'Partially Paid') {
                statusBadge = '<span class="badge" style="background:#eff6ff;color:#2563eb;font-weight:700;">Partial Paid</span>';
            } else {
                statusBadge = '<span class="badge" style="background:#fffbeb;color:#d97706;font-weight:700;">Pending</span>';

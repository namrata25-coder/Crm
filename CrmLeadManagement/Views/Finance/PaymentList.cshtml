            let methodBadgeColor = '#f1f5f9';
            let methodTextColor = 'var(--ink-700)';
            let methodIcon = 'bi-credit-card';
            if (method === 'UPI') {
                methodBadgeColor = '#fdf4ff';
                methodTextColor = '#a21caf';
                methodIcon = 'bi-phone';
            } else if (method === 'Bank Transfer') {
                methodBadgeColor = '#eef2ff';
                methodTextColor = 'var(--brand-600)';
                methodIcon = 'bi-bank';
            } else if (method === 'Cash') {
                methodBadgeColor = '#ecfdf5';
                methodTextColor = '#059669';
                methodIcon = 'bi-cash';
            }

            return `
                <tr style="border-bottom:1px solid var(--line);">
                    <td style="padding:12px 14px;">
                        <span class="badge" style="background:#ecfdf5;color:#059669;font-family:monospace;font-weight:800;font-size:12px;border:1px solid #a7f3d0;">
                            ${escapeHtml(payNum)}
                        </span>
                    </td>
                    <td style="padding:12px 14px;color:var(--ink-600);white-space:nowrap;">${escapeHtml(payDate)}</td>
                    <td style="padding:12px 14px;">
                        <a href="/Finance/InvoiceDetails/${invId}" class="badge badge-code" style="text-decoration:none;color:var(--brand-600);background:#eef2ff;font-weight:700;display:inline-flex;align-items:center;gap:4px;" title="View Invoice">
                            <i class="bi bi-receipt"></i> ${escapeHtml(invNum)}
                        </a>
                    </td>
                    <td style="padding:12px 14px;font-weight:600;color:var(--ink-800);">
                        ${escapeHtml(client)}
                        ${clientCompany && clientCompany !== client ? `<div style="font-size:11px;color:var(--ink-500);font-weight:normal;">${escapeHtml(clientCompany)}</div>` : ''}
                    </td>
                    <td style="padding:12px 14px;color:var(--ink-700);font-weight:600;">
                        ${escapeHtml(project)}
                    </td>
                    <td style="padding:12px 14px;color:var(--ink-700);">
                        <span class="badge badge-purple" style="font-size:11.5px;font-weight:600;">
                            <i class="bi bi-flag" style="margin-right:2px;"></i> ${escapeHtml(milestone)}
                        </span>
                    </td>
                    <td style="padding:12px 14px;text-align:right;font-weight:600;color:var(--ink-700);">
                        ₹${Number(invAmount).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                    </td>
                    <td style="padding:12px 14px;text-align:right;font-weight:800;color:#059669;font-size:14px;">
                        ₹${Number(paid).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                    </td>
                    <td style="padding:12px 14px;">
                        <span style="display:inline-flex;align-items:center;gap:4px;padding:3px 8px;border-radius:6px;background:${methodBadgeColor};font-size:11.5px;font-weight:700;color:${methodTextColor};">
                            <i class="bi ${methodIcon}"></i> ${escapeHtml(method)}
                        </span>
                    </td>
                    <td style="padding:12px 14px;font-family:monospace;font-size:12px;color:var(--ink-600);">${escapeHtml(ref)}</td>
                    <td style="padding:12px 14px;text-align:center;">
                        ${statusBadge}
                    </td>
                    <td style="padding:12px 14px;text-align:center;white-space:nowrap;">
                        <div style="display:inline-flex;align-items:center;gap:6px;">
                            <button type="button" class="btn-action" style="color:#059669;background:#ecfdf5;border-color:#a7f3d0;" onclick="openReceiptModal(${id})" title="Print Payment Receipt">
                                <i class="bi bi-printer"></i>
                            </button>
                            <a href="/Finance/InvoiceDetails/${invId}" class="btn-action btn-view" title="View Related Invoice">
                                <i class="bi bi-eye"></i>
                            </a>
                            <button type="button" class="btn-action btn-delete" onclick="deletePayment(${id}, '${escapeHtml(payNum)}')" title="Delete Payment">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            `;
        }).join('');
    }

    async function loadInvoicesForDropdown() {
        try {
            const res = await fetch('/api/invoices');
            if (!res.ok) return;
            activeInvoices = await res.json();

            const sel = document.getElementById('payInvoiceSelect');
            sel.innerHTML = '<option value="">-- Select Pending / Partial Invoice --</option>';

            let paidCount = 0;
            let partialCount = 0;

            activeInvoices.forEach(i => {
                const id = i.id || i.Id;
                const invNum = i.invoiceNumber || i.InvoiceNumber;
                const rem = Number(i.remainingAmount !== undefined ? i.remainingAmount : (i.RemainingAmount || 0));
                const client = i.clientName || i.ClientName || i.clientCompany || i.ClientCompany || 'Client';
                const project = i.projectName || i.ProjectName || '';
                const status = i.paymentStatus || i.PaymentStatus;

                if (status === 'Paid') {
                    paidCount++;
                } else {
                    partialCount++;
                }

                if (rem > 0 || status !== 'Paid') {
                    const opt = document.createElement('option');
                    opt.value = id;
                    opt.textContent = `${invNum} - ${client} (${project}) [Due: ₹${rem.toLocaleString('en-IN')}]`;
                    sel.appendChild(opt);
                }
            });

            document.getElementById('statPaidInvoicesCount').textContent = `${paidCount} Fully Paid`;
            document.getElementById('statPartPaidInvoicesCount').textContent = `${partialCount} Pending Due`;
        } catch (e) {
            console.error('Error loading invoices for dropdown:', e);
        }
    }

    function onInvoiceSelected() {
        const invId = parseInt(document.getElementById('payInvoiceSelect').value, 10);
        const box = document.getElementById('invoiceInfoBox');
        if (!invId) {
            box.style.display = 'none';
            return;
        }

        const inv = activeInvoices.find(i => (i.id || i.Id) === invId);
        if (!inv) return;

        const rem = Number(inv.remainingAmount !== undefined ? inv.remainingAmount : (inv.RemainingAmount || 0));
        const total = Number(inv.grandTotal !== undefined ? inv.grandTotal : (inv.GrandTotal || 0));

        document.getElementById('invBoxClient').textContent = inv.clientName || inv.clientCompany || '—';
        document.getElementById('invBoxProject').textContent = (inv.projectName || '') + (inv.milestoneName ? ` (${inv.milestoneName})` : '');
        document.getElementById('invBoxTotal').textContent = '₹' + total.toLocaleString('en-IN', { minimumFractionDigits: 2 });
        document.getElementById('invBoxRemaining').textContent = '₹' + rem.toLocaleString('en-IN', { minimumFractionDigits: 2 });

        document.getElementById('payAmount').value = rem > 0 ? rem : '';
        document.getElementById('payAmount').max = rem > 0 ? rem : '';

        box.style.display = 'block';
    }

    function openCreatePaymentModal() {
        loadInvoicesForDropdown();
        document.getElementById('payInvoiceSelect').value = '';
        document.getElementById('invoiceInfoBox').style.display = 'none';
        document.getElementById('payAmount').value = '';
        document.getElementById('payDate').value = new Date().toISOString().split('T')[0];
        document.getElementById('payMethod').value = 'Bank Transfer';
        document.getElementById('payRef').value = '';
        document.getElementById('payNotes').value = '';
        document.getElementById('paymentModal').style.display = 'flex';
    }

    function closePaymentModal() {
        document.getElementById('paymentModal').style.display = 'none';
    }

    async function submitPayment(e) {
        e.preventDefault();
        const invoiceId = parseInt(document.getElementById('payInvoiceSelect').value, 10);
        const amount = parseFloat(document.getElementById('payAmount').value) || 0;

        if (!invoiceId) {
            showToast('Please select an invoice', true);
            return;
        }

        if (amount <= 0) {
            showToast('Please enter a valid payment amount', true);
            return;
        }

        const payload = {
            InvoiceId: invoiceId,
            Amount: amount,
            PaymentDate: document.getElementById('payDate').value,
            PaymentMethod: document.getElementById('payMethod').value,
            TransactionReference: document.getElementById('payRef').value.trim(),
            Notes: document.getElementById('payNotes').value.trim()
        };

        const btn = document.getElementById('btnSavePayment');
        btn.disabled = true;

        try {
            const res = await fetch('/api/payments', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!res.ok) {
                const errData = await res.json();
                throw new Error(errData.message || 'Failed to record payment');
            }

            const payment = await res.json();
            showToast(`Payment ${payment.paymentNumber || payment.PaymentNumber} recorded successfully!`);
            closePaymentModal();
            await loadPayments();
            await loadInvoicesForDropdown();
        } catch (err) {
            showToast('Error: ' + err.message, true);
        } finally {
            btn.disabled = false;
        }
    }

    async function deletePayment(id, payNum) {
        if (!confirm(`Are you sure you want to delete payment "${payNum}"? Related invoice balance and status will be updated.`)) return;

        try {
            const res = await fetch(`/api/payments/${id}`, { method: 'DELETE' });
            if (!res.ok) throw new Error('Failed to delete payment');

            showToast(`Payment ${payNum} deleted.`);
            await loadPayments();
            await loadInvoicesForDropdown();
        } catch (err) {
            showToast('Error deleting payment: ' + err.message, true);
        }
    }

    function exportPayments(format) {
        window.location.href = `/api/payments/export?format=${format}`;
        const menu = document.getElementById('payExportDropdownMenu');
        if (menu) menu.style.display = 'none';
    }


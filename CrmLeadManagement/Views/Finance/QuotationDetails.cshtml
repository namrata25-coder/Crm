@model CrmLeadManagement.Models.QuotationEntry
@{
    var lead = (CrmLeadManagement.Models.Lead)ViewData["Lead"]!;
}

<div class="breadcrumb-row">
    <a asp-controller="Home" asp-action="Index">Home</a><span class="sep">/</span>
    <a asp-controller="Finance" asp-action="QuotationList">Quotation List</a><span class="sep">/</span>
    <span class="current">@Model.Number</span>
</div>
<div class="page-head">
    <div>
        <h1>Quotation @Model.Number</h1>
        <p>Full quotation details and history for @lead.LeadName.</p>
    </div>
    <div class="action-toolbar">
        <a asp-controller="Lead" asp-action="Details" asp-route-id="@lead.LeadId" asp-route-tab="finance" asp-route-subtab="quotation" class="btn btn-outline">
            <i class="bi bi-person-lines-fill"></i> Open Lead
        </a>
        <a asp-controller="Finance" asp-action="QuotationList" class="btn btn-outline"><i class="bi bi-arrow-left"></i> Back to List</a>
    </div>
</div>

<div class="panel" style="margin-bottom:20px;">
    <div class="panel-header">
        <div><h2>Lead Information</h2></div>
        @Html.Raw(FinanceHelpers.StatusBadge(Model.Status))
    </div>
    <div class="form-grid" style="padding:20px 22px;">
        <div class="form-field"><label>Lead Name</label><div class="cell-primary">@lead.LeadName</div></div>
        <div class="form-field"><label>Contact Number</label><div>@lead.MobileNumber</div></div>
        <div class="form-field"><label>Email</label><div>@lead.Email</div></div>
        <div class="form-field"><label>Company Name</label><div>@lead.CompanyName</div></div>
    </div>
</div>

<div class="panel" style="margin-bottom:20px;">
    <div class="panel-header"><div><h2>Quotation Information</h2></div></div>
    <div class="form-grid" style="padding:20px 22px;">
        <div class="form-field"><label>Quotation Number</label><div class="cell-primary">@Model.Number</div></div>
        <div class="form-field"><label>Date</label><div>@Model.Date</div></div>
        <div class="form-field full"><label>Project / Requirement</label><div>@(string.IsNullOrWhiteSpace(Model.ProjectRequirement) ? "—" : Model.ProjectRequirement)</div></div>
        <div class="form-field"><label>Valid Until</label><div>@(string.IsNullOrWhiteSpace(Model.ValidUntil) ? "—" : Model.ValidUntil)</div></div>
        <div class="form-field"><label>Status</label><div>@Html.Raw(FinanceHelpers.StatusBadge(Model.Status))</div></div>
        <div class="form-field full"><label>Terms &amp; Conditions</label><div>@(string.IsNullOrWhiteSpace(Model.TermsConditions) ? "—" : Model.TermsConditions)</div></div>
        <div class="form-field full"><label>Notes</label><div>@(string.IsNullOrWhiteSpace(Model.Notes) ? "—" : Model.Notes)</div></div>
    </div>

    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr><th>Item / Service</th><th>Quantity</th><th>Rate</th><th>Amount</th></tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="4"><div class="empty-state"><p>No line items on this quotation.</p></div></td></tr>
                }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="cell-primary">@item.ItemName</td>
                        <td>@item.Quantity</td>
                        <td>@FinanceHelpers.Money(item.Rate)</td>
                        <td>@FinanceHelpers.Money(item.Amount)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="fin-totals-row-wrap" style="padding:16px 22px; max-width:340px; margin-left:auto;">
        <div class="fin-totals-row"><span>Subtotal</span><span>@FinanceHelpers.Money(Model.Subtotal)</span></div>
        <div class="fin-totals-row"><span>Discount</span><span>@FinanceHelpers.Money(Model.Discount)</span></div>
        <div class="fin-totals-row"><span>Tax @(!string.IsNullOrWhiteSpace(Model.TaxName) ? $"({Model.TaxName})" : (!string.IsNullOrWhiteSpace(Model.TaxRate) && Model.TaxRate != "0" ? $"({Model.TaxRate}%)" : ""))</span><span>@FinanceHelpers.Money(Model.Tax)</span></div>
        <div class="fin-totals-row grand"><span>Grand Total</span><span>@FinanceHelpers.Money(Model.GrandTotal)</span></div>
    </div>
</div>

<div class="panel" style="margin-bottom:20px;">
    <div class="panel-header"><div><h2>Attachments</h2></div></div>
    <div style="padding:20px 22px;">
        @if (!string.IsNullOrWhiteSpace(Model.AttachmentPath))
        {
            <div class="fin-attach-current">
                <i class="bi bi-paperclip"></i>
                <a href="@Model.AttachmentPath" target="_blank" rel="noopener">@Model.AttachmentFileName</a>
                <a href="@Model.AttachmentPath" download class="btn btn-soft btn-sm" style="margin-left:8px;"><i class="bi bi-download"></i> View / Download</a>
            </div>
        }
        else
        {
            <div style="font-size:13px;color:var(--ink-500);">No attachment</div>
        }
    </div>
</div>

<div class="panel">
    <div class="panel-header">
        <div>
            <h2>Quotation History</h2>
            <div class="hint">All quotations raised for @lead.LeadName</div>
        </div>
    </div>
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr><th>Quotation Number</th><th>Date</th><th>Grand Total</th><th>Status</th><th>Action</th></tr>
            </thead>
            <tbody>
                @foreach (var h in lead.Quotations.AsEnumerable().Reverse())
                {
                    <tr style="@(h.Number == Model.Number ? "background:#f6f9ff;" : "")">
                        <td class="cell-primary">@h.Number @(h.Number == Model.Number ? "(current)" : "")</td>
                        <td>@h.Date</td>
                        <td>@FinanceHelpers.Money(h.GrandTotal)</td>
                        <td>@Html.Raw(FinanceHelpers.StatusBadge(h.Status))</td>
                        <td>
                            <a asp-controller="Finance" asp-action="QuotationDetails" asp-route-leadId="@lead.LeadId" asp-route-number="@h.Number" class="btn btn-soft btn-sm">
                                <i class="bi bi-eye"></i> View
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

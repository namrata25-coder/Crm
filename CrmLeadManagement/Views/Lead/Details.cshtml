@model CrmLeadManagement.Models.Lead
@{
    var lead = Model!;
    var activeTab = ViewData["ActiveTab"] as string ?? "call";
    var activeFinanceSubTab = ViewData["ActiveFinanceSubTab"] as string ?? "estimation";
    var requirementError = TempData["RequirementError"] as string;
    var estimationError = TempData["EstimationError"] as string;
    var quotationError = TempData["QuotationError"] as string;
    var proposalError = TempData["ProposalError"] as string;
    var latestCall = lead.CallHistory.Count > 0 ? lead.CallHistory[^1] : null;
    var latestFollowUp = lead.FollowUps.Count > 0 ? lead.FollowUps[^1] : null;
    var latestVisit = lead.Visits.Count > 0 ? lead.Visits[^1] : null;
}

<div class="breadcrumb-row">
    <a asp-controller="Home" asp-action="Index">Home</a><span class="sep">/</span>
    <a asp-controller="Lead" asp-action="List">Lead List</a><span class="sep">/</span>
    <span class="current">@lead.LeadName</span>
</div>

<!-- ============ LEAD DETAILS HEADER ============ -->
<div class="page-head">
    <div class="detail-hero">
        <div class="avatar-lg">@Initials(lead.LeadName)</div>
        <div>
            <h1>@lead.LeadName</h1>
            <div class="meta">
                <span>@lead.LeadId</span><span class="sep">•</span>
                <span>@lead.CompanyName</span><span class="sep">•</span>
                @Html.Raw(StatusBadge(lead.LeadStatus))
                <span class="badge-priority pr-@(lead.Priority?.ToLower() ?? "medium")">@(lead.Priority ?? "Medium") priority</span>
            </div>
        </div>
    </div>
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
        <button type="button" class="btn btn-primary btn-sm" onclick="switchLeadTab('followup'); openAddFollowUpModal();">
            <i class="bi bi-calendar-plus"></i> Add Follow-up
        </button>
        <a asp-controller="Lead" asp-action="List" class="btn btn-ghost btn-sm"><i class="bi bi-arrow-left"></i> Back to Lead List</a>
    </div>
</div>

<!-- ============ TABS: Call | Follow-up | Requirement | Assign/Re-assign | Finance | Visit ============ -->
<div class="tabs-bar" role="tablist">
    <button type="button" class="tab-btn" data-tab="call" onclick="switchLeadTab('call')">
        <i class="bi bi-telephone-fill"></i> Call
    </button>
    <button type="button" class="tab-btn" data-tab="followup" onclick="switchLeadTab('followup')">
        <i class="bi bi-calendar-check-fill"></i> Follow-up
    </button>
    <button type="button" class="tab-btn" data-tab="requirement" onclick="switchLeadTab('requirement')">
        <i class="bi bi-clipboard-check"></i> Requirement
    </button>
    <button type="button" class="tab-btn" data-tab="assign" onclick="switchLeadTab('assign')">
        <i class="bi bi-person-gear"></i> Assign / Re-assign
    </button>
    <button type="button" class="tab-btn" data-tab="finance" onclick="switchLeadTab('finance')">
        <i class="bi bi-cash-coin"></i> Finance
    </button>
    <button type="button" class="tab-btn" data-tab="visit" onclick="switchLeadTab('visit')">
        <i class="bi bi-geo-alt-fill"></i> Visit
    </button>
</div>

<!-- ============ TAB CONTENT (only one panel visible at a time) ============ -->
<div class="panel" style="margin-bottom:22px;">
    <div class="panel-body">

        <!-- ============ CALL TAB — detail + history + Add Call Detail ============ -->
        <div class="tab-panel" id="tab-call">
            <div class="section-title" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;">
                <span>Call History Detail</span>
                <button type="button" class="btn btn-primary btn-sm" id="btnAddCallDetail" onclick="openAddCallModal()">
                    <i class="bi bi-plus-lg"></i> + Add Call Detail
                </button>
            </div>

            <div id="callSuccessAlert" class="alert-success-banner" style="display:none;margin-bottom:16px;">
                <i class="bi bi-check-circle-fill"></i>
                <span id="callSuccessMsg">Call detail saved successfully!</span>
            </div>

            <div class="empty-state" id="callEmptyState" style="@(latestCall is null ? "" : "display:none;")">
                <i class="bi bi-telephone-x"></i>
                <p>No calls logged yet for this lead.</p>
            </div>

            <div id="callLatestSummaryBox" style="@(latestCall is null ? "display:none;" : "")">
                <div class="info-grid">
                    <div class="info-item"><div class="lbl">CALL DATE</div><div class="val" id="latestCallDate">@(latestCall?.CallDate ?? "—")</div></div>
                    <div class="info-item"><div class="lbl">CALL TIME</div><div class="val" id="latestCallTime">@(latestCall?.CallTime ?? "—")</div></div>
                    <div class="info-item"><div class="lbl">CALL STATUS</div><div class="val" id="latestCallStatus">@Html.Raw(CallStatusBadge(latestCall?.CallStatus))</div></div>
                    <div class="info-item"><div class="lbl">DURATION</div><div class="val muted" id="latestCallDuration">@(string.IsNullOrWhiteSpace(latestCall?.Duration) ? "—" : latestCall?.Duration)</div></div>
                    <div class="info-item full"><div class="lbl">REMARKS</div><div class="val muted" id="latestCallRemarks">@(string.IsNullOrWhiteSpace(latestCall?.Notes) ? "—" : latestCall?.Notes)</div></div>
                </div>
            </div>

            <div id="callHistorySection" style="@(latestCall is null ? "display:none;" : "")">
                <div class="divider-line"></div>

                <div class="section-title">Call History</div>
                <div class="table-wrap" id="callHistoryTableWrap">
                    <table class="data-table" id="callHistoryTable">
                        <thead>
                            <tr>
                                <th>Call Date</th><th>Call Time</th><th>Call Status</th>
                                <th>Duration</th><th>Employee</th><th>Remarks</th>
                            </tr>
                        </thead>
                        <tbody id="callHistoryTbody">
                            @if (lead.CallHistory.Count > 0)
                            {
                                @foreach (var c in lead.CallHistory.AsEnumerable().Reverse())
                                {
                                    <tr>
                                        <td>@c.CallDate</td>
                                        <td>@c.CallTime</td>
                                        <td>@Html.Raw(CallStatusBadge(c.CallStatus))</td>
                                        <td>@(string.IsNullOrWhiteSpace(c.Duration) ? "—" : c.Duration)</td>
                                        <td>@(string.IsNullOrWhiteSpace(c.Employee) ? (string.IsNullOrWhiteSpace(lead.AssignedTo) ? "—" : lead.AssignedTo) : c.Employee)</td>
                                        <td style="max-width:260px;">@(string.IsNullOrWhiteSpace(c.Notes) ? "—" : c.Notes)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ============ FOLLOW-UP TAB — detail + history + Add Follow-up ============ -->
        <div class="tab-panel" id="tab-followup">
            <div class="section-title" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;">
                <span>Follow-up Detail</span>
                <button type="button" class="btn btn-primary btn-sm" id="btnAddFollowUp" onclick="openAddFollowUpModal()">
                    <i class="bi bi-plus-lg"></i> + Add Follow-up
                </button>
            </div>

            <div id="followUpSuccessAlert" class="alert-success-banner" style="display:none;margin-bottom:16px;">
                <i class="bi bi-check-circle-fill"></i>
                <span id="followUpSuccessMsg">Follow-up saved successfully!</span>
            </div>

            <div class="empty-state" id="followUpEmptyState" style="@(latestFollowUp is null ? "" : "display:none;")">
                <i class="bi bi-calendar-x"></i>
                <p>No follow-ups recorded for this lead.</p>
            </div>

            <div id="followUpLatestSummaryBox" style="@(latestFollowUp is null ? "display:none;" : "")">
                <div class="info-grid">
                    <div class="info-item"><div class="lbl">FOLLOW-UP DATE</div><div class="val" id="latestFollowUpDate">@(latestFollowUp?.FollowUpDate ?? "—")</div></div>
                    <div class="info-item"><div class="lbl">FOLLOW-UP TIME</div><div class="val" id="latestFollowUpTime">@(latestFollowUp?.FollowUpTime ?? "—")</div></div>
                    <div class="info-item"><div class="lbl">FOLLOW-UP TYPE</div><div class="val" id="latestFollowUpType">@(string.IsNullOrWhiteSpace(latestFollowUp?.FollowUpType) ? "Call" : latestFollowUp.FollowUpType)</div></div>
                    <div class="info-item"><div class="lbl">STATUS</div><div class="val" id="latestFollowUpStatus">@Html.Raw(FollowUpStatusBadge(latestFollowUp?.Status))</div></div>
                    <div class="info-item full"><div class="lbl">REMARKS</div><div class="val muted" id="latestFollowUpRemarks">@(string.IsNullOrWhiteSpace(latestFollowUp?.Remarks) ? "—" : latestFollowUp.Remarks)</div></div>
                </div>
            </div>

            <div id="followUpHistorySection" style="@(latestFollowUp is null ? "display:none;" : "")">
                <div class="divider-line"></div>

                <div class="section-title">Follow-up History</div>
                <div class="table-wrap" id="followUpHistoryTableWrap">
                    <table class="data-table" id="followUpHistoryTable">
                        <thead>
                            <tr>
                                <th>Follow-up Date</th>
                                <th>Follow-up Time</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Remarks</th>
                            </tr>
                        </thead>
                        <tbody id="followUpHistoryTbody">
                            @if (lead.FollowUps.Count > 0)
                            {
                                @foreach (var f in lead.FollowUps.AsEnumerable().Reverse())
                                {
                                    <tr>
                                        <td>@f.FollowUpDate</td>
                                        <td>@f.FollowUpTime</td>
                                        <td>@(string.IsNullOrWhiteSpace(f.FollowUpType) ? "Call" : f.FollowUpType)</td>
                                        <td>@Html.Raw(FollowUpStatusBadge(f.Status))</td>
                                        <td style="max-width:320px;">@(string.IsNullOrWhiteSpace(f.Remarks) ? "—" : f.Remarks)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ============ REQUIREMENT TAB — Add Requirement (with image) + saved list ============ -->
        <div class="tab-panel" id="tab-requirement">
            <div class="section-title" style="display:flex;align-items:center;justify-content:space-between;">
                <span>Requirements</span>
                <button type="button" class="btn btn-primary btn-sm" onclick="toggleRequirementForm()">
                    <i class="bi bi-plus-lg"></i> Add Requirement
                </button>
            </div>

            @if (!string.IsNullOrEmpty(requirementError))
            {
                <div class="form-error-banner"><i class="bi bi-exclamation-triangle-fill"></i> @requirementError</div>
            }

            <div id="addRequirementForm" class="req-add-form" style="display:none;">
                <form method="post" asp-controller="Lead" asp-action="AddRequirement" enctype="multipart/form-data">
                    <input type="hidden" name="leadId" value="@lead.LeadId" />
                    
                    <div style="font-weight:700;font-size:15px;color:var(--ink-800);margin-bottom:12px;">Basic Requirement Details</div>
                    <div class="form-grid">
                        <div class="form-field full">
                            <label>Requirement Title / Subject</label>
                            <input type="text" name="title" placeholder="e.g., UPVC Windows & Doors Project" />
                        </div>
                        <div class="form-field">
                            <label>Priority</label>
                            <select name="priority">
                                @foreach (var p in LookupData.Priorities)
                                {
                                    if (p == "Medium")
                                    {
                                        <option value="@p" selected>@p</option>
                                    }
                                    else
                                    {
                                        <option value="@p">@p</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="form-field">
                            <label>Status</label>
                            <select name="status">
                                @foreach (var s in LookupData.RequirementStatuses)
                                {
                                    if (s == "New")
                                    {
                                        <option value="@s" selected>@s</option>
                                    }
                                    else
                                    {
                                        <option value="@s">@s</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="form-field">
                            <label>Expected Date</label>
                            <input type="date" name="expectedDate" />
                        </div>
                        <div class="form-field">
                            <label>Budget</label>
                            <input type="text" name="budget" placeholder="e.g., ₹1,50,000" />
                        </div>
                        <div class="form-field full">
                            <label>Description / Remarks</label>
                            <textarea name="description" rows="2" placeholder="General requirement overview or notes..."></textarea>
                        </div>
                    </div>

                    <div class="divider-line" style="margin:16px 0;"></div>

                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;flex-wrap:wrap;gap:8px;">
                        <div>
                            <span style="font-weight:700;font-size:14px;color:var(--ink-800);">Item Specifications</span>
                            <span style="font-size:12px;color:var(--ink-500);margin-left:8px;">(Add individual items in table format)</span>
                        </div>
                        <button type="button" id="addRequirementItemBtn" class="btn btn-primary btn-sm" onclick="addRequirementItem()">
                            <i class="bi bi-plus-lg"></i> Add Item
                        </button>
                    </div>

                    <div class="table-wrap req-table-wrap" style="overflow-x:auto;margin-bottom:18px;border:1px solid var(--line);border-radius:10px;background:#fff;">
                        <table class="data-table req-items-table" style="width:100%;min-width:1250px;border-collapse:collapse;margin:0;">
                            <thead>
                                <tr style="background:var(--ink-50,#f8fafc);border-bottom:1px solid var(--line);">
                                    <th style="width:55px;text-align:center;font-size:12px;font-weight:700;padding:10px 6px;">S.No.</th>
                                    <th style="min-width:130px;font-size:12px;font-weight:700;padding:10px 8px;">Category</th>
                                    <th style="min-width:140px;font-size:12px;font-weight:700;padding:10px 8px;">Item</th>
                                    <th style="min-width:120px;font-size:12px;font-weight:700;padding:10px 8px;">Location</th>
                                    <th style="width:80px;min-width:75px;font-size:12px;font-weight:700;padding:10px 4px;text-align:center;">H1</th>
                                    <th style="width:80px;min-width:75px;font-size:12px;font-weight:700;padding:10px 4px;text-align:center;">H2</th>
                                    <th style="width:80px;min-width:75px;font-size:12px;font-weight:700;padding:10px 4px;text-align:center;">H3</th>
                                    <th style="width:80px;min-width:75px;font-size:12px;font-weight:700;padding:10px 4px;text-align:center;">W1</th>
                                    <th style="width:80px;min-width:75px;font-size:12px;font-weight:700;padding:10px 4px;text-align:center;">W2</th>
                                    <th style="width:80px;min-width:75px;font-size:12px;font-weight:700;padding:10px 4px;text-align:center;">W3</th>
                                    <th style="min-width:125px;font-size:12px;font-weight:700;padding:10px 8px;">Types</th>
                                    <th style="min-width:115px;font-size:12px;font-weight:700;padding:10px 8px;">Topology</th>
                                    <th style="min-width:130px;font-size:12px;font-weight:700;padding:10px 8px;">Glass</th>
                                    <th style="min-width:180px;font-size:12px;font-weight:700;padding:10px 8px;text-align:center;">Photo / Image</th>
                                    <th style="width:45px;text-align:center;padding:10px 4px;"></th>
                                </tr>
                            </thead>
                            <tbody id="requirementItemsTbody">
                            </tbody>
                        </table>
                        <div id="reqItemsEmptyHint" style="padding:22px;text-align:center;color:var(--ink-400);font-size:13px;">
                            <i class="bi bi-table" style="font-size:20px;display:block;margin-bottom:6px;color:var(--ink-300);"></i>
                            No items added yet. Click <strong>"Add Item"</strong> to add item rows in table format.
                        </div>
                    </div>

                    <div class="form-actions" style="display:flex;justify-content:flex-end;gap:10px;margin-top:16px;">
                        <button type="button" class="btn btn-outline" onclick="toggleRequirementForm()">Cancel</button>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save Requirement</button>
                    </div>
                </form>
            </div>

            <div class="divider-line"></div>

            <div class="section-title">Saved Requirements</div>
            @if (lead.Requirements.Count == 0)
            {
                <div class="empty-state"><i class="bi bi-inbox"></i><p>No requirements added yet.</p></div>
            }
            else
            {
                @foreach (var r in lead.Requirements.AsEnumerable().Reverse())
                {
                    <div class="req-card">
                        <div class="row1">
                            <span class="badge-priority pr-@(r.Priority?.ToLower() ?? "medium")">@(r.Priority ?? "Medium") priority</span>
                            <span class="badge-status st-new">@(r.Status ?? "New")</span>
                        </div>
                        <div style="font-weight:700;font-size:14px;margin:6px 0 4px;">@(string.IsNullOrWhiteSpace(r.Title) ? r.ItemName : r.Title)</div>
                        @if (!string.IsNullOrWhiteSpace(r.Description))
                        {
                            <div style="font-size:13px;color:var(--ink-700);margin-bottom:6px;">@r.Description</div>
                        }
                        <div style="font-size:12px;color:var(--ink-500);">
                            @if (!string.IsNullOrWhiteSpace(r.ExpectedDate)) { <span>Expected by @r.ExpectedDate</span> }
                            @if (!string.IsNullOrWhiteSpace(r.Budget)) { <span>&nbsp;•&nbsp;Budget: @r.Budget</span> }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(r.ImagePath))
                        {
                            <div style="margin-top:10px;">
                                <img src="@r.ImagePath" alt="Requirement attachment" style="max-width:220px;max-height:160px;border-radius:10px;border:1px solid var(--line);object-fit:cover;" />
                            </div>
                        }
                    </div>
                }
            }
        </div>

        <!-- ============ ASSIGN / RE-ASSIGN TAB ============ -->
        <div class="tab-panel" id="tab-assign">
            <div class="section-title">Current Assignment</div>
            <div class="assign-current">
                <div class="avatar-chip">
                    <div class="initials">@Initials(lead.AssignedTo)</div>
                </div>
                <div>
                    <div class="lbl">CURRENTLY ASSIGNED TO</div>
                    <div class="name">@(string.IsNullOrWhiteSpace(lead.AssignedTo) ? "Not assigned yet" : lead.AssignedTo)</div>
                </div>
            </div>

            <div class="divider-line"></div>

            <div class="section-title">Assign / Re-assign</div>
            <form method="post" asp-controller="Lead" asp-action="AssignLead">
                <input type="hidden" name="leadId" value="@lead.LeadId" />
                <div class="form-grid">
                    <div class="form-field full">
                        <label>Assigned Employee <span class="req">*</span></label>
                        <select name="assignedEmployee" required>
                            <option value="">Select employee</option>
                            @foreach (var e in LookupData.Employees)
                            {
                                @if (e == lead.AssignedTo)
                                {
                                    <option value="@e" selected>@e</option>
                                }
                                else
                                {
                                    <option value="@e">@e</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label>Assignment Date <span class="req">*</span></label>
                        <input type="date" name="assignmentDate" required value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="form-field"></div>
                    <div class="form-field full">
                        <label>Remarks</label>
                        <textarea name="remarks" placeholder="Reason for assignment / handover notes..."></textarea>
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save / Assign</button>
                </div>
            </form>

            @if (lead.AssignmentHistory.Count > 0)
            {
                <div class="divider-line"></div>
                <div class="section-title">Assignment History</div>
                <div class="table-wrap">
                    <table class="data-table">
                        <thead><tr><th>Assigned Employee</th><th>Assignment Date</th><th>Remarks</th></tr></thead>
                        <tbody>
                            @foreach (var a in lead.AssignmentHistory.AsEnumerable().Reverse())
                            {
                                <tr>
                                    <td>@a.AssignedEmployee</td>
                                    <td>@a.AssignmentDate</td>
                                    <td style="max-width:320px;">@a.Remarks</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- ============ FINANCE TAB — Estimation | Quotation | Proposal sub-tabs ============ -->
        <div class="tab-panel" id="tab-finance">
            <div class="fin-subtabs" role="tablist">
                <button type="button" class="fin-subtab-btn" data-subtab="estimation" onclick="switchFinanceSubTab('estimation')">
                    <i class="bi bi-calculator"></i> Estimation
                </button>
                <button type="button" class="fin-subtab-btn" data-subtab="quotation" onclick="switchFinanceSubTab('quotation')">
                    <i class="bi bi-file-earmark-text"></i> Quotation
                </button>
                <button type="button" class="fin-subtab-btn" data-subtab="proposal" onclick="switchFinanceSubTab('proposal')">
                    <i class="bi bi-file-earmark-richtext"></i> Proposal
                </button>
            </div>

            <!-- ===== ESTIMATION SUB-TAB ===== -->
            <div class="fin-subpanel" id="finsub-estimation">
                <div class="section-title" style="display:flex;align-items:center;justify-content:space-between;">
                    <span>Estimations</span>
                    <button type="button" class="btn btn-primary btn-sm" onclick="newFinanceForm('estimation')">
                        <i class="bi bi-plus-lg"></i> New Estimation
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(estimationError))
                {
                    <div class="form-error-banner"><i class="bi bi-exclamation-triangle-fill"></i> @estimationError</div>
                }

                <div id="estimationForm" class="fin-add-form" style="display:none;">
                    <div class="fin-form-title" style="display:flex;align-items:center;justify-content:space-between;">
                        <span id="estimationFormTitle">New Estimation</span>
                        <span class="fin-number-chip" id="estimationNumberDisplay">Auto-generated on save</span>
                    </div>
                    <form method="post" asp-controller="Lead" asp-action="SaveEstimation" enctype="multipart/form-data">
                        <input type="hidden" name="leadId" value="@lead.LeadId" />
                        <input type="hidden" name="number" id="estimationEditingNumber" value="" />
                        <div class="form-grid">
                            <div class="form-field full">
                                <label>Attach PDF</label>
                                <div class="fin-attach-row">
                                    <label class="btn btn-outline btn-sm fin-attach-btn" for="estimationAttachment">
                                        <i class="bi bi-paperclip"></i> Attach PDF
                                    </label>
                                    <input type="file" name="attachment" id="estimationAttachment"
                                           accept=".pdf,application/pdf"
                                           style="display:none;" onchange="previewFinanceAttachment(this,'estimation')" />
                                    <span id="estimationAttachmentFileName" class="fin-attach-filename">No file chosen</span>
                                </div>
                                <div id="estimationCurrentAttachment" class="fin-attach-current" style="display:none;">
                                    <i class="bi bi-paperclip"></i> Current: <a href="#" id="estimationCurrentAttachmentLink" target="_blank" rel="noopener"></a>
                                    <span class="hint">(uploading a new file will replace this)</span>
                                </div>
                                <div class="hint" style="margin-top:4px;">PDF format up to 10 MB.</div>
                            </div>
                            <div class="form-field full">
                                <label>Description / Notes</label>
                                <textarea name="notes" id="estimationNotes" placeholder="Enter additional information or notes..."></textarea>
                            </div>
                        </div>
                        <div class="form-actions">
                            <button type="button" class="btn btn-outline" onclick="cancelFinanceForm('estimation')">Cancel</button>
                            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save Estimation</button>
                        </div>
                    </form>
                </div>

                <div class="divider-line"></div>
                <div class="section-title">Saved Estimations</div>
                @if (lead.Estimations.Count == 0)
                {
                    <div class="empty-state"><i class="bi bi-calculator"></i><p>No estimations created yet.</p></div>
                }
                else
                {

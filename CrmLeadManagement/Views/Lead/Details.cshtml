@section Scripts {
    <script>
        (function () {
            var initialTab = '@activeTab';
            var initialFinanceSubTab = '@activeFinanceSubTab';
            var hasRequirementError = @(string.IsNullOrEmpty(requirementError) ? "false" : "true");

            function activate() {
                switchLeadTab(initialTab);
                switchFinanceSubTab(initialFinanceSubTab);
                if (hasRequirementError) {
                    switchLeadTab('requirement');
                    toggleRequirementForm();
                }
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', activate);
            } else {
                // DOM already parsed (script executing after content) — run immediately.
                activate();
            }
        })();

        function formatCurrentTime() {
            var now = new Date();
            var hours = now.getHours();
            var minutes = now.getMinutes();
            var ampm = hours >= 12 ? 'PM' : 'AM';
            hours = hours % 12;
            hours = hours ? hours : 12;
            var strMinutes = minutes < 10 ? '0' + minutes : minutes;
            var strHours = hours < 10 ? '0' + hours : hours;
            return strHours + ':' + strMinutes + ' ' + ampm;
        }

        function formatCurrentDate() {
            var now = new Date();
            var year = now.getFullYear();
            var month = String(now.getMonth() + 1).padStart(2, '0');
            var day = String(now.getDate()).padStart(2, '0');
            return year + '-' + month + '-' + day;
        }

        function openAddCallModal() {
            var form = document.getElementById('addCallDetailForm');
            if (form) form.reset();

            var dateInput = document.getElementById('addCallDate');
            if (dateInput) dateInput.value = formatCurrentDate();

            var timeInput = document.getElementById('addCallTime');
            if (timeInput) timeInput.value = formatCurrentTime();

            var statusSelect = document.getElementById('addCallStatus');
            if (statusSelect) statusSelect.value = 'Connected';

            var errBanner = document.getElementById('addCallErrorBanner');
            if (errBanner) {
                errBanner.style.display = 'none';
                errBanner.textContent = '';
            }

            var btn = document.getElementById('btnSaveCallDetail');
            var btnLabel = document.getElementById('saveCallBtnLabel');
            if (btn) btn.disabled = false;
            if (btnLabel) btnLabel.textContent = 'Save Call Detail';

            openModal('addCallModal');
        }

        async function handleSaveCallDetail(e) {
            e.preventDefault();

            var leadId = document.getElementById('addCallLeadId').value;
            var callDate = document.getElementById('addCallDate').value.trim();
            var callTime = document.getElementById('addCallTime').value.trim();
            var duration = document.getElementById('addCallDuration').value.trim();
            var callStatus = document.getElementById('addCallStatus').value;
            var remark = document.getElementById('addCallRemark').value.trim();
            var assignedEmp = document.getElementById('addCallEmployee').value.trim();

            var errBanner = document.getElementById('addCallErrorBanner');
            if (!callDate || !callTime || !callStatus) {
                if (errBanner) {
                    errBanner.textContent = 'Please fill in all required fields (Date, Time, Status).';
                    errBanner.style.display = 'flex';
                }
                return;
            }

            var btn = document.getElementById('btnSaveCallDetail');
            var btnLabel = document.getElementById('saveCallBtnLabel');
            if (btn) btn.disabled = true;
            if (btnLabel) btnLabel.innerHTML = '<i class="bi bi-hourglass-split"></i> Saving...';

            var payload = {
                CallDate: callDate,
                CallTime: callTime,
                Duration: duration,
                CallStatus: callStatus,
                Remark: remark,
                Notes: remark
            };

            try {
                var response = await fetch('/api/leads/' + encodeURIComponent(leadId) + '/calls', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                if (!response.ok) {
                    var errData = {};
                    try { errData = await response.json(); } catch (_) { }
                    var msg = errData.Message || errData.message || ('Server returned error: ' + response.status);
                    if (errBanner) {
                        errBanner.textContent = msg;
                        errBanner.style.display = 'flex';
                    }
                    if (btn) btn.disabled = false;
                    if (btnLabel) btnLabel.textContent = 'Save Call Detail';
                    return;
                }

                var data = await response.json();

                // Close modal
                closeModal('addCallModal');

                // Render status badge HTML
                var isConnected = callStatus.toLowerCase() === 'connected';
                var badgeCls = isConnected ? 'st-won' : 'st-lost';
                var badgeHtml = '<span class="badge-status ' + badgeCls + '">' + escapeHtml(callStatus) + '</span>';

                // Update latest summary box
                var latestDateEl = document.getElementById('latestCallDate');
                var latestTimeEl = document.getElementById('latestCallTime');
                var latestStatusEl = document.getElementById('latestCallStatus');
                var latestDurationEl = document.getElementById('latestCallDuration');
                var latestRemarksEl = document.getElementById('latestCallRemarks');

                if (latestDateEl) latestDateEl.textContent = callDate;
                if (latestTimeEl) latestTimeEl.textContent = callTime;
                if (latestStatusEl) latestStatusEl.innerHTML = badgeHtml;
                if (latestDurationEl) latestDurationEl.textContent = duration || '—';
                if (latestRemarksEl) latestRemarksEl.textContent = remark || '—';

                // Ensure summary and table are visible, empty state hidden
                var emptyState = document.getElementById('callEmptyState');
                if (emptyState) emptyState.style.display = 'none';

                var summaryBox = document.getElementById('callLatestSummaryBox');
                if (summaryBox) summaryBox.style.display = 'block';

                var historySection = document.getElementById('callHistorySection');
                if (historySection) historySection.style.display = 'block';

                // Prepend new row to call history table
                var tbody = document.getElementById('callHistoryTbody');
                if (tbody) {
                    var tr = document.createElement('tr');
                    tr.innerHTML =
                        '<td>' + escapeHtml(callDate) + '</td>' +
                        '<td>' + escapeHtml(callTime) + '</td>' +
                        '<td>' + badgeHtml + '</td>' +
                        '<td>' + escapeHtml(duration || '—') + '</td>' +
                        '<td>' + escapeHtml(assignedEmp || '—') + '</td>' +
                        '<td style="max-width:260px;">' + escapeHtml(remark || '—') + '</td>';
                    tbody.insertBefore(tr, tbody.firstChild);
                }

                // Show success alert
                var successAlert = document.getElementById('callSuccessAlert');
                var successMsg = document.getElementById('callSuccessMsg');
                if (successAlert) {
                    if (successMsg) successMsg.textContent = 'Call detail saved successfully!';
                    successAlert.style.display = 'flex';
                    setTimeout(function () {
                        successAlert.style.display = 'none';
                    }, 4000);
                }
            } catch (err) {
                console.error('Save call detail error:', err);
                if (errBanner) {
                    errBanner.textContent = 'Network error: ' + (err.message || 'Could not connect to server.');
                    errBanner.style.display = 'flex';
                }
            } finally {
                if (btn) btn.disabled = false;
                if (btnLabel) btnLabel.textContent = 'Save Call Detail';
            }
        }

        window.openAddCallModal = openAddCallModal;
        window.handleSaveCallDetail = handleSaveCallDetail;

        function openAddFollowUpModal() {
            var form = document.getElementById('addFollowUpForm');
            if (form) form.reset();

            var dateInput = document.getElementById('addFollowUpDate');
            if (dateInput) dateInput.value = formatCurrentDate();

            var timeInput = document.getElementById('addFollowUpTime');
            if (timeInput) timeInput.value = formatCurrentTime();

            var typeSelect = document.getElementById('addFollowUpType');
            if (typeSelect) typeSelect.value = 'Call';

            var statusSelect = document.getElementById('addFollowUpStatus');
            if (statusSelect) statusSelect.value = 'Pending';

            var errBanner = document.getElementById('addFollowUpErrorBanner');
            if (errBanner) {
                errBanner.style.display = 'none';
                errBanner.textContent = '';
            }

            var btn = document.getElementById('btnSaveFollowUp');
            var btnLabel = document.getElementById('saveFollowUpBtnLabel');
            if (btn) btn.disabled = false;
            if (btnLabel) btnLabel.textContent = 'Save Follow-up';

            openModal('addFollowUpModal');
        }

        function getFollowUpBadgeHtml(status) {
            var s = status || 'Pending';
            var lower = s.toLowerCase().replace(/\s+/g, '');
            var badgeCls = 'st-new';
            if (lower === 'completed') badgeCls = 'st-won';
            else if (lower === 'rescheduled') badgeCls = 'st-proposalsent';
            return '<span class="badge-status ' + badgeCls + '">' + escapeHtml(s) + '</span>';
        }

        async function handleSaveFollowUp(e) {
            e.preventDefault();

            var leadId = document.getElementById('addFollowUpLeadId').value;
            var followUpDate = document.getElementById('addFollowUpDate').value.trim();
            var followUpTime = document.getElementById('addFollowUpTime').value.trim();
            var followUpType = document.getElementById('addFollowUpType').value;
            var status = document.getElementById('addFollowUpStatus').value;
            var remarks = document.getElementById('addFollowUpRemarks').value.trim();

            var errBanner = document.getElementById('addFollowUpErrorBanner');
            if (!followUpDate || !followUpTime || !status) {
                if (errBanner) {
                    errBanner.textContent = 'Please fill in all required fields (Date, Time, Status).';
                    errBanner.style.display = 'flex';
                }
                return;
            }

            var btn = document.getElementById('btnSaveFollowUp');
            var btnLabel = document.getElementById('saveFollowUpBtnLabel');
            if (btn) btn.disabled = true;
            if (btnLabel) btnLabel.innerHTML = '<i class="bi bi-hourglass-split"></i> Saving...';

            var payload = {
                FollowUpDate: followUpDate,
                FollowUpTime: followUpTime,
                FollowUpType: followUpType || 'Call',
                Status: status,
                Remarks: remarks
            };

            try {
                var response = await fetch('/api/leads/' + encodeURIComponent(leadId) + '/followups', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                if (!response.ok) {
                    var errData = {};
                    try { errData = await response.json(); } catch (_) { }
                    var msg = errData.Message || errData.message || ('Server returned error: ' + response.status);
                    if (errBanner) {
                        errBanner.textContent = msg;
                        errBanner.style.display = 'flex';
                    }
                    if (btn) btn.disabled = false;
                    if (btnLabel) btnLabel.textContent = 'Save Follow-up';
                    return;
                }

                var data = await response.json();

                // Close modal
                closeModal('addFollowUpModal');

                var badgeHtml = getFollowUpBadgeHtml(status);

                // Update latest summary box
                var latestDateEl = document.getElementById('latestFollowUpDate');
                var latestTimeEl = document.getElementById('latestFollowUpTime');
                var latestTypeEl = document.getElementById('latestFollowUpType');
                var latestStatusEl = document.getElementById('latestFollowUpStatus');
                var latestRemarksEl = document.getElementById('latestFollowUpRemarks');

                if (latestDateEl) latestDateEl.textContent = followUpDate;
                if (latestTimeEl) latestTimeEl.textContent = followUpTime;
                if (latestTypeEl) latestTypeEl.textContent = followUpType || 'Call';
                if (latestStatusEl) latestStatusEl.innerHTML = badgeHtml;
                if (latestRemarksEl) latestRemarksEl.textContent = remarks || '—';

                // Hide empty state and show summary / history sections
                var emptyState = document.getElementById('followUpEmptyState');
                if (emptyState) emptyState.style.display = 'none';

                var summaryBox = document.getElementById('followUpLatestSummaryBox');
                if (summaryBox) summaryBox.style.display = 'block';

                var historySection = document.getElementById('followUpHistorySection');
                if (historySection) historySection.style.display = 'block';

                // Prepend new row to follow-up history table
                var tbody = document.getElementById('followUpHistoryTbody');
                if (tbody) {
                    var tr = document.createElement('tr');
                    tr.innerHTML =
                        '<td>' + escapeHtml(followUpDate) + '</td>' +
                        '<td>' + escapeHtml(followUpTime) + '</td>' +
                        '<td>' + escapeHtml(followUpType || 'Call') + '</td>' +
                        '<td>' + badgeHtml + '</td>' +
                        '<td style="max-width:320px;">' + escapeHtml(remarks || '—') + '</td>';
                    tbody.insertBefore(tr, tbody.firstChild);
                }

                // Show success alert
                var successAlert = document.getElementById('followUpSuccessAlert');
                var successMsg = document.getElementById('followUpSuccessMsg');
                if (successAlert) {
                    if (successMsg) successMsg.textContent = 'Follow-up saved successfully!';
                    successAlert.style.display = 'flex';
                    setTimeout(function () {
                        successAlert.style.display = 'none';
                    }, 4000);
                }
            } catch (err) {
                console.error('Save follow-up error:', err);
                if (errBanner) {
                    errBanner.textContent = 'Network error: ' + (err.message || 'Could not connect to server.');
                    errBanner.style.display = 'flex';
                }
            } finally {
                if (btn) btn.disabled = false;
                if (btnLabel) btnLabel.textContent = 'Save Follow-up';
            }
        }

        window.openAddFollowUpModal = openAddFollowUpModal;
        window.handleSaveFollowUp = handleSaveFollowUp;

        function openAddVisitModal() {
            var form = document.getElementById('addVisitForm');
            if (form) form.reset();

            var dateInput = document.getElementById('addVisitDate');
            if (dateInput) dateInput.value = formatCurrentDate();

            var timeInput = document.getElementById('addVisitTime');
            if (timeInput) timeInput.value = formatCurrentTime();

            var defaultLoc = document.getElementById('addVisitDefaultLoc');
            var locInput = document.getElementById('addVisitLocation');
            if (locInput && defaultLoc) {
                locInput.value = defaultLoc.value || '';
            }

            var outcomeSelect = document.getElementById('addVisitOutcome');
            if (outcomeSelect) outcomeSelect.value = 'Interested';

            var errBanner = document.getElementById('addVisitErrorBanner');
            if (errBanner) {
                errBanner.style.display = 'none';
                errBanner.textContent = '';
            }

            var btn = document.getElementById('btnSaveVisit');
            var btnLabel = document.getElementById('saveVisitBtnLabel');
            if (btn) btn.disabled = false;
            if (btnLabel) btnLabel.textContent = 'Save Visit';

            openModal('addVisitModal');
        }

        function getVisitOutcomeBadgeHtml(outcome) {
            var oc = outcome || 'Interested';
            var cls = 'st-proposalsent';
            if (oc === 'Interested') cls = 'st-qualified';
            else if (oc === 'Deal Closed') cls = 'st-won';
            else if (oc === 'Not Interested') cls = 'st-lost';
            return '<span class="badge-status ' + cls + '">' + escapeHtml(oc) + '</span>';
        }

        async function handleSaveVisit(e) {
            e.preventDefault();

            var leadId = document.getElementById('addVisitLeadId').value;
            var visitDate = document.getElementById('addVisitDate').value.trim();
            var visitTime = document.getElementById('addVisitTime').value.trim();
            var visitLocation = document.getElementById('addVisitLocation').value.trim();
            var employee = document.getElementById('addVisitEmployee').value.trim();
            var outcome = document.getElementById('addVisitOutcome').value;
            var conversation = document.getElementById('addVisitConversation').value.trim();
            var remarks = document.getElementById('addVisitRemarks').value.trim();

            var errBanner = document.getElementById('addVisitErrorBanner');
            if (!visitDate || !visitTime || !visitLocation) {
                if (errBanner) {
                    errBanner.textContent = 'Please fill in all required fields (Date, Time, Location).';
                    errBanner.style.display = 'flex';
                }
                return;
            }

            var btn = document.getElementById('btnSaveVisit');
            var btnLabel = document.getElementById('saveVisitBtnLabel');
            if (btn) btn.disabled = true;
            if (btnLabel) btnLabel.innerHTML = '<i class="bi bi-hourglass-split"></i> Saving...';

            var payload = {
                VisitDate: visitDate,
                VisitTime: visitTime,
                VisitLocation: visitLocation,
                Employee: employee,
                Outcome: outcome,
                Conversation: conversation,
                Remarks: remarks
            };

            try {
                var response = await fetch('/api/leads/' + encodeURIComponent(leadId) + '/visits', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                if (!response.ok) {
                    var errData = {};
                    try { errData = await response.json(); } catch (_) { }
                    var msg = errData.Message || errData.message || ('Server returned error: ' + response.status);
                    if (errBanner) {
                        errBanner.textContent = msg;
                        errBanner.style.display = 'flex';
                    }
                    if (btn) btn.disabled = false;
                    if (btnLabel) btnLabel.textContent = 'Save Visit';
                    return;
                }

                var data = await response.json();

                // Close modal
                closeModal('addVisitModal');

                var badgeHtml = getVisitOutcomeBadgeHtml(outcome);

                // Update latest summary box in Visit tab
                var latestDateEl = document.getElementById('latestVisitDate');
                var latestTimeEl = document.getElementById('latestVisitTime');
                var latestLocEl = document.getElementById('latestVisitLocation');
                var latestEmpEl = document.getElementById('latestVisitSalesperson');
                var latestOutcomeEl = document.getElementById('latestVisitOutcome');
                var latestConvEl = document.getElementById('latestVisitConversation');
                var latestRemarksEl = document.getElementById('latestVisitRemarks');

                if (latestDateEl) latestDateEl.textContent = visitDate;
                if (latestTimeEl) latestTimeEl.textContent = visitTime;
                if (latestLocEl) latestLocEl.textContent = visitLocation;
                if (latestEmpEl) latestEmpEl.textContent = employee || '—';
                if (latestOutcomeEl) latestOutcomeEl.innerHTML = badgeHtml;
                if (latestConvEl) latestConvEl.textContent = conversation || '—';
                if (latestRemarksEl) latestRemarksEl.textContent = remarks || '—';

                // Hide empty state and show summary / history sections
                var emptyState = document.getElementById('visitEmptyState');
                if (emptyState) emptyState.style.display = 'none';

                var summaryBox = document.getElementById('visitLatestSummaryBox');
                if (summaryBox) summaryBox.style.display = 'block';

                var historySection = document.getElementById('visitHistorySection');
                if (historySection) historySection.style.display = 'block';

                // Prepend new row to visit history table in Visit tab
                var tbody = document.getElementById('visitHistoryTbody');
                if (tbody) {
                    var tr = document.createElement('tr');
                    tr.innerHTML =
                        '<td>' + escapeHtml(visitDate) + '</td>' +
                        '<td>' + escapeHtml(visitTime) + '</td>' +
                        '<td style="max-width:220px;">' + escapeHtml(visitLocation) + '</td>' +
                        '<td>' + escapeHtml(employee || '—') + '</td>' +
                        '<td style="max-width:260px;">' + escapeHtml(conversation || '—') + '</td>' +
                        '<td>' + badgeHtml + '</td>' +
                        '<td style="max-width:220px;">' + escapeHtml(remarks || '—') + '</td>';
                    tbody.insertBefore(tr, tbody.firstChild);
                }

                // Show success alert
                var successAlert = document.getElementById('visitSuccessAlert');
                var successMsg = document.getElementById('visitSuccessMsg');
                if (successAlert) {
                    if (successMsg) successMsg.textContent = 'Visit detail saved successfully!';
                    successAlert.style.display = 'flex';
                    setTimeout(function () {
                        successAlert.style.display = 'none';
                    }, 4000);
                }
            } catch (err) {
                console.error('Save visit error:', err);
                if (errBanner) {
                    errBanner.textContent = 'Network error: ' + (err.message || 'Could not connect to server.');
                    errBanner.style.display = 'flex';
                }
            } finally {
                if (btn) btn.disabled = false;
                if (btnLabel) btnLabel.textContent = 'Save Visit';
            }
        }

        window.openAddVisitModal = openAddVisitModal;
        window.handleSaveVisit = handleSaveVisit;
    </script>
}

@functions {
    string StatusBadge(string? status)
    {
        var s = status ?? "New";
        var cls = s.ToLower().Replace(" ", "") switch
        {
            "new" => "st-new",
            "contacted" => "st-contacted",
            "qualified" => "st-qualified",
            "proposalsent" => "st-proposalsent",
            "negotiation" => "st-negotiation",
            "won" => "st-won",
            "lost" => "st-lost",
            _ => "st-new"
        };
        return $"<span class='badge-status {cls}'>{s}</span>";
    }

    string CallStatusBadge(string? status)
    {
        var s = string.IsNullOrWhiteSpace(status) ? "Connected" : status;
        var isConnected = s.Equals("Connected", StringComparison.OrdinalIgnoreCase);
        var cls = isConnected ? "st-won" : "st-lost";
        return $"<span class='badge-status {cls}'>{s}</span>";
    }

    string FollowUpStatusBadge(string? status)
    {
        var s = status ?? "Pending";
        var cls = s switch { "Completed" => "st-won", "Rescheduled" => "st-proposalsent", _ => "st-new" };
        return $"<span class='badge-status {cls}'>{s}</span>";
    }

    string VisitOutcomeBadge(string? outcome)
    {
        var s = string.IsNullOrWhiteSpace(outcome) ? "Interested" : outcome;
        var cls = s switch
        {
            "Interested" => "st-qualified",
            "Deal Closed" => "st-won",
            "Not Interested" => "st-lost",
            _ => "st-proposalsent"
        };
        return $"<span class='badge-status {cls}'>{s}</span>";
    }

    string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "—";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}{parts[1][0]}" : name.Substring(0, Math.Min(2, name.Length));
    }
}

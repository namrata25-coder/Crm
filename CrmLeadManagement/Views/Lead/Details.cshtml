            <div class="info-item"><div class="lbl">FOLLOW-UP DATE</div><div class="val muted">@lead.FollowUpDate</div></div>
            <div class="info-item"><div class="lbl">REMARKS</div><div class="val muted">@lead.Remarks</div></div>

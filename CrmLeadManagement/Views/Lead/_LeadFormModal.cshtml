<!-- ============ ADD / EDIT LEAD MODAL (shared) ============ -->
<div class="modal-backdrop-custom" id="addLeadModal">
    <div class="modal-box modal-lg">
        <div class="modal-box-head">
            <div>
                <h3 id="leadModalTitle"><i class="bi bi-person-plus-fill" style="color:var(--brand-600);"></i> Add New Lead</h3>
                <p id="leadModalSubtitle">Capture full lead details to add them to your pipeline</p>
            </div>
            <button class="modal-close" type="button" onclick="closeModal('addLeadModal')">&times;</button>
        </div>
        <div class="modal-box-body">
            <form id="leadForm" method="post" asp-controller="Lead" asp-action="Save">
                <input type="hidden" name="Input.LeadId" value="" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />

                <div class="section-title">Contact Details</div>
                <div class="form-grid">
                    <div class="form-field"><label>Lead Name <span class="req">*</span></label><input type="text" name="Input.LeadName" required placeholder="Full name" /></div>
                    <div class="form-field"><label>Company Name <span class="req">*</span></label><input type="text" name="Input.CompanyName" required placeholder="Company name" /></div>
                    <div class="form-field"><label>Mobile Number <span class="req">*</span></label><input type="tel" name="Input.MobileNumber" required placeholder="+91 98765 43210" /></div>
                    <div class="form-field"><label>Email <span class="req">*</span></label><input type="email" name="Input.Email" required placeholder="name@company.com" /></div>
                    <div class="form-field"><label>Designation</label><input type="text" name="Input.Designation" placeholder="e.g., Procurement Manager" /></div>
                    <div class="form-field"><label>Location</label><input type="text" name="Input.Location" placeholder="City, State" /></div>
                </div>

                <div class="divider-line"></div>

                <div class="section-title">Lead Classification</div>
                <div class="form-grid">
                    <div class="form-field">
                        <label>Source <span class="req">*</span></label>
                        <select name="Input.Source">
                            @foreach (var s in LookupData.Sources)
                            {
                                <option value="@s">@s</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label>Status <span class="req">*</span></label>
                        <select name="Input.LeadStatus">
                            @foreach (var s in LookupData.Statuses)
                            {
                                <option value="@s">@s</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label>Assigned To <span class="req">*</span></label>
                        <select name="Input.AssignedTo">
                            @foreach (var e in LookupData.Employees)
                            {
                                <option value="@e">@e</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label>Priority <span class="req">*</span></label>
                        <select name="Input.Priority">
                            @foreach (var p in LookupData.Priorities)
                            {
                                <option value="@p">@p</option>
                            }
                        </select>
                    </div>
                    <div class="form-field"><label>Follow-up Date</label><input type="date" name="Input.FollowUpDate" /></div>
                    <div class="form-field"></div>
                    <div class="form-field full"><label>Remarks</label><textarea name="Input.Remarks" placeholder="Any additional context about this lead..."></textarea></div>
                </div>

                <div class="form-actions">
                    <button type="button" class="btn btn-outline" onclick="closeModal('addLeadModal')">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> <span id="leadSaveBtnLabel">Save Lead</span></button>
                </div>
            </form>
        </div>
    </div>
</div>

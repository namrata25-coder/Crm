}
.extra-action-chip input:checked ~ .custom-check-box::after {
    width: 4px;
    height: 8px;
    border-width: 0 1.8px 1.8px 0;
}
.extra-action-chip.active {
    background: #eff6ff;
    border-color: #93c5fd;
    color: #1d4ed8;
}

/* Footer / Data Access Bar */
.roles-footer-bar {
    padding: 20px;
    background: #fafbfc;
    border-top: 1px solid var(--line);
    display: flex;

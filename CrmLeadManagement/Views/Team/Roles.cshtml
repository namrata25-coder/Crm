}

/* Toast Container */
.toast-container-custom {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 1050;
    display: flex;
    flex-direction: column;
    gap: 10px;
}
.toast-item {
    min-width: 300px;
    max-width: 420px;
    background: #fff;
    border-radius: 8px;
    padding: 12px 16px;
    box-shadow: 0 4px 16px rgba(0,0,0,.15);
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13.5px;
    font-weight: 600;
    border-left: 4px solid var(--brand-600);
    animation: toastIn .2s ease-out;
    transition: opacity .3s ease;
}
.toast-item.success { border-left-color: #10b981; }
.toast-item.error { border-left-color: #ef4444; }
@@keyframes toastIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
}
</style>

<script>
// State management
let currentRole = "@Html.Raw(selected.RoleName)";
let isSystemRole = @(selected.IsSystem ? "true" : "false");
let originalState = null;
let hasUnsavedChanges = false;

document.addEventListener("DOMContentLoaded", function() {
    captureOriginalState();
    updateAllRowChecks();
});

function captureOriginalState() {
    const permissions = collectCurrentPermissions();
    const dataAccess = document.querySelector('input[name="dataAccessScope"]:checked')?.value || "OnlyAssigned";
    originalState = JSON.stringify({ permissions, dataAccess });
    setUnsavedFlag(false);
}

function setUnsavedFlag(hasChanges) {
    hasUnsavedChanges = hasChanges;
    const badge = document.getElementById("unsavedChangesBadge");
    if (badge) badge.style.display = hasChanges ? "inline-flex" : "none";
}

function onPermCheckChange(elem) {
    const row = elem.closest("tr.module-row");
    updateRowAllState(row);
    setUnsavedFlag(true);
}

function onExtraCheckChange(elem) {
    const chip = elem.closest(".extra-action-chip");
    if (chip) {
        if (elem.checked) chip.classList.add("active");
        else chip.classList.remove("active");
    }
    const row = elem.closest("tr.module-row");
    updateRowAllState(row);
    setUnsavedFlag(true);
}

function toggleRowAll(allElem) {
    const row = allElem.closest("tr.module-row");
    const isChecked = allElem.checked;

    row.querySelectorAll(".perm-check").forEach(cb => {
        cb.checked = isChecked;
        if (cb.classList.contains("perm-extra")) {
            const chip = cb.closest(".extra-action-chip");
            if (chip) {
                if (isChecked) chip.classList.add("active");
                else chip.classList.remove("active");
            }
        }
    });

    setUnsavedFlag(true);
}

function updateRowAllState(row) {
    const allCheck = row.querySelector(".row-all-check");
    if (!allCheck) return;

    const checks = row.querySelectorAll(".perm-check");
    if (checks.length === 0) return;

    const allChecked = Array.from(checks).every(c => c.checked);
    allCheck.checked = allChecked;
}

function updateAllRowChecks() {
    document.querySelectorAll("tr.module-row").forEach(row => updateRowAllState(row));
}

function toggleColumnPerm(type) {
    const checks = document.querySelectorAll(`.perm-check.perm-${type}`);
    if (checks.length === 0) return;

    const anyUnchecked = Array.from(checks).some(c => !c.checked);
    checks.forEach(c => {
        c.checked = anyUnchecked;
    });

    updateAllRowChecks();
    setUnsavedFlag(true);
    showToast(`Toggled all '${type}' permissions.`, "info");
}

function bulkSetAll(checked) {
    document.querySelectorAll(".perm-check").forEach(cb => {
        cb.checked = checked;
        if (cb.classList.contains("perm-extra")) {
            const chip = cb.closest(".extra-action-chip");
            if (chip) {
                if (checked) chip.classList.add("active");
                else chip.classList.remove("active");
            }
        }
    });
    updateAllRowChecks();
    setUnsavedFlag(true);
    showToast(checked ? "Granted all permissions." : "Cleared all permissions.", "info");
}

function onDataAccessChange(elem) {
    document.querySelectorAll(".radio-card").forEach(c => c.classList.remove("selected"));
    elem.closest(".radio-card").classList.add("selected");
    setUnsavedFlag(true);
}

function filterMatrixTable() {
    const term = document.getElementById("moduleSearchInput").value.toLowerCase().trim();
    const rows = document.querySelectorAll("tr.module-row");
    const sections = document.querySelectorAll("tr.section-header-row");

    const sectionVisibleMap = {};

    rows.forEach(r => {
        const mod = (r.getAttribute("data-module") || "").toLowerCase();
        const sec = r.getAttribute("data-section");
        const visible = term === "" || mod.includes(term) || sec.toLowerCase().includes(term);

        r.style.display = visible ? "" : "none";
        if (visible) {
            sectionVisibleMap[sec] = true;
        }
    });

    sections.forEach(s => {
        const secName = s.getAttribute("data-section");
        s.style.display = sectionVisibleMap[secName] ? "" : "none";
    });
}

function collectCurrentPermissions() {
    const items = [];
    document.querySelectorAll("tr.module-row").forEach(row => {
        const section = row.getAttribute("data-section");
        const module = row.getAttribute("data-module");

        const viewCb = row.querySelector(".perm-view");
        const createCb = row.querySelector(".perm-create");
        const editCb = row.querySelector(".perm-edit");
        const deleteCb = row.querySelector(".perm-delete");
        const extraCb = row.querySelector(".perm-extra");

        items.push({
            Section: section,
            Module: module,
            HasView: viewCb !== null,
            View: viewCb ? viewCb.checked : false,
            HasCreate: createCb !== null,
            Create: createCb ? createCb.checked : false,
            HasEdit: editCb !== null,
            Edit: editCb ? editCb.checked : false,
            HasDelete: deleteCb !== null,
            Delete: deleteCb ? deleteCb.checked : false,
            ExtraName: extraCb ? extraCb.getAttribute("data-extra-name") : null,
            Extra: extraCb ? extraCb.checked : false
        });
    });
    return items;
}

// Switching roles
async function onRoleChange(roleName) {
    if (hasUnsavedChanges) {
        if (!confirm(`You have unsaved changes on '${currentRole}'. Discard and switch to '${roleName}'?`)) {
            document.getElementById("roleSelector").value = currentRole;
            return;
        }
    }

    try {
        const res = await fetch(`/Team/GetRoleData?roleName=${encodeURIComponent(roleName)}`);
        const data = await res.json();
        if (!data.success) {
            showToast(data.message || "Could not load role.", "error");
            return;
        }

        currentRole = data.roleName;
        isSystemRole = data.isSystem;

        document.getElementById("currentRoleBadge").textContent = data.roleName;
        document.getElementById("roleUsersCountText").textContent = `${data.assignedUsersCount} ${data.assignedUsersCount === 1 ? "Member" : "Members"}`;

        const sysTag = document.getElementById("systemRoleTag");
        if (sysTag) sysTag.style.display = data.isSystem ? "inline-flex" : "none";

        const btnDel = document.getElementById("btnDeleteRole");
        if (btnDel) btnDel.style.display = data.isSystem ? "none" : "inline-flex";

        // Update data access radio
        const targetRadio = document.querySelector(`input[name="dataAccessScope"][value="${data.dataAccess}"]`);
        if (targetRadio) {
            targetRadio.checked = true;
            document.querySelectorAll(".radio-card").forEach(c => c.classList.remove("selected"));
            targetRadio.closest(".radio-card").classList.add("selected");
        }

        // Apply permissions to matrix rows
        const permDict = {};
        (data.permissions || []).forEach(p => { permDict[p.Module] = p; });

        document.querySelectorAll("tr.module-row").forEach(row => {
            const modName = row.getAttribute("data-module");
            const p = permDict[modName];
            if (!p) return;

            const v = row.querySelector(".perm-view"); if (v) v.checked = p.View;
            const c = row.querySelector(".perm-create"); if (c) c.checked = p.Create;
            const e = row.querySelector(".perm-edit"); if (e) e.checked = p.Edit;
            const d = row.querySelector(".perm-delete"); if (d) d.checked = p.Delete;
            const ex = row.querySelector(".perm-extra");
            if (ex) {
                ex.checked = p.Extra;
                const chip = ex.closest(".extra-action-chip");
                if (chip) {
                    if (p.Extra) chip.classList.add("active");
                    else chip.classList.remove("active");
                }
            }
        });

        updateAllRowChecks();
        captureOriginalState();

        // Update browser URL without reload
        const newUrl = `${window.location.pathname}?role=${encodeURIComponent(currentRole)}`;
        window.history.replaceState({ role: currentRole }, "", newUrl);

        showToast(`Loaded permissions for '${currentRole}'.`, "success");
    } catch (err) {
        showToast("Error switching role.", "error");
    }
}

// Save permissions
async function savePermissions() {
    const btn = document.getElementById("btnSave");
    const originalHtml = btn.innerHTML;
    btn.innerHTML = `<span class="spinner-border spinner-border-sm" role="status"></span> Saving...`;
    btn.disabled = true;

    const permissions = collectCurrentPermissions();
    const dataAccess = document.querySelector('input[name="dataAccessScope"]:checked')?.value || "OnlyAssigned";

    const payload = {
        RoleName: currentRole,
        DataAccess: dataAccess,
        Permissions: permissions
    };

    try {
        const res = await fetch("/Team/SavePermissions", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
            captureOriginalState();
            showToast(data.message || "Permissions saved successfully!", "success");
        } else {
            showToast(data.message || "Failed to save permissions.", "error");
        }
    } catch (err) {
        showToast("Error saving permissions to server.", "error");
    } finally {
        btn.innerHTML = originalHtml;
        btn.disabled = false;
    }
}

// Reset permissions
async function resetPermissions() {
    if (!confirm(`Reset all permissions for '${currentRole}' to original saved defaults?`)) {
        return;
    }

    try {
        const res = await fetch(`/Team/ResetRole?roleName=${encodeURIComponent(currentRole)}`, {
            method: "POST"
        });
        const data = await res.json();
        if (data.success) {
            await onRoleChange(currentRole);
            showToast(data.message || "Permissions reset.", "success");
        } else {
            showToast(data.message || "Reset failed.", "error");
        }
    } catch (err) {
        showToast("Error resetting permissions.", "error");
    }
}

// Modal handling
function openModal(id) {
    const el = document.getElementById(id);
    if (el) el.style.display = "flex";
}
function closeModal(id) {
    const el = document.getElementById(id);
    if (el) el.style.display = "none";
}

function openNewRoleModal() {
    document.getElementById("newRoleName").value = "";
    document.getElementById("newRoleDesc").value = "";
    document.getElementById("newRoleCopyFrom").value = currentRole;
    openModal("modalNewRole");
}

async function submitNewRole(e) {
    e.preventDefault();
    const roleName = document.getElementById("newRoleName").value.trim();
    const description = document.getElementById("newRoleDesc").value.trim();
    const copyFrom = document.getElementById("newRoleCopyFrom").value;
    const dataAccess = document.getElementById("newRoleDataAccess").value;

    if (!roleName) return;

    try {
        const res = await fetch("/Team/CreateRole", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ RoleName: roleName, Description: description, CopyFromRole: copyFrom, DataAccess: dataAccess })
        });
        const data = await res.json();
        if (data.success) {
            closeModal("modalNewRole");
            showToast(data.message, "success");

            // Add new role to dropdown
            const sel = document.getElementById("roleSelector");
            const opt = document.createElement("option");
            opt.value = roleName;
            opt.textContent = roleName;
            sel.appendChild(opt);
            sel.value = roleName;

            onRoleChange(roleName);
        } else {
            alert(data.message || "Could not create role.");
        }
    } catch (err) {
        alert("Error creating role.");
    }
}

function openRenameRoleModal() {
    document.getElementById("renameRoleCurrent").value = currentRole;
    document.getElementById("renameRoleNew").value = currentRole;
    openModal("modalRenameRole");
}

async function submitRenameRole(e) {
    e.preventDefault();
    const newName = document.getElementById("renameRoleNew").value.trim();
    if (!newName || newName === currentRole) return;

    try {
        const res = await fetch("/Team/RenameRole", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ OldRoleName: currentRole, NewRoleName: newName })
        });
        const data = await res.json();
        if (data.success) {
            closeModal("modalRenameRole");
            showToast(data.message, "success");

            // Update dropdown option
            const sel = document.getElementById("roleSelector");
            for (let opt of sel.options) {
                if (opt.value === currentRole) {
                    opt.value = newName;
                    opt.textContent = newName;
                    break;
                }
            }
            currentRole = newName;
            document.getElementById("currentRoleBadge").textContent = newName;
            const newUrl = `${window.location.pathname}?role=${encodeURIComponent(newName)}`;
            window.history.replaceState({ role: newName }, "", newUrl);
        } else {
            alert(data.message || "Rename failed.");
        }
    } catch (err) {
        alert("Error renaming role.");
    }
}

async function openDeleteRoleModal() {
    if (isSystemRole || currentRole.toLowerCase() === "admin") {
        alert("System roles cannot be deleted.");
        return;
    }

    document.getElementById("deleteRoleNamePrompt").textContent = currentRole;

    try {
        const res = await fetch(`/Team/GetRoleData?roleName=${encodeURIComponent(currentRole)}`);
        const data = await res.json();
        const assignedCount = data.assignedUsersCount || 0;

        const reassignSec = document.getElementById("deleteReassignSection");
        const countTxt = document.getElementById("deleteAssignedCountText");
        const reassignSel = document.getElementById("deleteReassignToRole");

        // Filter out current role from target
        Array.from(reassignSel.options).forEach(opt => {
            opt.style.display = opt.value === currentRole ? "none" : "";
        });

        if (assignedCount > 0) {
            countTxt.textContent = assignedCount;
            reassignSec.style.display = "block";
        } else {
            reassignSec.style.display = "none";
        }

        openModal("modalDeleteRole");
    } catch (err) {
        openModal("modalDeleteRole");
    }
}

async function submitDeleteRole(e) {
    e.preventDefault();
    const reassignTo = document.getElementById("deleteReassignToRole")?.value || "";

    try {
        const res = await fetch("/Team/DeleteRole", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ RoleName: currentRole, ReassignToRole: reassignTo })
        });
        const data = await res.json();
        if (data.success) {
            closeModal("modalDeleteRole");
            showToast(data.message, "success");

            // Reload page on default role
            window.location.href = "/Team/Roles";
        } else {
            alert(data.message || "Failed to delete role.");
        }
    } catch (err) {
        alert("Error deleting role.");
    }
}

function showToast(message, type = "success") {
    const container = document.getElementById("toastContainer");
    if (!container) return;

    const toast = document.createElement("div");
    toast.className = `toast-item ${type}`;

    let icon = "bi-check-circle-fill text-success";
    if (type === "error") icon = "bi-x-circle-fill text-danger";
    if (type === "info") icon = "bi-info-circle-fill text-primary";

    toast.innerHTML = `<i class="bi ${icon}" style="font-size:18px;"></i> <span>${message}</span>`;
    container.appendChild(toast);

    setTimeout(() => {
        toast.style.opacity = "0";
        setTimeout(() => toast.remove(), 300);
    }, 3500);
}
</script>

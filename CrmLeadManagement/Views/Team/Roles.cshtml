    transition: border-color .15s ease;
}
.form-input-custom:focus {
    border-color: var(--brand-600);
    box-shadow: 0 0 0 3px rgba(37,99,168,.12);
}
.alert-info-box {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 10px 12px;
    background: #f0fdf4;

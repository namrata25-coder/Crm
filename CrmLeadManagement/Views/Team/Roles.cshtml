    background: #fff;
    border: 1.5px solid var(--ink-300);
    border-radius: 8px;
    cursor: pointer;
    transition: all .15s ease;
    user-select: none;
    max-width: 380px;
}
.radio-card:hover {
    border-color: var(--brand-500);

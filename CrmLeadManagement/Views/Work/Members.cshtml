</style>

@section Scripts {
<script src="~/js/project/work-api.js"></script>
<script>
    function filterMembersTable() {
        const query = (document.getElementById('memberSearchInput').value || '').toLowerCase().trim();
        const role = (document.getElementById('roleFilterSelect').value || '').toLowerCase().trim();
        const status = (document.getElementById('statusFilterSelect').value || '').toLowerCase().trim();

        const rows = document.querySelectorAll('#memberTable tbody tr.member-row');
        let visibleCount = 0;

        rows.forEach(row => {
            const rName = row.getAttribute('data-name') || '';
            const rEmail = row.getAttribute('data-email') || '';
            const rRole = row.getAttribute('data-role') || '';
            const rStatus = (row.getAttribute('data-status') || '').toLowerCase();

            const matchesQuery = !query || rName.includes(query) || rEmail.includes(query) || rRole.includes(query);
            const matchesRole = !role || rRole === role;
            const matchesStatus = !status || rStatus === status;

            if (matchesQuery && matchesRole && matchesStatus) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        const noMatch = document.getElementById('noMatchMessage');
        if (noMatch) {
            noMatch.style.display = (visibleCount === 0 && rows.length > 0) ? 'block' : 'none';
        }
    }

    function openCreateMemberModal() {
        document.getElementById('memberModalTitle').innerHTML = '<i class="bi bi-person-plus-fill" style="color:var(--brand-600);"></i> Add Team Member';
        document.getElementById('memberId').value = '0';
        document.getElementById('memberName').value = '';
        document.getElementById('memberEmail').value = '';
        document.getElementById('memberRole').value = '';
        document.getElementById('memberStatus').value = 'Active';
        document.getElementById('saveMemberBtn').innerHTML = '<i class="bi bi-check-lg"></i> Save Member';
        document.getElementById('memberModalBackdrop').style.display = 'flex';
        setTimeout(() => document.getElementById('memberName').focus(), 50);
    }

    function openEditMemberModal(id, name, email, role, status) {
        document.getElementById('memberModalTitle').innerHTML = '<i class="bi bi-pencil-square" style="color:var(--brand-600);"></i> Edit Member Details';
        document.getElementById('memberId').value = id;
        document.getElementById('memberName').value = name;
        document.getElementById('memberEmail').value = email;
        document.getElementById('memberRole').value = role;
        document.getElementById('memberStatus').value = status || 'Active';
        document.getElementById('saveMemberBtn').innerHTML = '<i class="bi bi-check-lg"></i> Update Member';
        document.getElementById('memberModalBackdrop').style.display = 'flex';
        setTimeout(() => document.getElementById('memberName').focus(), 50);
    }

    function closeMemberModal(event) {
        if (event && event.target !== document.getElementById('memberModalBackdrop')) return;
        document.getElementById('memberModalBackdrop').style.display = 'none';
    }

    function showMemberWorkModal(id, name, role, projectsCount, tasksCount, completedCount, pendingCount) {
        document.getElementById('workModalMemberName').innerHTML = '<i class="bi bi-person-badge" style="color:var(--brand-600);"></i> ' + name;
        document.getElementById('workModalMemberRole').innerText = role || 'Team Member';
        document.getElementById('workModalProjectsCount').innerText = projectsCount;
        document.getElementById('workModalTasksCount').innerText = tasksCount;
        document.getElementById('workModalCompletedCount').innerText = completedCount;
        document.getElementById('memberWorkModalBackdrop').style.display = 'flex';
    }

    function closeMemberWorkModal(event) {
        if (event && event.target !== document.getElementById('memberWorkModalBackdrop')) return;
        document.getElementById('memberWorkModalBackdrop').style.display = 'none';
    }

    function confirmDeleteMember(id, name) {
        if (confirm(`Are you sure you want to remove member "${name}"?`)) {
            document.getElementById('deleteMemberId').value = id;
            document.getElementById('deleteMemberForm').submit();
        }
    }

    // Close modals on Escape key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            const memberModal = document.getElementById('memberModalBackdrop');
            const workModal = document.getElementById('memberWorkModalBackdrop');
            if (memberModal && memberModal.style.display === 'flex') memberModal.style.display = 'none';
            if (workModal && workModal.style.display === 'flex') workModal.style.display = 'none';
        }
    });

    // ─────────────────────────────────────────────────────────────────────────
    //  USER SETUP (MODULE PERMISSIONS) SCRIPT LOGIC
    // ─────────────────────────────────────────────────────────────────────────
    var memberPermissionsMap = {
@foreach (var m in Model.Members)
{
    @: '@Html.Raw(m.Name?.Replace("'", "\\'"))': '@Html.Raw(m.ModulePermissions?.Replace("'", "\\'"))',
}
    };

    function onUserQuickSelectChange(userName) {
        if (!userName) return;
        document.getElementById('setupUserName').value = userName;
        loadPermissionsForUser(userName);
    }

    function onUserNameInputChange() {
        var val = document.getElementById('setupUserName').value.trim();
        var select = document.getElementById('userQuickSelect');
        if (select) select.value = val;
        loadPermissionsForUser(val);
    }

    function loadPermissionsForUser(userName) {
        var perms = memberPermissionsMap[userName];
        var checkboxes = document.querySelectorAll('.setup-module-checkbox');
        if (perms !== undefined && perms !== null) {
            if (perms.trim() === '') {
                checkboxes.forEach(cb => cb.checked = true);
            } else {
                var allowed = perms.split(',').map(s => s.trim().toLowerCase());
                checkboxes.forEach(cb => {
                    cb.checked = allowed.includes(cb.value.toLowerCase());
                });
            }
        } else {
            checkboxes.forEach(cb => cb.checked = true);
        }
    }

    function setAllModuleCheckboxes(checked) {
        document.querySelectorAll('.setup-module-checkbox').forEach(cb => cb.checked = checked);
    }

    function selectUserInSetup(userName) {
        document.getElementById('setupUserName').value = userName;
        var select = document.getElementById('userQuickSelect');
        if (select) select.value = userName;
        loadPermissionsForUser(userName);
        var card = document.getElementById('userSetupCard');
        if (card) {
            card.scrollIntoView({ behavior: 'smooth' });
        }
    }
</script>
}

        Notes: document.getElementById('gmsNotes').value.trim()
    };

    const saveBtn = document.getElementById('saveMilestoneBtn');
    if (saveBtn) saveBtn.disabled = true;

    try {
        if (isEdit) {
            await MilestoneApi.update(id, payload);
            showToast('Milestone updated successfully');
        } else {
            await MilestoneApi.create(payload);
            showToast('Milestone created successfully');
        }
        closeModal('globalMilestoneModal');
        await loadMilestonesData();
    } catch (err) {
        showToast(`Error saving milestone: ${err.message}`, true);
    } finally {
        if (saveBtn) saveBtn.disabled = false;
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// Delete Milestone (MilestoneApi.delete)
// ─────────────────────────────────────────────────────────────────────────────
async function handleDeleteMilestone(id, name) {
    if (!confirm(`Are you sure you want to delete milestone "${name}"?`)) {
        return;
    }

    try {
        await MilestoneApi.delete(id);
        showToast('Milestone deleted successfully');
        await loadMilestonesData();
    } catch (err) {
        showToast(`Error deleting milestone: ${err.message}`, true);
    }
}

let currentSelectedProjectBudget = 0;

function getGlobalSelectedProjectBudget() {
    if (currentSelectedProjectBudget > 0) return currentSelectedProjectBudget;
    const projId = parseInt(document.getElementById('gmsProjectId').value, 10);
    if (!projId) return 0;
    const p = projectsList.find(x => (x.Id !== undefined ? x.Id : x.id) === projId);
    return p ? Number(p.Budget || p.budget || 0) : 0;
}

function calculateGlobalMilestoneAmount() {
    const budget = getGlobalSelectedProjectBudget();
    const pct = parseFloat(document.getElementById('gmsPercentage').value) || 0;
    const amount = (budget * pct) / 100;
    const hiddenInput = document.getElementById('gmsAmount');
    const displayInput = document.getElementById('gmsAmountDisplay');
    if (hiddenInput) hiddenInput.value = amount;
    if (displayInput) {
        displayInput.value = amount > 0 
            ? '₹' + Number(amount).toLocaleString('en-IN', { maximumFractionDigits: 0 }) 
            : '₹0';
    }
}

function openCreateMilestoneModal() {
    document.getElementById('gmsId').value = 0;
    setSelectValue('gmsProjectId', '');
    document.getElementById('gmsName').value = '';
    document.getElementById('gmsDesc').value = '';
    document.getElementById('gmsStart').value = new Date().toISOString().split('T')[0];
    document.getElementById('gmsDue').value = '';
    setSelectValue('gmsPercentage', '');
    document.getElementById('gmsAmount').value = 0;
    document.getElementById('gmsCompleted').value = 0;
    document.getElementById('gmsAmountDisplay').value = '₹0';
    document.getElementById('gmsMembers').value = '';
    setSelectValue('gmsPriority', 'Medium');
    setSelectValue('gmsStatus', 'Pending');
    document.getElementById('gmsNotes').value = '';
    document.getElementById('globalMsTitle').textContent = 'Create Milestone';
    document.getElementById('globalMsSub').textContent = 'Auto-generates complete Project Details & strict sequential Dependency Type';
    
    currentSelectedProjectBudget = 0;

    // Reset auto-generated panel
    const panel = document.getElementById('gmsProjectDetailsPanel');
    if (panel) panel.style.display = 'none';
    const badge = document.getElementById('gmsProjectBadge');
    if (badge) badge.style.display = 'none';

    // If there is only 1 project in list, auto-select it immediately
    if (projectsList.length === 1) {
        const pId = projectsList[0].Id !== undefined ? projectsList[0].Id : projectsList[0].id;
        setSelectValue('gmsProjectId', pId.toString());
        handleMilestoneProjectSelection(pId, false);
    }

    openModal('globalMilestoneModal');
}

async function openEditMilestoneById(id) {
    const m = milestonesData.find(x => (x.Id !== undefined ? x.Id : x.id) === id);
    if (!m) {
        console.warn('Milestone not found with ID:', id);
        return;
    }

    const projId = m.ProjectId !== undefined ? m.ProjectId : m.projectId;
    const mAmount = m.Amount !== undefined ? m.Amount : (m.amount || 0);
    const mCompleted = m.CompletedAmount !== undefined ? m.CompletedAmount : (m.completedAmount || 0);

    document.getElementById('gmsId').value = id;
    setSelectValue('gmsProjectId', projId.toString());
    document.getElementById('gmsName').value = m.MilestoneName || m.milestoneName || '';
    document.getElementById('gmsDesc').value = m.Description || m.description || '';
    document.getElementById('gmsStart').value = m.StartDate || m.startDate || '';
    document.getElementById('gmsDue').value = m.DueDate || m.dueDate || '';
    document.getElementById('gmsAmount').value = mAmount;
    document.getElementById('gmsCompleted').value = mCompleted;
    document.getElementById('gmsAmountDisplay').value = mAmount > 0 ? '₹' + Number(mAmount).toLocaleString('en-IN', { maximumFractionDigits: 0 }) : '₹0';
    document.getElementById('gmsMembers').value = m.AssignedMembers || m.assignedMembers || '';
    setSelectValue('gmsPriority', m.Priority || m.priority || 'Medium');
    setSelectValue('gmsStatus', m.Status || m.status || 'Pending');
    document.getElementById('gmsNotes').value = m.Notes || m.notes || '';
    document.getElementById('globalMsTitle').textContent = `Edit Milestone (${m.MilestoneCode || m.milestoneCode || ''})`;

    // Trigger auto-generated project and dependency metadata
    await handleMilestoneProjectSelection(projId, true, id);

    const pBudget = getGlobalSelectedProjectBudget();
    let matchedPct = '';
    if (pBudget > 0 && mAmount > 0) {
        const calculatedPct = Math.round((mAmount / pBudget) * 100);
        if ([10, 20, 30, 40, 50, 60, 70, 80, 90].includes(calculatedPct)) {
            matchedPct = calculatedPct.toString();
        }
    }
    setSelectValue('gmsPercentage', matchedPct);
    if (matchedPct) {
        calculateGlobalMilestoneAmount();
    }

    openModal('globalMilestoneModal');
}

function setSelectValue(id, val) {
    var sel = document.getElementById(id);
    if (!sel) return;
    for (var i = 0; i < sel.options.length; i++) {
        if (sel.options[i].value === val) { sel.selectedIndex = i; return; }
    }
    if (sel.options.length > 0) sel.selectedIndex = 0;
}

function filterMilestonesTable() {
    var query = (document.getElementById('milestoneSearchInput')?.value || '').toLowerCase();
    var rows = document.querySelectorAll('#milestonesTable tbody tr');
    rows.forEach(function(row) {
        var text = row.textContent.toLowerCase();
        row.style.display = text.indexOf(query) > -1 ? '' : 'none';
    });
}

document.addEventListener('DOMContentLoaded', function() {
    loadMilestonesData();
});
</script>
}

function filterProjectInvoiceTable() {
    const search = (document.getElementById('projectInvoiceSearchInput')?.value || '').trim().toLowerCase();
    const status = document.getElementById('projectInvoiceStatusFilter')?.value || 'All';
    const rows = document.querySelectorAll('.project-inv-row');
    let visible = 0;

    rows.forEach(r => {
        const rStatus = r.getAttribute('data-status') || '';
        const rNumber = (r.getAttribute('data-number') || '').toLowerCase();
        const rClient = (r.getAttribute('data-client') || '').toLowerCase();
        const rMilestone = (r.getAttribute('data-milestone') || '').toLowerCase();

        let matchStatus = status === 'All' || rStatus.toLowerCase() === status.toLowerCase() || (status === 'Pending' && rStatus === 'Unpaid');
        let matchSearch = !search || rNumber.includes(search) || rClient.includes(search) || rMilestone.includes(search);

        if (matchStatus && matchSearch) {
            r.style.display = '';
            visible++;
        } else {
            r.style.display = 'none';
        }
    });

    const badge = document.getElementById('projectInvoiceCountBadge');
    if (badge) badge.textContent = `${visible} invoice${visible === 1 ? '' : 's'}`;
}


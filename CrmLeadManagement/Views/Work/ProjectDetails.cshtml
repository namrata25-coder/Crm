@functions {
    string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Length >= 2 ? parts[0].Substring(0, 2).ToUpper() : parts[0].ToUpper();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }

    string StatusBadge(string s) => s switch
    {
        "Active"    => "badge-success",
        "Completed" => "badge-info",
        "On Hold"   => "badge-warning",
        "Cancelled" => "badge-danger",
        _           => "badge-secondary"
    };

    string TypeBadge(string? t) => (t ?? "") switch
    {
        "Milestone Based Project" => "badge-purple",
        "Task Based Project"      => "badge-cyan",
        _                         => "badge-info"
    };

    string MsBadge(string? s) => (s ?? "") switch
    {
        "Completed"   => "badge-success",
        "In Progress" => "badge-info",
        "On Hold"     => "badge-warning",
        _             => "badge-secondary"
    };

    string TaskBadge(string? s) => (s ?? "") switch
    {
        "Completed"   => "badge-success",
        "In Progress" => "badge-info",
        "Cancelled"   => "badge-danger",
        "On Hold"     => "badge-warning",
        _             => "badge-secondary"
    };

    string PriorityBadge(string? p) => (p ?? "") switch
    {
        "High"   => "badge-danger",
        "Low"    => "badge-success",
        _        => "badge-warning"
    };

    string InvBadge(string? s) => (s ?? "") switch
    {
        "Paid"    => "badge-success",
        "Partial" => "badge-warning",
        _         => "badge-danger"
    };

    string BillingBadge(string? s) => (s ?? "") switch
    {
        "Billable"     => "badge-success",
        "Billed"       => "badge-info",
        "Non-Billable" => "badge-secondary",
        _              => "badge-warning"
    };

    string ExpenseBadge(string? s) => (s ?? "") switch
    {
        "Paid"     => "badge-success",
        "Approved" => "badge-info",
        "Pending"  => "badge-warning",
        "Rejected" => "badge-danger",
        _          => "badge-secondary"
    };

    string FileIconClass(string? type) => (type ?? "").ToUpperInvariant() switch
    {
        "PDF" => "type-pdf",
        "DOC" or "DOCX" => "type-doc",
        "XLS" or "XLSX" or "CSV" => "type-xls",
        "PNG" or "JPG" or "JPEG" or "SVG" or "WEBP" => "type-img",
        "ZIP" or "RAR" or "7Z" => "type-zip",
        "CS" or "JS" or "HTML" or "CSS" or "JSON" or "SQL" => "type-code",
        _ => "type-file"
    };

    string FileIconBi(string? type) => (type ?? "").ToUpperInvariant() switch
    {
        "PDF" => "bi-filetype-pdf",
        "DOC" or "DOCX" => "bi-filetype-doc",
        "XLS" or "XLSX" or "CSV" => "bi-filetype-xls",
        "PNG" or "JPG" or "JPEG" or "SVG" or "WEBP" => "bi-file-earmark-image",
        "ZIP" or "RAR" or "7Z" => "bi-file-earmark-zip",
        "CS" or "JS" or "HTML" or "CSS" or "JSON" or "SQL" => "bi-filetype-code",
        _ => "bi-file-earmark"
    };
}

@section Scripts {
<script src="~/js/project/work-api.js"></script>
<script src="~/js/project/project-api.js"></script>
<script src="~/js/project/milestone-api.js"></script>
<script src="~/js/project/task-api.js"></script>
<script>
const projectTotalBudget = @Model.Budget;

function escapeHtml(str) {
    if (!str) return '';
    return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
}

function calculateProjectMilestoneAmount() {
    const pct = parseFloat(document.getElementById('msPercentage').value) || 0;
    const amount = (projectTotalBudget * pct) / 100;
    const hiddenInput = document.getElementById('msAmount');
    const displayInput = document.getElementById('msAmountDisplay');
    if (hiddenInput) hiddenInput.value = amount;
    if (displayInput) {
        displayInput.value = amount > 0 
            ? '₹' + Number(amount).toLocaleString('en-IN', { maximumFractionDigits: 0 }) 
            : '₹0';
    }
}

async function openMilestoneModal(id, projectId, code, name, desc, start, due, amount, completed, members, priority, status, notes) {
    projectId = projectId || @Model.Id;
    document.getElementById('msId').value = id || 0;
    document.getElementById('msProjectId').value = projectId;
    document.getElementById('msName').value = name || '';
    document.getElementById('msDesc').value = desc || '';
    document.getElementById('msStart').value = start || '';
    document.getElementById('msDue').value = due || '';
    
    const numericAmount = parseFloat(amount) || 0;
    document.getElementById('msAmount').value = numericAmount;
    document.getElementById('msCompleted').value = completed || 0;
    document.getElementById('msAmountDisplay').value = numericAmount > 0 
        ? '₹' + Number(numericAmount).toLocaleString('en-IN', { maximumFractionDigits: 0 }) 
        : '₹0';
    
    let matchedPct = '';
    if (projectTotalBudget > 0 && numericAmount > 0) {
        const calculatedPct = Math.round((numericAmount / projectTotalBudget) * 100);
        if ([10, 20, 30, 40, 50, 60, 70, 80, 90].includes(calculatedPct)) {
            matchedPct = calculatedPct.toString();
        }
    }
    setSelectValue('msPercentage', matchedPct);
    if (matchedPct || !id) {
        calculateProjectMilestoneAmount();
    }

    document.getElementById('msMembers').value = members || '';
    setSelectValue('msPriority', priority || 'Medium');
    setSelectValue('msStatus', status || 'Pending');
    document.getElementById('msNotes').value = notes || '';
    document.getElementById('msModalTitle').textContent = id ? ('Edit Milestone (' + (code || '') + ')') : 'Create Milestone';
    document.getElementById('msModalSub').textContent = id ? 'Update milestone configuration and gates' : 'Define milestone details for this project';

    openModal('milestoneModal');

    // Auto-generate Complete Project Details & Strict Sequential Dependency Type
    await fetchAndRenderProjectMilestoneDependency(projectId, id || 0);
}

async function fetchAndRenderProjectMilestoneDependency(projectId, milestoneId) {
    const seqBadge = document.getElementById('pmsSequenceBadge');
    const reasonEl = document.getElementById('pmsDependencyReason');
    const depTypeEl = document.getElementById('pmsDependencyTypeText');
    const boxEl = document.getElementById('pmsDependencyBox');

    if (seqBadge) seqBadge.textContent = 'Evaluating Sequence...';
    if (reasonEl) reasonEl.textContent = 'Evaluating prerequisite milestone completion and full invoice payment...';

    try {
        const res = await fetch(`/api/milestones/project-dependency/${projectId}?milestoneId=${milestoneId || 0}`);
        if (!res.ok) throw new Error('Failed to evaluate project dependency');
        const data = await res.json();

        // Populate Project Details
        if (data.project) {
            const p = data.project;
            if (document.getElementById('pmsProjectCodeBadge')) document.getElementById('pmsProjectCodeBadge').textContent = p.projectCode || '';
            if (document.getElementById('pmsProjectNameText')) document.getElementById('pmsProjectNameText').textContent = p.projectName || '';
            if (document.getElementById('pmsClientText')) document.getElementById('pmsClientText').textContent = p.clientName ? `${p.clientName} ${p.clientCompany ? '(' + p.clientCompany + ')' : ''}` : '—';
            if (document.getElementById('pmsBudgetText')) document.getElementById('pmsBudgetText').textContent = '₹' + Number(p.budget || 0).toLocaleString('en-IN');
            if (document.getElementById('pmsManagerText')) document.getElementById('pmsManagerText').textContent = p.projectManager || 'Unassigned';
            if (document.getElementById('pmsTimelineText')) document.getElementById('pmsTimelineText').textContent = `${p.startDate || 'N/A'} → ${p.deadline || 'N/A'}`;
        }

        // Render Dependency Type & Gate Information
        if (depTypeEl) depTypeEl.textContent = data.dependencyType || 'Sequential Milestone Gate + Invoice Paid Gate';

        const evalResult = data.evaluation || {};
        if (evalResult.isLocked) {
            if (seqBadge) {
                seqBadge.className = 'badge badge-warning';
                seqBadge.innerHTML = `<i class="bi bi-lock-fill"></i> Locked (Phase #${evalResult.SequenceIndex})`;
            }
            if (boxEl) {
                boxEl.style.borderColor = '#f59e0b';
                boxEl.style.background = '#fffbeb';
            }
            if (reasonEl) {
                reasonEl.innerHTML = `<strong>Strict Sequence Gate:</strong> ${escapeHtml(evalResult.lockReason || 'Prerequisite milestone is not completed or unpaid.')}`;
            }
        } else {
            if (seqBadge) {
                seqBadge.className = 'badge badge-success';
                seqBadge.innerHTML = `<i class="bi bi-unlock-fill"></i> Ready / Phase #${evalResult.SequenceIndex}`;
            }
            if (boxEl) {
                boxEl.style.borderColor = '#10b981';
                boxEl.style.background = '#f0fdf4';
            }
            if (reasonEl) {
                if (evalResult.SequenceIndex === 1) {
                    reasonEl.innerHTML = `<i class="bi bi-check-circle-fill" style="color:#10b981;"></i> <strong>Root Phase 1:</strong> Ready to start. All future milestones will strictly depend on this phase and its invoice.`;
                } else {
                    reasonEl.innerHTML = `<i class="bi bi-check-circle-fill" style="color:#10b981;"></i> <strong>Prerequisites Met:</strong> ${escapeHtml(evalResult.prerequisiteMilestoneName || 'Previous Phase')} completed and fully paid.`;
                }
            }
        }

        // Auto-fill defaults for new milestones
        if (!milestoneId && !document.getElementById('msName').value) {
            document.getElementById('msName').value = `Phase #${evalResult.SequenceIndex || 1} Deliverable`;
        }
    } catch (err) {
        console.error('Error in fetchAndRenderProjectMilestoneDependency:', err);
    }
}

function parseTaskDependencyNotes(notes) {
    if (!notes) return { hasDep: false, depId: null, cleanNotes: '' };
    var raw = notes.trim();
    if (raw.indexOf('[NO_DEP]') !== -1) {
        return { hasDep: false, depId: null, cleanNotes: raw.replace('[NO_DEP]', '').trim() };
    }
    var match = raw.match(/\[DEP:(\d+)\]/);
    if (match) {
        return { hasDep: true, depId: parseInt(match[1], 10), cleanNotes: raw.replace(match[0], '').trim() };
    }
    return { hasDep: false, depId: null, cleanNotes: raw };
}

function handleProjectDetailsDependencyOptionToggle(option) {
    const depCheck = document.getElementById('ptOptionDependency');
    const noDepCheck = document.getElementById('ptOptionNoDependency');
    const depSection = document.getElementById('ptDependencyTaskSection');
    const depTaskSelect = document.getElementById('ptDependencyTaskId');

    if (option === 'dependency') {
        if (depCheck) depCheck.checked = true;
        if (noDepCheck) noDepCheck.checked = false;
        if (depSection) depSection.style.display = 'block';
    } else {
        if (noDepCheck) noDepCheck.checked = true;
        if (depCheck) depCheck.checked = false;
        if (depSection) depSection.style.display = 'none';
        if (depTaskSelect) depTaskSelect.value = '';
    }

    const projectId = parseInt(document.getElementById('tProjectId')?.value, 10) || @Model.Id;
    const milestoneId = parseInt(document.getElementById('tMilestoneId')?.value, 10) || 0;
    const currentTaskId = parseInt(document.getElementById('tId')?.value, 10) || 0;
    fetchAndRenderProjectTaskDependency(projectId, milestoneId, currentTaskId);
}

function handleProjectDetailsDependencyTaskSelectionChange(taskId) {
    highlightSelectedProjectDetailsDependencyCard(taskId);
    const projectId = parseInt(document.getElementById('tProjectId')?.value, 10) || @Model.Id;
    const milestoneId = parseInt(document.getElementById('tMilestoneId')?.value, 10) || 0;
    const currentTaskId = parseInt(document.getElementById('tId')?.value, 10) || 0;
    fetchAndRenderProjectTaskDependency(projectId, milestoneId, currentTaskId);
}

function selectProjectDetailsDependencyTaskFromList(taskId) {
    const sel = document.getElementById('ptDependencyTaskId');
    if (sel) {
        sel.value = taskId;
        handleProjectDetailsDependencyTaskSelectionChange(taskId);
    }
}

function highlightSelectedProjectDetailsDependencyCard(selectedTaskId) {
    const cards = document.querySelectorAll('.pt-dep-task-item');
    cards.forEach(card => {
        const id = card.getAttribute('data-task-id');
        if (String(id) === String(selectedTaskId)) {
            card.style.borderColor = 'var(--brand-600, #14b8a6)';
            card.style.background = '#f0fdf4';
        } else {
            card.style.borderColor = '#e2e8f0';
            card.style.background = '#fff';
        }
    });
}

function populateProjectDetailsExistingTasks(existingTasks, selectedDepTaskId, currentEditingId) {
    const sel = document.getElementById('ptDependencyTaskId');
    const listWrap = document.getElementById('ptExistingTasksListContent');
    const badge = document.getElementById('ptDepTaskCountBadge');

    if (!sel || !listWrap) return;

    const filtered = (existingTasks || []).filter(t => {
        const id = t.id !== undefined ? t.id : t.Id;
        return !currentEditingId || id !== currentEditingId;
    });

    if (badge) {
        badge.textContent = `${filtered.length} task${filtered.length === 1 ? '' : 's'} in project`;
    }

    // Populate Select Options
    const currentVal = selectedDepTaskId || sel.value;
    sel.innerHTML = '<option value="">-- Select Prerequisite Task in Selected Project --</option>';
    filtered.forEach(t => {
        const id = t.id !== undefined ? t.id : t.Id;
        const code = t.taskCode || t.TaskCode || '';
        const name = t.taskName || t.TaskName || '';
        const status = t.status || t.Status || 'Pending';
        const progress = t.progressPercent !== undefined ? t.progressPercent : (t.ProgressPercent || 0);
        sel.innerHTML += `<option value="${id}">${escapeHtml(code)} - ${escapeHtml(name)} (${status} - ${progress}%)</option>`;
    });
    if (currentVal) sel.value = currentVal;

    // Populate Visual Task List
    if (filtered.length === 0) {
        listWrap.innerHTML = `
            <div style="color:var(--ink-400);font-size:12px;font-style:italic;padding:8px;text-align:center;background:#f8fafc;border-radius:6px;">
                <i class="bi bi-info-circle"></i> No existing tasks in this project yet. You can select "No Dependency" for this initial task.
            </div>
        `;
        return;
    }

    let listHtml = '';
    filtered.forEach(t => {
        const id = t.id !== undefined ? t.id : t.Id;
        const code = t.taskCode || t.TaskCode || '';
        const name = t.taskName || t.TaskName || '';
        const status = t.status || t.Status || 'Pending';
        const progress = t.progressPercent !== undefined ? t.progressPercent : (t.ProgressPercent || 0);
        const member = t.assignedMember || t.AssignedMember || 'Unassigned';
        const msName = t.milestoneName || t.MilestoneName || '';
        const isSelected = String(id) === String(sel.value);
        const isCompleted = status === 'Completed' || progress >= 100;

        listHtml += `
            <div class="pt-dep-task-item" data-task-id="${id}" onclick="selectProjectDetailsDependencyTaskFromList(${id})"
                 style="display:flex;align-items:center;justify-content:space-between;padding:7px 10px;border-radius:6px;border:1px solid ${isSelected ? 'var(--brand-600, #14b8a6)' : '#e2e8f0'};background:${isSelected ? '#f0fdf4' : '#fff'};cursor:pointer;transition:all .15s ease;">
                <div style="display:flex;align-items:center;gap:8px;">
                    <span class="badge badge-code" style="font-size:11px;">${escapeHtml(code)}</span>
                    <div>
                        <div style="font-weight:600;font-size:12px;color:var(--ink-900);">${escapeHtml(name)}</div>
                        <div style="font-size:11px;color:var(--ink-500);display:flex;gap:8px;">
                            ${msName ? `<span><i class="bi bi-flag"></i> ${escapeHtml(msName)}</span>` : ''}
                            <span><i class="bi bi-person"></i> ${escapeHtml(member)}</span>
                        </div>
                    </div>
                </div>
                <div style="display:flex;align-items:center;gap:8px;">
                    <span class="badge ${isCompleted ? 'badge-success' : 'badge-secondary'}" style="font-size:10.5px;">
                        ${isCompleted ? '<i class="bi bi-check-circle-fill"></i> Completed' : escapeHtml(status)}
                    </span>
                    <button type="button" class="btn btn-sm ${isSelected ? 'btn-primary' : 'btn-outline'}" style="font-size:11px;padding:2px 8px;">
                        ${isSelected ? 'Selected' : 'Select'}
                    </button>
                </div>
            </div>
        `;
    });

    listWrap.innerHTML = listHtml;
}

function validateProjectDetailsTaskForm(e) {
    const isDep = document.getElementById('ptOptionDependency')?.checked;
    const depTaskSelect = document.getElementById('ptDependencyTaskId');
    if (isDep && depTaskSelect && depTaskSelect.options.length > 1 && !depTaskSelect.value) {
        alert('Please select a Dependency Task from the list, or choose "No Dependency".');
        depTaskSelect.focus();
        if (e && e.preventDefault) e.preventDefault();
        return false;
    }
    return true;
}

async function openAddTaskInsideMilestone(projectId, milestoneId, milestoneName) {
    projectId = projectId || @Model.Id;
    document.getElementById('tId').value = 0;
    document.getElementById('tProjectId').value = projectId;
    setSelectValue('tMilestoneId', (milestoneId || 0).toString());
    document.getElementById('tName').value = '';
    document.getElementById('tDesc').value = '';
    setSelectValue('tAssigned', '');
    document.getElementById('tStart').value = new Date().toISOString().split('T')[0];
    document.getElementById('tDue').value = '';
    document.getElementById('tAmount').value = 0;
    document.getElementById('tCompleted').value = 0;
    setSelectValue('tPriority', 'Medium');
    setSelectValue('tStatus', 'Pending');
    document.getElementById('tNotes').value = '';
    document.getElementById('tReturnTab').value = 'milestone';

    // Reset dependency to No Dependency
    const chkDep = document.getElementById('ptOptionDependency');
    const chkNoDep = document.getElementById('ptOptionNoDependency');
    if (chkDep) chkDep.checked = false;
    if (chkNoDep) chkNoDep.checked = true;

    const depSection = document.getElementById('ptDependencyTaskSection');
    if (depSection) depSection.style.display = 'none';

    const depTaskSelect = document.getElementById('ptDependencyTaskId');
    if (depTaskSelect) depTaskSelect.value = '';

    document.getElementById('taskModalTitle').textContent = 'Add Task inside ' + milestoneName;
    document.getElementById('taskModalSub').textContent = 'Create a new task with optional dependency inside ' + milestoneName;

    openModal('taskModal');

    await fetchAndRenderProjectTaskDependency(projectId, milestoneId || 0, 0);
}

async function openTaskModal(id, projectId, milestoneId, code, name, desc, assigned, start, due, amount, completed, priority, status, notes, returnTab) {
    projectId = projectId || @Model.Id;
    document.getElementById('tId').value = id || 0;
    document.getElementById('tProjectId').value = projectId;
    setSelectValue('tMilestoneId', (milestoneId || 0).toString());
    document.getElementById('tName').value = name || '';
    document.getElementById('tDesc').value = desc || '';
    setSelectValue('tAssigned', assigned || '');
    document.getElementById('tStart').value = start || new Date().toISOString().split('T')[0];
    document.getElementById('tDue').value = due || '';
    document.getElementById('tAmount').value = amount || 0;
    document.getElementById('tCompleted').value = completed || 0;
    setSelectValue('tPriority', priority || 'Medium');
    setSelectValue('tStatus', status || 'Pending');
    document.getElementById('tReturnTab').value = returnTab || 'task';
    document.getElementById('taskModalTitle').textContent = id ? ('Edit Task (' + (code || '') + ')') : 'Add Task';
    document.getElementById('taskModalSub').textContent = 'Create a new task with optional dependency and project assignment';

    // Parse and restore dependency
    const depParsed = parseTaskDependencyNotes(notes);
    document.getElementById('tNotes').value = depParsed.cleanNotes || (notes || '');

    const chkDep = document.getElementById('ptOptionDependency');
    const chkNoDep = document.getElementById('ptOptionNoDependency');
    const depSection = document.getElementById('ptDependencyTaskSection');

    if (id > 0 && depParsed.hasDep) {
        if (chkDep) chkDep.checked = true;
        if (chkNoDep) chkNoDep.checked = false;
        if (depSection) depSection.style.display = 'block';
    } else {
        if (chkDep) chkDep.checked = false;
        if (chkNoDep) chkNoDep.checked = true;
        if (depSection) depSection.style.display = 'none';
        const depTaskSelect = document.getElementById('ptDependencyTaskId');
        if (depTaskSelect) depTaskSelect.value = '';
    }

    openModal('taskModal');

    await fetchAndRenderProjectTaskDependency(projectId, milestoneId || 0, id || 0);

    if (id > 0 && depParsed.hasDep && depParsed.depId) {
        setSelectValue('ptDependencyTaskId', depParsed.depId.toString());
        highlightSelectedProjectDetailsDependencyCard(depParsed.depId);
    }
}

async function handleProjectDetailsTaskMilestoneChanged() {
    const projectId = parseInt(document.getElementById('tProjectId').value, 10) || @Model.Id;
    const milestoneId = parseInt(document.getElementById('tMilestoneId').value, 10) || 0;
    const taskId = parseInt(document.getElementById('tId').value, 10) || 0;
    await fetchAndRenderProjectTaskDependency(projectId, milestoneId, taskId);
}

async function fetchAndRenderProjectTaskDependency(projectId, milestoneId, taskId) {
    const seqBadge = document.getElementById('ptSequenceBadge');
    const reasonEl = document.getElementById('ptDependencyReason');
    const depTypeEl = document.getElementById('ptDependencyTypeText');
    const boxEl = document.getElementById('ptDependencyBox');
    const msTextEl = document.getElementById('ptMilestoneNameText');

    if (seqBadge) seqBadge.textContent = 'Evaluating Task Gate...';
    if (reasonEl) reasonEl.textContent = 'Evaluating parent milestone clearance and task sequence prerequisites...';

    const isDepChecked = document.getElementById('ptOptionDependency')?.checked || false;
    const depTaskIdVal = parseInt(document.getElementById('ptDependencyTaskId')?.value, 10) || 0;

    try {
        const res = await fetch(`/api/tasks/project-dependency/${projectId}?milestoneId=${milestoneId || 0}&currentTaskId=${taskId || 0}&hasDependency=${isDepChecked}&dependencyTaskId=${depTaskIdVal}`);
        if (!res.ok) throw new Error('Failed to evaluate task dependency');
        const data = await res.json();

        // Populate existing tasks list and dropdown
        const existingTasks = data.existingTasks || data.ExistingTasks || [];
        populateProjectDetailsExistingTasks(existingTasks, depTaskIdVal, taskId);

        // Populate Project & Milestone details
        if (data.project) {
            const p = data.project;
            if (document.getElementById('ptProjectCodeBadge')) document.getElementById('ptProjectCodeBadge').textContent = p.projectCode || '';
            if (document.getElementById('ptProjectNameText')) document.getElementById('ptProjectNameText').textContent = p.projectName || '';
            if (document.getElementById('ptClientText')) document.getElementById('ptClientText').textContent = p.clientName ? `${p.clientName} ${p.clientCompany ? '(' + p.clientCompany + ')' : ''}` : '—';
            if (document.getElementById('ptManagerText')) document.getElementById('ptManagerText').textContent = p.projectManager || 'Unassigned';
        }

        if (msTextEl) {
            if (data.selectedMilestone) {
                msTextEl.textContent = `${data.selectedMilestone.milestoneCode || 'MLS'} - ${data.selectedMilestone.milestoneName || 'Milestone'}`;
            } else {
                msTextEl.textContent = 'Direct Task (No Milestone)';
            }
        }

        if (depTypeEl) {
            depTypeEl.textContent = data.dependencyType || (isDepChecked ? 'Prerequisite Task Dependency' : 'No Dependency (Independent Task)');
        }

        const evalResult = data.nextTaskDependency || data.evaluation || {};
        if (evalResult.isLocked) {
            if (seqBadge) {
                seqBadge.className = 'badge badge-warning';
                seqBadge.innerHTML = `<i class="bi bi-lock-fill"></i> Locked (Seq #${evalResult.sequenceIndex || evalResult.SequenceIndex || 1})`;
            }
            if (boxEl) {
                boxEl.style.borderColor = '#f59e0b';
                boxEl.style.background = '#fffbeb';
            }
            if (reasonEl) {
                reasonEl.innerHTML = `<strong>Task Gate Active:</strong> ${escapeHtml(evalResult.lockReason || evalResult.LockReason || 'Prerequisite tasks or milestone locked.')}`;
            }
        } else {
            if (seqBadge) {
                seqBadge.className = 'badge badge-success';
                seqBadge.innerHTML = `<i class="bi bi-unlock-fill"></i> Ready / Seq #${evalResult.sequenceIndex || evalResult.SequenceIndex || 1}`;
            }
            if (boxEl) {
                boxEl.style.borderColor = '#10b981';
                boxEl.style.background = '#f0fdf4';
            }
            if (reasonEl) {
                if (evalResult.sequenceIndex === 1 || evalResult.SequenceIndex === 1) {
                    reasonEl.innerHTML = `<i class="bi bi-check-circle-fill" style="color:#10b981;"></i> <strong>Initial Task #1:</strong> Ready to execute. Subsequent tasks will depend on its completion.`;
                } else if (!isDepChecked) {
                    reasonEl.innerHTML = `<i class="bi bi-check-circle-fill" style="color:#10b981;"></i> <strong>Independent Task:</strong> No task prerequisite constraint configured.`;
                } else {
                    reasonEl.innerHTML = `<i class="bi bi-check-circle-fill" style="color:#10b981;"></i> <strong>Prerequisites Met:</strong> Prerequisite task completed and parent milestone cleared.`;
                }
            }
        }
    } catch (err) {
        console.error('Error in fetchAndRenderProjectTaskDependency:', err);
    }
}

let projectMilestonesCache = [];

function toggleProjectActionDropdown(e) {
    e.stopPropagation();
    const menu = document.getElementById('projectActionDropdownMenu');
    if (menu) {
        menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
    }
}

document.addEventListener('click', function(e) {
    const menu = document.getElementById('projectActionDropdownMenu');
    const btn = document.getElementById('btnProjectActionDropdown');
    if (menu && menu.style.display === 'block' && (!btn || !btn.contains(e.target)) && !menu.contains(e.target)) {
        menu.style.display = 'none';
    }
});

let projectClientsCache = null;
let projectBillableTasksCache = [];

function getNormalizedProjectType(val) {
    if (!val) return 'Direct Project';
    const s = val.toString().toLowerCase();
    if (s.includes('milestone')) return 'Milestone Based Project';
    if (s.includes('task')) return 'Task Based Project';
    return 'Direct Project';
}

async function loadProjectDetailsClients(preselectedName, preselectedCompany) {
    const sel = document.getElementById('invClientSelect');
    if (!sel) return;

    if (!projectClientsCache) {
        try {
            const res = await fetch('/api/clients');
            if (res.ok) {
                projectClientsCache = await res.json();
            } else {
                projectClientsCache = [];
            }
        } catch (err) {
            console.error('Error fetching clients:', err);
            projectClientsCache = [];
        }
    }

    sel.innerHTML = '<option value="">-- Select Client --</option>';

    const targetName = (preselectedName || document.getElementById('invClientName')?.value || '').trim();
    const targetComp = (preselectedCompany || document.getElementById('invClientCompany')?.value || '').trim();

    let matchedOption = false;

    if (Array.isArray(projectClientsCache)) {
        projectClientsCache.forEach((c, idx) => {
            const cName = (c.clientName || c.ClientName || '').trim();
            const compName = (c.companyName || c.CompanyName || '').trim();
            const cId = c.clientId || c.ClientId || c.leadId || c.LeadId || '';

            if (!cName && !compName) return;

            // Required order: Client Name – Company Name
            let label = '';
            if (cName && compName && cName.toLowerCase() !== compName.toLowerCase()) {
                label = `${cName} – ${compName}`;
            } else {
                label = cName || compName;
            }

            const opt = document.createElement('option');
            opt.value = idx.toString();
            opt.textContent = label;
            opt.setAttribute('data-client-name', cName);
            opt.setAttribute('data-client-company', compName);
            opt.setAttribute('data-client-id', cId);

            const isMatch = (targetName && cName && targetName.toLowerCase() === cName.toLowerCase()) ||
                            (targetComp && compName && targetComp.toLowerCase() === compName.toLowerCase());

            if (isMatch && !matchedOption) {
                opt.selected = true;
                matchedOption = true;
                document.getElementById('invClientName').value = cName;
                document.getElementById('invClientCompany').value = compName;
                document.getElementById('invClientId').value = cId;
                updateClientBannerDisplay(cName, compName);
            }

            sel.appendChild(opt);
        });
    }

    if (!matchedOption && (targetName || targetComp)) {
        let label = '';
        if (targetName && targetComp && targetName.toLowerCase() !== targetComp.toLowerCase()) {
            label = `${targetName} – ${targetComp}`;
        } else {
            label = targetName || targetComp;
        }
        const opt = document.createElement('option');
        opt.value = '__current__';
        opt.textContent = label;
        opt.setAttribute('data-client-name', targetName);
        opt.setAttribute('data-client-company', targetComp);
        opt.selected = true;
        sel.appendChild(opt);
        document.getElementById('invClientName').value = targetName;
        document.getElementById('invClientCompany').value = targetComp;
        updateClientBannerDisplay(targetName, targetComp);
    }
}

function onProjectDetailsClientChange(sel) {
    const selectedOpt = sel.options[sel.selectedIndex];
    if (!selectedOpt || !selectedOpt.value) {
        document.getElementById('invClientName').value = '';
        document.getElementById('invClientCompany').value = '';
        document.getElementById('invClientId').value = '';
        updateClientBannerDisplay('', '');
        return;
    }
    const cName = selectedOpt.getAttribute('data-client-name') || '';
    const compName = selectedOpt.getAttribute('data-client-company') || '';
    const cId = selectedOpt.getAttribute('data-client-id') || '';

    document.getElementById('invClientName').value = cName;
    document.getElementById('invClientCompany').value = compName;
    document.getElementById('invClientId').value = cId;
    updateClientBannerDisplay(cName, compName);
}

function updateClientBannerDisplay(clientName, clientCompany) {
    const nameEl = document.getElementById('invClientNameDisplay');
    const compEl = document.getElementById('invClientCompanyDisplay');
    if (nameEl) nameEl.textContent = clientName || '—';
    if (compEl) compEl.textContent = clientCompany ? `(${clientCompany})` : '';
}

function onProjectDetailsProjectTypeChange(val) {
    const normType = getNormalizedProjectType(val);
    applyProjectDetailsProjectTypeLayout(normType, false, 0);
}

function applyProjectDetailsProjectTypeLayout(normType, isEdit = false, editAmount = 0) {
    const directSec = document.getElementById('projDirectBudgetSection');
    const milestoneSec = document.getElementById('projMilestoneSection');
    const taskSec = document.getElementById('projTaskSection');

    const budgetInput = document.getElementById('invBudget');
    const milestoneAmountInput = document.getElementById('invMilestoneAmount');
    const taskAmountInput = document.getElementById('invTaskAmount');
    const invAmount = document.getElementById('invAmount');
    const projectId = parseInt(document.getElementById('invProjectId')?.value, 10) || @Model.Id;

    const ptSelect = document.getElementById('invProjectType');
    if (ptSelect && ptSelect.value !== normType) {
        ptSelect.value = normType;
    }

    if (normType === 'Milestone Based Project') {
        // B. Milestone: Show Milestone Amount, Hide Budget, Hide Task Amount
        if (directSec) directSec.style.display = 'none';
        if (milestoneSec) milestoneSec.style.display = 'block';
        if (taskSec) taskSec.style.display = 'none';

        if (budgetInput) { budgetInput.required = false; budgetInput.value = ''; }
        if (taskAmountInput) taskAmountInput.value = '0';

        if (isEdit && editAmount > 0) {
            if (milestoneAmountInput) milestoneAmountInput.value = editAmount;
            if (invAmount) invAmount.value = editAmount;
        } else {
            const msAmt = parseFloat(milestoneAmountInput?.value) || 0;
            if (invAmount) invAmount.value = msAmt;
        }

        if (!projectMilestonesCache || projectMilestonesCache.length === 0) {
            loadProjectMilestonesForInvoice(projectId, document.getElementById('invMilestoneId')?.value);
        }
    } else if (normType === 'Task Based Project') {
        // C. Task: Show Task Amount, Hide Budget, Hide Milestone Amount
        if (directSec) directSec.style.display = 'none';
        if (milestoneSec) milestoneSec.style.display = 'none';
        if (taskSec) taskSec.style.display = 'block';

        if (budgetInput) { budgetInput.required = false; budgetInput.value = ''; }
        const msIdInput = document.getElementById('invMilestoneId');
        if (msIdInput) msIdInput.value = '';
        if (milestoneAmountInput) milestoneAmountInput.value = '0';

        if (isEdit && editAmount > 0) {
            if (taskAmountInput) taskAmountInput.value = editAmount;
            if (invAmount) invAmount.value = editAmount;
        } else {
            const taskAmt = parseFloat(taskAmountInput?.value) || 0;
            if (invAmount) invAmount.value = taskAmt;
        }

        loadProjectDetailsBillableTasks(projectId);
    } else {
        // A. Direct Project: Show Budget, Hide Milestone Amount, Hide Task Amount
        if (directSec) directSec.style.display = 'block';
        if (milestoneSec) milestoneSec.style.display = 'none';
        if (taskSec) taskSec.style.display = 'none';

        if (budgetInput) budgetInput.required = true;
        const msIdInput = document.getElementById('invMilestoneId');
        if (msIdInput) msIdInput.value = '';
        if (milestoneAmountInput) milestoneAmountInput.value = '0';
        if (taskAmountInput) taskAmountInput.value = '0';

        if (isEdit && editAmount > 0) {
            if (budgetInput) budgetInput.value = editAmount;
            if (invAmount) invAmount.value = editAmount;
        } else {
            if (budgetInput && (!budgetInput.value || parseFloat(budgetInput.value) === 0)) {
                const projectBudget = @(Model.Budget > 0 ? Model.Budget.ToString(System.Globalization.CultureInfo.InvariantCulture) : "0");
                if (projectBudget > 0) {
                    budgetInput.value = projectBudget;
                    const hint = document.getElementById('projBudgetAutoHint');
                    if (hint) hint.style.display = 'inline';
                }
            }
            const bAmt = parseFloat(budgetInput?.value) || 0;
            if (invAmount) invAmount.value = bAmt;
        }
    }

    recalcInvoiceTotal();
}

function onProjectBudgetChange(val) {
    const amt = parseFloat(val) || 0;
    const invAmount = document.getElementById('invAmount');
    if (invAmount) invAmount.value = amt;
    recalcInvoiceTotal();
}

async function loadProjectDetailsBillableTasks(projectId, preselectedIds = []) {
    const container = document.getElementById('projTaskListContainer');
    const badge = document.getElementById('projTaskCountBadge');
    const msg = document.getElementById('projTaskMessage');
    const taskAmtInput = document.getElementById('invTaskAmount');
    const invAmount = document.getElementById('invAmount');

    if (!container) return;
    container.innerHTML = '<div style="padding:15px;text-align:center;color:var(--ink-400);font-size:12.5px;"><i class="bi bi-arrow-repeat spin"></i> Loading billable tasks...</div>';
    if (badge) badge.textContent = '';
    if (msg) msg.style.display = 'none';

    try {
        const res = await fetch(`/api/invoices/billable-tasks?projectId=${projectId}`);
        const rawTasks = res.ok ? await res.json() : [];
        projectBillableTasksCache = (Array.isArray(rawTasks) ? rawTasks : []).map(t => ({
            id: t.Id !== undefined ? t.Id : t.id,
            taskCode: t.TaskCode || t.taskCode || '',
            taskName: t.TaskName || t.taskName || 'Untitled Task',
            taskAmount: Number(t.TaskAmount !== undefined ? t.TaskAmount : (t.taskAmount || 0)),
            dueDate: t.DueDate || t.dueDate || ''
        }));

        if (badge) {
            badge.textContent = `${projectBillableTasksCache.length} Available`;
        }

        if (projectBillableTasksCache.length === 0) {
            container.innerHTML = '<div style="padding:15px;text-align:center;color:var(--ink-400);font-size:12.5px;">No completed, unbilled tasks found for this project.</div>';
            if (taskAmtInput) taskAmtInput.value = 0;
            if (invAmount) invAmount.value = 0;
            recalcInvoiceTotal();
            if (msg) {
                msg.style.display = 'block';
                msg.style.background = '#fef2f2';
                msg.style.border = '1px solid #fecaca';
                msg.style.color = '#dc2626';
                msg.innerHTML = '<i class="bi bi-exclamation-circle-fill"></i> No completed unbilled tasks found for this project.';
            }
            return;
        }

        container.innerHTML = '';
        projectBillableTasksCache.forEach(task => {
            const isChecked = Array.isArray(preselectedIds) && preselectedIds.includes(task.id);
            const row = document.createElement('label');
            row.style.display = 'flex';
            row.style.alignItems = 'center';
            row.style.justifyContent = 'space-between';
            row.style.padding = '8px 12px';
            row.style.borderBottom = '1px solid #f1f5f9';
            row.style.cursor = 'pointer';
            row.style.margin = '0';
            row.style.transition = 'background 0.15s ease';

            row.onmouseover = () => row.style.background = '#f8fafc';
            row.onmouseout = () => row.style.background = '#fff';

            const codeStr = task.taskCode ? `[${escapeHtml(task.taskCode)}] ` : '';
            const dueStr = task.dueDate ? ` &bull; Due: ${escapeHtml(task.dueDate)}` : '';

            row.innerHTML = `
                <div style="display:flex;align-items:center;gap:10px;">
                    <input type="checkbox" class="proj-billable-task-cb" value="${task.id}" data-amount="${task.taskAmount}" ${isChecked ? 'checked' : ''} onchange="onProjectTaskCheckboxChange()" style="cursor:pointer;width:15px;height:15px;" />
                    <div>
                        <div style="font-size:12.5px;font-weight:600;color:var(--ink-800);">${codeStr}${escapeHtml(task.taskName)}</div>
                        <div style="font-size:11px;color:var(--ink-500);">Amount: ₹${task.taskAmount.toLocaleString('en-IN', { maximumFractionDigits: 2 })}${dueStr}</div>
                    </div>
                </div>
                <span style="font-size:12px;font-weight:700;color:var(--ink-900);">₹${task.taskAmount.toLocaleString('en-IN', { maximumFractionDigits: 2 })}</span>
            `;
            container.appendChild(row);
        });

        onProjectTaskCheckboxChange();

    } catch (err) {
        console.error(err);
        container.innerHTML = '<div style="padding:15px;text-align:center;color:#dc2626;font-size:12.5px;">Failed to load billable tasks.</div>';
    }
}

function onProjectTaskCheckboxChange() {
    const checkboxes = document.querySelectorAll('.proj-billable-task-cb:checked');
    let total = 0;
    checkboxes.forEach(cb => {
        const amt = parseFloat(cb.getAttribute('data-amount')) || 0;
        total += amt;
    });

    const taskAmtInput = document.getElementById('invTaskAmount');
    if (taskAmtInput) taskAmtInput.value = total;

    const invAmount = document.getElementById('invAmount');
    if (invAmount) invAmount.value = total;

    recalcInvoiceTotal();
}

function toggleSelectAllProjectTasks(selectAll) {
    const checkboxes = document.querySelectorAll('.proj-billable-task-cb');
    checkboxes.forEach(cb => {
        cb.checked = selectAll;
    });
    onProjectTaskCheckboxChange();
}

async function openInvoiceModal(id, projectId, invNumber, date, due, amount, tax, discount, payStatus, payDate, notes, preselectedMilestoneId) {
    projectId = projectId || @Model.Id;
    document.getElementById('invId').value = id || 0;
    document.getElementById('invProjectId').value = projectId;
    document.getElementById('invDate').value = date || getLocalDateInputValue();
    
    // Default due date to +15 days if empty
    if (!due) {
        const d = new Date();
        d.setDate(d.getDate() + 15);
        due = getLocalDateInputValue(d);
    }
    document.getElementById('invDue').value = due;

    document.getElementById('invAmount').value = amount || 0;
    document.getElementById('invDiscount').value = discount || 0;
    setSelectValue('invPayStatus', payStatus || 'Unpaid');
    document.getElementById('invPayDate').value = payDate || '';
    document.getElementById('invNotes').value = notes || '';

    // Hide error banner
    const errBox = document.getElementById('invModalError');
    if (errBox) errBox.style.display = 'none';
    openModal('invoiceModal');

    // 1. Heading: Change to 'Add Invoice' when creating new, 'Edit Invoice (...)' when editing
    document.getElementById('invModalTitle').textContent = id ? ('Edit Invoice (' + (invNumber || '') + ')') : 'Add Invoice';
    document.getElementById('btnSubmitInvoiceText').textContent = id ? 'Update Invoice' : 'Create Invoice';

    // 2. Load Client Dropdown (Order: Client Name – Company Name)
    await loadProjectDetailsClients('@Html.Raw(Model.ClientName?.Replace("'", "\'"))', '@Html.Raw(Model.ClientCompany?.Replace("'", "\'"))');

    // 3. Determine Project Type & apply layout
    let targetType = 'Direct Project';
    if (preselectedMilestoneId && Number(preselectedMilestoneId) > 0) {
        targetType = 'Milestone Based Project';
    } else if (notes && notes.includes('[Tasks:')) {
        targetType = 'Task Based Project';
    } else {
        targetType = getNormalizedProjectType('@Model.ProjectType');
    }

    const ptSelect = document.getElementById('invProjectType');
    if (ptSelect) ptSelect.value = targetType;

    applyProjectDetailsProjectTypeLayout(targetType, id > 0, amount || 0);

    // Fetch dynamic invoice number if creating new invoice
    if (!id || !invNumber) {
        try {
            const codeRes = await fetch('/api/invoices/next-code');
            if (!codeRes.ok) throw new Error('Unable to generate an invoice number.');
            const codeData = await codeRes.json();
            const generatedNumber = codeData.invoiceNumber || codeData.InvoiceNumber;
            if (!generatedNumber) throw new Error('The invoice number service returned no invoice number.');
            document.getElementById('invNumber').value = generatedNumber;
        } catch (err) {
            showInvoiceModalError(err.message || 'Unable to generate an invoice number.');
            return;
        }
    } else {
        document.getElementById('invNumber').value = invNumber;
    }

    if (targetType === 'Milestone Based Project') {
        await loadProjectMilestonesForInvoice(projectId, preselectedMilestoneId || (id ? preselectedMilestoneId : null));
    }

    recalcInvoiceTotal();
}

async function loadProjectMilestonesForInvoice(projectId, targetMilestoneId) {
    const container = document.getElementById('invMilestonesContainer');
    const hiddenInput = document.getElementById('invMilestoneId');
    if (!container) return;

    // Do NOT show a loading message in the milestone field
    container.innerHTML = '';

    try {
        const res = await fetch(`/api/milestones?projectId=${projectId}`);
        if (!res.ok) throw new Error('Failed to load milestones');

        const milestones = await res.json();
        projectMilestonesCache = milestones.map(m => ({
            id: m.id ?? m.Id,
            projectId: m.projectId ?? m.ProjectId,
            projectName: m.projectName ?? m.ProjectName ?? '',
            projectCode: m.projectCode ?? m.ProjectCode ?? '',
            clientName: m.clientName ?? m.ClientName ?? '',
            clientCompany: m.clientCompany ?? m.ClientCompany ?? '',
            milestoneCode: m.milestoneCode ?? m.MilestoneCode ?? '',
            milestoneName: m.milestoneName ?? m.MilestoneName ?? '',
            description: m.description ?? m.Description ?? '',
            dueDate: m.dueDate ?? m.DueDate ?? '',
            amount: m.amount ?? m.Amount ?? 0,
            effectiveAmount: m.effectiveAmount ?? m.EffectiveAmount ?? 0,
            progressPercent: m.progressPercent ?? m.ProgressPercent ?? 0,
            status: m.status ?? m.Status ?? 'Pending',
            isInvoiced: m.isInvoiced ?? m.IsInvoiced ?? false,
            invoiceId: m.invoiceId ?? m.InvoiceId ?? null,
            invoiceNumber: m.invoiceNumber ?? m.InvoiceNumber ?? ''
        }));
        
        const currentInvId = parseInt(document.getElementById('invId').value, 10) || 0;
        const countBadge = document.getElementById('msAvailableCountBadge');
        if (countBadge) {
            countBadge.textContent = `${projectMilestonesCache.length} Milestone${projectMilestonesCache.length === 1 ? '' : 's'}`;
        }

        if (!projectMilestonesCache || projectMilestonesCache.length === 0) {
            container.innerHTML = `
                <div style="grid-column:1/-1;padding:14px;text-align:center;color:var(--ink-500);background:#f8fafc;border:1px dashed var(--line);border-radius:8px;font-size:12.5px;">
                    <i class="bi bi-info-circle" style="margin-right:4px;"></i> No milestones found for this project.
                </div>
            `;
            if (hiddenInput) hiddenInput.value = '';
            selectMilestoneForInvoice(null);
            return;
        }

        let selectedId = null;
        if (targetMilestoneId && projectMilestonesCache.some(m => m.id === Number(targetMilestoneId))) {
            selectedId = Number(targetMilestoneId);
        } else {
            const firstUninvoiced = projectMilestonesCache.find(m => !(m.isInvoiced && m.invoiceId !== currentInvId));
            if (firstUninvoiced) {
                selectedId = firstUninvoiced.id;
            }
        }

        renderProjectMilestoneCards(projectMilestonesCache, currentInvId, selectedId);

        if (selectedId) {
            selectMilestoneForInvoice(selectedId);
        } else {
            selectMilestoneForInvoice(null);
        }
    } catch (err) {
        console.error('Error loading milestones:', err);
        container.innerHTML = `
            <div style="grid-column:1/-1;padding:12px;color:#dc2626;background:#fef2f2;border:1px solid #fecaca;border-radius:8px;font-size:12.5px;">
                <i class="bi bi-exclamation-triangle"></i> Unable to load project milestones.
            </div>
        `;
        showInvoiceModalError('Unable to load project milestones.');
    }
}

function renderProjectMilestoneCards(milestones, currentInvId, selectedId) {
    const container = document.getElementById('invMilestonesContainer');
    if (!container) return;

    let html = '';
    milestones.forEach(m => {
        const isThisInvoiceMs = currentInvId > 0 && m.invoiceId === currentInvId;
        const alreadyInvoiced = m.isInvoiced && !isThisInvoiceMs;
        const amt = Number(m.amount > 0 ? m.amount : (m.effectiveAmount || 0));
        const prog = Number(m.progressPercent) || 0;
        const status = m.status || 'Pending';
        const msCode = m.milestoneCode || 'MLS';
        const msName = m.milestoneName || 'Milestone';
        const isSelected = selectedId && Number(selectedId) === m.id;

        if (alreadyInvoiced) {
            html += `
                <div class="ms-invoice-card ms-card-disabled" style="border:1px solid #e2e8f0;background:#f8fafc;border-radius:8px;padding:10px 12px;opacity:0.65;cursor:not-allowed;">
                    <div style="display:flex;align-items:center;justify-content:space-between;gap:6px;margin-bottom:4px;">
                        <span class="badge" style="font-size:10.5px;background:#f1f5f9;color:var(--ink-600);border:1px solid #cbd5e1;">${msCode}</span>
                        <span class="badge" style="font-size:10.5px;background:#fef2f2;color:#dc2626;border:1px solid #fecaca;font-weight:700;">
                            <i class="bi bi-lock-fill"></i> Invoiced
                        </span>
                    </div>
                    <div style="font-weight:700;font-size:13px;color:var(--ink-700);margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="${msName}">
                        ${msName}
                    </div>
                    <div style="font-size:11.5px;color:var(--ink-500);display:flex;justify-content:space-between;align-items:center;">
                        <span>₹${amt.toLocaleString('en-IN', { maximumFractionDigits: 2 })}</span>
                        <span>${m.invoiceNumber ? '#' + m.invoiceNumber : ''}</span>
                    </div>
                </div>
            `;
        } else {
            const activeStyle = isSelected ? 'border:2px solid var(--brand-600);background:#eff6ff;box-shadow:0 2px 6px rgba(79,70,229,0.15);' : 'border:1px solid var(--line);background:#fff;';
            const checkIcon = isSelected ? '<i class="bi bi-check-circle-fill" style="color:var(--brand-600);font-size:16px;"></i>' : '<i class="bi bi-circle" style="color:var(--ink-400);font-size:16px;"></i>';

            html += `
                <div class="ms-invoice-card" id="ms-card-${m.id}" onclick="selectMilestoneForInvoice(${m.id})"
                     style="${activeStyle}border-radius:8px;padding:10px 12px;cursor:pointer;transition:all 0.15s ease;display:flex;flex-direction:column;justify-content:space-between;">
                    <div style="display:flex;align-items:center;justify-content:space-between;gap:6px;margin-bottom:4px;">
                        <span class="badge badge-code" style="font-weight:700;font-size:10.5px;">${msCode}</span>
                        <div style="display:flex;align-items:center;gap:6px;">
                            <span class="badge ${status === 'Completed' ? 'badge-success' : status === 'In Progress' ? 'badge-info' : 'badge-secondary'}" style="font-size:10.5px;">
                                ${status}
                            </span>
                            <span class="ms-card-check" id="ms-check-${m.id}">${checkIcon}</span>
                        </div>
                    </div>
                    <div style="font-weight:700;font-size:13.5px;color:var(--ink-900);margin-bottom:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="${msName}">
                        ${msName}
                    </div>
                    <div style="display:flex;align-items:center;justify-content:space-between;font-size:12px;padding-top:4px;border-top:1px dashed #e2e8f0;margin-top:2px;">
                        <strong style="color:var(--brand-600);font-size:13px;">₹${amt.toLocaleString('en-IN', { maximumFractionDigits: 2 })}</strong>
                        <span style="color:var(--ink-500);font-size:11.5px;"><i class="bi bi-pie-chart"></i> ${prog}%</span>
                    </div>
                </div>
            `;
        }
    });

    container.innerHTML = html;
}

function selectMilestoneForInvoice(selectedId) {
    const hiddenInput = document.getElementById('invMilestoneId');
    const preview = document.getElementById('milestonePreviewCard');
    const amountInput = document.getElementById('invAmount');
    const milestoneAmountInput = document.getElementById('invMilestoneAmount');
    const dueInput = document.getElementById('invDue');
    const notesInput = document.getElementById('invNotes');

    // Deselect all active cards
    document.querySelectorAll('.ms-invoice-card').forEach(card => {
        if (!card.classList.contains('ms-card-disabled')) {
            card.classList.remove('active');
            card.style.border = '1px solid var(--line)';
            card.style.background = '#fff';
            card.style.boxShadow = 'none';
            const check = card.querySelector('.ms-card-check');
            if (check) check.innerHTML = '<i class="bi bi-circle" style="color:var(--ink-400);font-size:16px;"></i>';
        }
    });

    if (!selectedId) {
        if (hiddenInput) hiddenInput.value = '';
        if (preview) preview.style.display = 'none';
        if (milestoneAmountInput) milestoneAmountInput.value = '0';
        if (amountInput) amountInput.value = '0';
        recalcInvoiceTotal();
        return;
    }

    const milestone = projectMilestonesCache ? projectMilestonesCache.find(m => m.id === Number(selectedId)) : null;
    if (!milestone) return;

    if (hiddenInput) hiddenInput.value = milestone.id;

    // Highlight selected card
    const selectedCard = document.getElementById(`ms-card-${milestone.id}`);
    if (selectedCard) {
        selectedCard.classList.add('active');
        selectedCard.style.border = '2px solid var(--brand-600)';
        selectedCard.style.background = '#eff6ff';
        selectedCard.style.boxShadow = '0 2px 6px rgba(79,70,229,0.15)';
        const check = document.getElementById(`ms-check-${milestone.id}`);
        if (check) check.innerHTML = '<i class="bi bi-check-circle-fill" style="color:var(--brand-600);font-size:16px;"></i>';
    }

    // Auto-populate milestone details into live preview card
    if (preview) {
        preview.style.display = 'block';
        document.getElementById('msCardCode').textContent = milestone.milestoneCode || 'MLS';
        document.getElementById('msCardName').textContent = milestone.milestoneName || 'Milestone';
        document.getElementById('msCardDesc').textContent = milestone.description || 'No description provided for this milestone.';
        
        const statusBadge = document.getElementById('msCardStatusBadge');
        if (statusBadge) {
            statusBadge.textContent = milestone.status || 'Pending';
            statusBadge.className = 'badge ' + (milestone.status === 'Completed' ? 'badge-success' : milestone.status === 'In Progress' ? 'badge-info' : 'badge-secondary');
        }

        const amt = Number(milestone.amount > 0 ? milestone.amount : (milestone.effectiveAmount || 0));
        document.getElementById('msCardAmount').textContent = '₹' + amt.toLocaleString('en-IN', { minimumFractionDigits: 2 });

        const prog = Number(milestone.progressPercent) || 0;
        document.getElementById('msCardProgressText').textContent = prog + '%';
        const progFill = document.getElementById('msCardProgressFill');
        if (progFill) {
            progFill.style.width = Math.min(100, Math.max(0, prog)) + '%';
            progFill.className = 'progress-bar-fill ' + (prog >= 100 ? 'fill-green' : prog >= 50 ? 'fill-blue' : 'fill-orange');
        }

        document.getElementById('msCardDueDate').textContent = milestone.dueDate || 'N/A';
    }

    // Auto-fill Amount / Price
    const milestoneAmt = Number(milestone.amount > 0 ? milestone.amount : (milestone.effectiveAmount || 0));
    if (milestoneAmountInput) milestoneAmountInput.value = milestoneAmt;
    if (amountInput) amountInput.value = milestoneAmt;

    // Auto-fill Due Date if available
    if (milestone.dueDate && dueInput) {
        dueInput.value = milestone.dueDate;
    }

    // Auto-generate note if empty or default note
    if (notesInput && (!notesInput.value || notesInput.value.startsWith('Invoice generated for Milestone:'))) {
        notesInput.value = `Invoice generated for Milestone: ${milestone.milestoneName}`;
    }

    recalcInvoiceTotal();
}


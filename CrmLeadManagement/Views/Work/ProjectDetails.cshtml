function validateInvoiceDates() {
    const invDate = document.getElementById('invDate').value;
    const dueDate = document.getElementById('invDue').value;
    if (invDate && dueDate && dueDate < invDate) {
        const errBox = document.getElementById('invModalError');
        const errText = document.getElementById('invModalErrorText');
        if (errBox && errText) {
            errText.textContent = 'Due Date cannot be before Invoice Date.';
            errBox.style.display = 'block';
        }
        return false;
    }
    const errBox = document.getElementById('invModalError');
    if (errBox) errBox.style.display = 'none';
    return true;
}

function recalcInvoiceTotal() {
    const amount = Math.max(0, parseFloat(document.getElementById('invAmount').value) || 0);
    let discount = Math.max(0, parseFloat(document.getElementById('invDiscount').value) || 0);
    if (discount > amount) discount = amount;

    const taxable = Math.max(0, amount - discount);
    const taxRate = Math.max(0, parseFloat(document.getElementById('invTaxRate').value) || 0);
    const taxAmount = Math.round(taxable * (taxRate / 100) * 100) / 100;
    const grandTotal = taxable + taxAmount;

    document.getElementById('invTax').value = taxAmount.toFixed(2);
    document.getElementById('invGrandTotal').value = grandTotal.toFixed(2);
    document.getElementById('invGrandTotalDisplay').textContent = '₹' + grandTotal.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

async function handleSaveProjectInvoice(e) {
    e.preventDefault();

    const errBox = document.getElementById('invModalError');
    const errText = document.getElementById('invModalErrorText');
    if (errBox) errBox.style.display = 'none';

    if (!validateInvoiceDates()) return;

    const projectTypeVal = document.getElementById('invProjectType')?.value || 'Direct Project';
    const normType = getNormalizedProjectType(projectTypeVal);

    let milestoneId = null;
    let taskIds = null;
    let amount = 0;

    if (normType === 'Milestone Based Project') {
        const milestoneIdInput = document.getElementById('invMilestoneId');
        milestoneId = milestoneIdInput ? parseInt(milestoneIdInput.value, 10) : 0;
        if (!milestoneId) {
            showInvoiceModalError('Please select a milestone for this invoice.');
            return;
        }
        amount = parseFloat(document.getElementById('invMilestoneAmount')?.value) || parseFloat(document.getElementById('invAmount')?.value) || 0;
        if (amount <= 0) {
            showInvoiceModalError('Milestone amount must be greater than 0.');
            return;
        }
    } else if (normType === 'Task Based Project') {
        const checkedBoxes = document.querySelectorAll('.proj-billable-task-cb:checked');
        taskIds = Array.from(checkedBoxes).map(cb => parseInt(cb.value, 10));
        if (taskIds.length === 0) {
            showInvoiceModalError('Please select at least one completed task for this invoice.');
            return;
        }
        amount = parseFloat(document.getElementById('invTaskAmount')?.value) || parseFloat(document.getElementById('invAmount')?.value) || 0;
        if (amount <= 0) {
            showInvoiceModalError('Task amount must be greater than 0.');
            return;
        }
    } else {
        // Direct Project
        amount = parseFloat(document.getElementById('invBudget')?.value) || parseFloat(document.getElementById('invAmount')?.value) || 0;
        if (amount <= 0) {
            showInvoiceModalError('Budget amount must be greater than 0 for Direct Projects.');
            return;
        }
    }

    const id = parseInt(document.getElementById('invId').value, 10) || 0;
    const projectId = parseInt(document.getElementById('invProjectId').value, 10) || @Model.Id;
    const invNumber = document.getElementById('invNumber').value.trim();
    const invDate = document.getElementById('invDate').value;
    const dueDate = document.getElementById('invDue').value;
    const discount = parseFloat(document.getElementById('invDiscount').value) || 0;
    const taxRate = parseFloat(document.getElementById('invTaxRate').value) || 0;
    const payStatus = document.getElementById('invPayStatus').value;
    const payDate = document.getElementById('invPayDate').value;
    const notes = document.getElementById('invNotes').value.trim();

    const clientName = document.getElementById('invClientName')?.value?.trim() || '@Html.Raw(Model.ClientName?.Replace("'", "\'"))';
    const clientCompany = document.getElementById('invClientCompany')?.value?.trim() || '@Html.Raw(Model.ClientCompany?.Replace("'", "\'"))';
    const clientId = document.getElementById('invClientId')?.value?.trim() || '';

    const payload = {
        projectId: projectId,
        milestoneId: normType === 'Milestone Based Project' ? milestoneId : null,
        taskIds: normType === 'Task Based Project' ? taskIds : null,
        invoiceNumber: invNumber,
        clientId: clientId,
        clientName: clientName,
        clientCompany: clientCompany,
        invoiceDate: invDate,
        dueDate: dueDate,
        amount: amount,
        discount: discount,
        taxRate: taxRate,
        notes: notes
    };

    const submitBtn = document.getElementById('btnSubmitInvoice');
    const submitText = document.getElementById('btnSubmitInvoiceText');
    submitBtn.disabled = true;
    submitText.innerHTML = '<i class="bi bi-arrow-repeat spin"></i> Saving...';

    try {
        const url = id > 0 ? `/api/invoices/${id}` : '/api/invoices';
        const method = id > 0 ? 'PUT' : 'POST';

        const res = await fetch(url, {
            method: method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });

        if (!res.ok) {
            const errData = await res.json();
            throw new Error(errData.message || 'Failed to save invoice.');
        }

        closeModal('invoiceModal');
        // Reload project page on invoice tab to reflect new state
        window.location.href = `/Work/ProjectDetails?id=${projectId}&tab=invoice`;
    } catch (err) {
        showInvoiceModalError(err.message || 'An error occurred while saving the invoice.');
    } finally {
        submitBtn.disabled = false;
        submitText.textContent = id > 0 ? 'Update Invoice' : 'Create Invoice';
    }
}

function setSelectValue(id, val) {
    var sel = document.getElementById(id);
    if (!sel) return;
    for (var i = 0; i < sel.options.length; i++) {
        if (sel.options[i].value === val) { sel.selectedIndex = i; return; }
    }
    if (sel.options.length > 0) sel.selectedIndex = 0;
}


function renderPdfPrintableArea(data) {
    const container = document.getElementById('pdfPrintableArea');
    if (!container) return;

    let itemsRows = '';
    if (data.items && data.items.length) {
        itemsRows = data.items.map((item, idx) => `
            <tr style="border-bottom:1px solid #e2e8f0;">
                <td style="padding:10px 12px;text-align:center;color:#64748b;">${idx + 1}</td>
                <td style="padding:10px 12px;">
                    <div style="font-weight:700;color:#0f172a;">${escapeHtml(item.name || 'Milestone Deliverable')}</div>
                    ${item.description ? `<div style="font-size:12px;color:#64748b;margin-top:2px;">${escapeHtml(item.description)}</div>` : ''}
                </td>
                <td style="padding:10px 12px;text-align:center;">${item.qty || 1}</td>
                <td style="padding:10px 12px;text-align:right;">₹${Number(item.rate || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 })}</td>
                <td style="padding:10px 12px;text-align:right;font-weight:700;color:#0f172a;">₹${Number(item.amount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 })}</td>
            </tr>
        `).join('');
    } else {

function printPdfContent() {
    const printContent = document.getElementById('pdfPrintableArea').innerHTML;
    const win = window.open('', '', 'height=750,width=950');
    win.document.write('<html><head><title>Invoice PDF</title>');
    win.document.write('<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">');
    win.document.write('<style>body{font-family:"Inter",sans-serif;margin:20px;padding:10px;} @@media print{button{display:none;}}</style>');
    win.document.write('</head><body>');
    win.document.write(printContent);
    win.document.write('</body></html>');
    win.document.close();
    setTimeout(() => {
        win.focus();
        win.print();
    }, 300);
}

function escapeHtml(str) {
    if (!str) return '';
    return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
}

// ─────────────────────────────────────────────────────────────────────────────
// Sync Project Details via dedicated API Client Modules
// ─────────────────────────────────────────────────────────────────────────────
async function loadProjectDetailsApis() {
    const projectId = @Model.Id;
    try {
        console.log(`[ProjectDetails] Synchronizing APIs for Project ID ${projectId}...`);

        const [summaryRes, projectRes, milestonesRes, tasksRes] = await Promise.allSettled([
            WorkApi.getSummary(),
            ProjectApi.getById(projectId),
            MilestoneApi.getAll({ projectId: projectId }),
            TaskApi.getAll({ projectId: projectId })
        ]);

        if (summaryRes.status === 'fulfilled') console.log('[API SUCCESS] WorkApi.getSummary:', summaryRes.value);
        if (projectRes.status === 'fulfilled') console.log(`[API SUCCESS] ProjectApi.getById(${projectId}):`, projectRes.value);
        if (milestonesRes.status === 'fulfilled') console.log(`[API SUCCESS] MilestoneApi.getAll(${projectId}):`, milestonesRes.value);
        if (tasksRes.status === 'fulfilled') console.log(`[API SUCCESS] TaskApi.getAll(${projectId}):`, tasksRes.value);
    } catch (err) {
        console.error('[ProjectDetails] loadProjectDetailsApis error:', err);
    }
}

document.addEventListener('DOMContentLoaded', function() {
    loadProjectDetailsApis();

    // Check URL parameters for direct action (e.g. ?tab=invoice&openInvoice=true&milestoneId=123)
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('openInvoice') === 'true' || urlParams.get('createInvoice') === 'true') {
        const msId = parseInt(urlParams.get('milestoneId'), 10) || 0;
        openInvoiceModal(0, @Model.Id, null, null, null, null, null, null, null, null, null, msId);
    }
});
</script>
